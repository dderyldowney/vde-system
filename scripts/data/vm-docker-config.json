  "base_settings": {
    "context": "../../..",
    "base_dockerfile": "configs/docker/base-dev.Dockerfile",
    "network": "dev-net",
    "username": "devuser",
    "uid": 1000,
    "gid": 1000,
    "public_keys_dir": "/public-ssh-keys"
