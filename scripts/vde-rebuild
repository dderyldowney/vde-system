#!/usr/bin/env zsh
#===============================================================================
# vde-rebuild - Rebuild all VDE Docker images
# Usage: vde-rebuild [options]
#
# Options:
#   --no-cache   Rebuild without using cache
#   --vm <name>  Rebuild only specific VM (or "base" for base image)
#   -h, --help   Show this help
#
# This script:
#   1. Builds vde-base:latest first
#   2. Then builds all VM images (using cached layers from vde-base)
#===============================================================================

set -e

# Source shared library
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
VDE_ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
export VDE_ROOT_DIR

source "$SCRIPT_DIR/lib/vde-shell-compat"
source "$SCRIPT_DIR/lib/vde-constants"
source "$SCRIPT_DIR/lib/vde-errors"
source "$SCRIPT_DIR/lib/vde-log"
source "$SCRIPT_DIR/lib/vde-naming"

# Configuration
NOCACHE=false
SPECIFIC_VM=""

#===============================================================================
# Help
#===============================================================================

show_usage() {
    cat <<EOF
Usage: vde-rebuild [options]

Rebuild all VDE Docker images.

Options:
  --no-cache   Rebuild without using cache
  --vm <name>  Rebuild only specific VM (or "base" for base image)
  -h, --help   Show this help

Examples:
  vde-rebuild              # Rebuild all images using cache
  vde-rebuild --no-cache   # Rebuild all images from scratch
  vde-rebuild --vm python  # Rebuild only python VM
  vde-rebuild --vm base    # Rebuild only vde-base

EOF
}

#===============================================================================
# Parse Arguments
#===============================================================================

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_usage
            exit 0
            ;;
        --no-cache)
            NOCACHE=true
            shift
            ;;
        --vm)
            SPECIFIC_VM="$2"
            shift 2
            ;;
        *)
            echo "Unknown option: $1"
            show_usage
            exit 1
            ;;
    esac
done

#===============================================================================
# Get VM List
#===============================================================================

get_vm_list() {
    local vm_types_file="$SCRIPT_DIR/data/vm-types.conf"
    if [[ -f "$vm_types_file" ]]; then
        grep -v '^#' "$vm_types_file" | grep -v '^$' | cut -d'|' -f2
    else
        # Fallback to directory listing, but ensure we return prefixed names for consistency
        ls -1 "$CONFIGS_DIR" 2>/dev/null | grep -v '^$' | grep -v "vde-base.Dockerfile" | while read -r raw; do
            vde_get_container_name "$raw"
        done || true
    fi
}

#===============================================================================
# Build Functions
#===============================================================================

build_base_image() {
    local build_cmd="docker build -t vde-base:latest -f $CONFIGS_DIR/vde-base.Dockerfile $VDE_ROOT_DIR"
    
    if [[ "$NOCACHE" == "true" ]]; then
        build_cmd="$build_cmd --no-cache"
    fi
    
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "Building vde-base:latest..."
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    
    if eval "$build_cmd"; then
        echo "✓ vde-base:latest built successfully"
        return 0
    else
        echo "✗ Failed to build vde-base:latest"
        return 1
    fi
}

build_vm_image() {
    local vm_name="$1"
    local raw_name
    raw_name=$(vde_normalize_name "$vm_name")
    local compose_file="$CONFIGS_DIR/$raw_name/docker-compose.yml"
    
    if [[ ! -f "$compose_file" ]]; then
        echo "⚠ Skipping $vm_name: no docker-compose.yml found at $compose_file"
        return 0
    fi
    
    local build_cmd="docker compose -f $compose_file build"
    
    if [[ "$NOCACHE" == "true" ]]; then
        build_cmd="$build_cmd --no-cache"
    fi
    
    echo "Building $vm_name..."
    
    if (cd "$CONFIGS_DIR/$raw_name" && eval "$build_cmd" 2>&1); then
        echo "✓ $vm_name built successfully"
        return 0
    else
        echo "✗ Failed to build $vm_name"
        return 1
    fi
}

#===============================================================================
# Main
#===============================================================================

echo ""
echo "╔════════════════════════════════════════════════════════════╗"
echo "║          VDE Image Rebuild                                ║"
echo "╚════════════════════════════════════════════════════════════╝"
echo ""

# Check Docker
if ! command -v docker &>/dev/null; then
    echo "Error: Docker is not installed"
    exit 1
fi

if ! docker info &>/dev/null; then
    echo "Error: Docker daemon is not running"
    exit 1
fi

# Build specific VM or all
if [[ -n "$SPECIFIC_VM" ]]; then
    if [[ "$SPECIFIC_VM" == "base" ]]; then
        build_base_image
    else
        # For specific VM, build base first if needed
        if ! docker image inspect vde-base:latest &>/dev/null; then
            build_base_image
        fi
        build_vm_image "$SPECIFIC_VM"
    fi
else
    # Build all: base first, then all VMs
    build_base_image
    
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "Building all VM images..."
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    
    for vm in $(get_vm_list); do
        build_vm_image "$vm" || true
    done
    
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "Build complete!"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    docker images | grep "^vde-"
fi

echo ""
echo "Done!"
