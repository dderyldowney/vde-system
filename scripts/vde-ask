#!/usr/bin/env zsh
#===============================================================================
# vde-ask - Natural language command interface for VDE
# Routes natural language input through vde-parser (generate_plan | execute_plan)
#
# Usage: vde ask <natural language input>
#   e.g. vde ask "list all vms"
#        vde ask "start the python vm"
#        vde ask "create a rust development environment"
#===============================================================================

VDE_ROOT_DIR="${0:a:h:h}"
export VDE_ROOT_DIR

# Source required libraries
[[ -f "$VDE_ROOT_DIR/scripts/lib/vde-shell-compat" ]] && source "$VDE_ROOT_DIR/scripts/lib/vde-shell-compat" &>/dev/null
[[ -f "$VDE_ROOT_DIR/scripts/lib/vde-constants"    ]] && source "$VDE_ROOT_DIR/scripts/lib/vde-constants"    &>/dev/null
[[ -f "$VDE_ROOT_DIR/scripts/lib/vde-errors"       ]] && source "$VDE_ROOT_DIR/scripts/lib/vde-errors"       &>/dev/null
[[ -f "$VDE_ROOT_DIR/scripts/lib/vde-log"          ]] && source "$VDE_ROOT_DIR/scripts/lib/vde-log"          &>/dev/null
[[ -f "$VDE_ROOT_DIR/scripts/lib/vde-naming"       ]] && source "$VDE_ROOT_DIR/scripts/lib/vde-naming"       &>/dev/null
[[ -f "$VDE_ROOT_DIR/scripts/lib/vde-security"     ]] && source "$VDE_ROOT_DIR/scripts/lib/vde-security"     &>/dev/null
[[ -f "$VDE_ROOT_DIR/scripts/lib/vde-core"         ]] && source "$VDE_ROOT_DIR/scripts/lib/vde-core"         &>/dev/null
[[ -f "$VDE_ROOT_DIR/scripts/lib/vm-common"        ]] && source "$VDE_ROOT_DIR/scripts/lib/vm-common"        &>/dev/null
[[ -f "$VDE_ROOT_DIR/scripts/lib/vde-commands"     ]] && source "$VDE_ROOT_DIR/scripts/lib/vde-commands"     &>/dev/null
[[ -f "$VDE_ROOT_DIR/scripts/lib/vde-parser"       ]] && source "$VDE_ROOT_DIR/scripts/lib/vde-parser"       &>/dev/null

if [[ $# -eq 0 ]]; then
    echo "Usage: vde ask <natural language input>"
    echo ""
    echo "Examples:"
    echo "  vde ask \"list all vms\""
    echo "  vde ask \"start the python vm\""
    echo "  vde ask \"create a rust environment\""
    exit 2
fi

input="$*"

# Verify parser functions are available
if ! type generate_plan &>/dev/null || ! type execute_plan &>/dev/null; then
    echo "Error: vde-parser not available" >&2
    exit 1
fi

# Generate plan (redirect all log output to stderr so only the plan line goes to stdout)
plan=$(VDE_LOG_LEVEL=ERROR generate_plan "$input" 2>/dev/null | grep -E '^[A-Z]+:' | head -1)

if [[ -z "$plan" ]]; then
    echo "Could not understand: $input" >&2
    echo "Try 'vde help' for available commands." >&2
    exit 2
fi

# Execute the plan
echo "$plan" | execute_plan
exit $?
