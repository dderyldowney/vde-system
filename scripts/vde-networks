#!/usr/bin/env zsh
#===============================================================================
# vde-networks - List/Create VDE Docker networks
# Usage: vde-networks [options]
#
# Options:
#   -c, --create    Create vde-net network if it doesn't exist
#   -q, --quiet     Only show network names
#===============================================================================

# Determine VDE root directory
VDE_ROOT_DIR="${0:a:h:h}"
export VDE_ROOT_DIR

# Source core libraries
[[ -f "$VDE_ROOT_DIR/scripts/lib/vde-shell-compat" ]] && source "$VDE_ROOT_DIR/scripts/lib/vde-shell-compat" &>/dev/null
[[ -f "$VDE_ROOT_DIR/scripts/lib/vde-constants" ]] && source "$VDE_ROOT_DIR/scripts/lib/vde-constants" &>/dev/null
[[ -f "$VDE_ROOT_DIR/scripts/lib/vde-errors" ]] && source "$VDE_ROOT_DIR/scripts/lib/vde-errors" &>/dev/null

# Parse options
QUIET=0
CREATE=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        -c|--create)
            CREATE=1
            shift
            ;;
        -q|--quiet)
            QUIET=1
            shift
            ;;
        *)
            shift
            ;;
    esac
done

# Variables are sourced from vde-constants
# Use VDE_DOCKER_NETWORK from constants for production network
VDE_NETWORK="${VDE_DOCKER_NETWORK}"

# Create network if requested
if [ $CREATE -eq 1 ]; then
    source "$VDE_ROOT_DIR/scripts/lib/vde-security"
    vde_security_ensure_network "$VDE_NETWORK"
fi

if [ $QUIET -eq 1 ]; then
    docker network ls --format '{{.Name}}' | grep "^${VDE_NETWORK}" || true
else
    docker network ls --format 'table {{.Name}}\t{{.Driver}}\t{{.Scope}}' | grep "^${VDE_NETWORK}" || true
fi

exit 0
