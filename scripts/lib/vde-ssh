#!/usr/bin/env zsh
# VDE SSH Library
# SSH key management and configuration for VDE
# Source this library with: source ./scripts/lib/vde-ssh
#
# This library provides:
# - SSH key detection, generation, and validation
# - SSH config management for VM-to-VM communication
# - SSH known_hosts management
# - SSH agent integration
#
# Dependencies:
#   - vde-core (sets VDE_ROOT_DIR and core constants)
#   - vde-errors (error handling)

# =============================================================================
# SOURCE GUARD
# =============================================================================

if [ "${_VDE_SSH_LOADED:-}" = "1" ]; then
    return 0 2>/dev/null || exit 0
fi
_VDE_SSH_LOADED=1

# =============================================================================
# DEPENDENCIES - VDE_ROOT_DIR MUST BE SET FIRST
# =============================================================================

# vde-core is the source of truth for VDE_ROOT_DIR
# Always source vde-core first to establish VDE_ROOT_DIR
. "$VDE_ROOT_DIR/scripts/lib/vde-core"

# Now VDE_ROOT_DIR is guaranteed to be set from vde-core
# Source remaining dependencies
. "$VDE_ROOT_DIR/scripts/lib/vde-shell-compat"
. "$VDE_ROOT_DIR/scripts/lib/vde-constants"
. "$VDE_ROOT_DIR/scripts/lib/vde-errors"
. "$VDE_ROOT_DIR/scripts/lib/vde-naming"

# =============================================================================
# SSH CONFIGURATION
# =============================================================================

# SSH keys directory for public keys (allow override for tests)
VDE_SSH_KEYS_DIR="${VDE_SSH_KEYS_DIR:-${VDE_ROOT_DIR}/public-ssh-keys}"

# Lock files for atomic operations
SSH_CONFIG_LOCK="${VDE_CACHE_DIR:-${VDE_ROOT_DIR}/.cache}/.ssh_config.lock"

# =============================================================================
# SSH KEY SECURITY FUNCTIONS
# =============================================================================

# Validate that a file is actually a public key (not a private key)
# Args: <filepath>
# Returns: VDE_SUCCESS (0) if valid public key, VDE_ERR_INVALID_INPUT (2) otherwise
validate_public_key_file() {
    local filepath="$1"

    # Must end with .pub
    case "$filepath" in
        *.pub) ;;
        *)
            _error "SECURITY: File does not have .pub extension: $filepath"
            return $VDE_ERR_INVALID_INPUT
            ;;
    esac

    # Must exist and be readable
    if [ ! -f "$filepath" ] || [ ! -r "$filepath" ]; then
        _error "SECURITY: File not readable: $filepath"
        return $VDE_ERR_INVALID_INPUT
    fi

    # Check file content - public keys start with key type
    local first_line
    first_line=$(head -1 "$filepath" 2>/dev/null)

    case "$first_line" in
        ssh-rsa*|ssh-ed25519*|ssh-ecdsa*|ecdsa-sha2-*|sk-ssh-ed25519*|sk-ecdsa-sha2-*)
            ;;
        *)
            _error "SECURITY: File does not appear to be a valid public key: $filepath"
            return $VDE_ERR_INVALID_INPUT
            ;;
    esac

    # Ensure it's NOT a private key
    if grep -q "PRIVATE KEY" "$filepath" 2>/dev/null; then
        _error "SECURITY: CRITICAL - File contains private key data: $filepath"
        return $VDE_ERR_INVALID_INPUT
    fi

    return $VDE_SUCCESS
}

# Check for private keys in public directory
# Args: <directory>
# Returns: VDE_SUCCESS (0) if clean, VDE_ERR_PERMISSION (4) if private keys found
check_for_private_keys_in_public_dir() {
    local dir="$1"
    local found_private=false

    if [ ! -d "$dir" ]; then
        return $VDE_SUCCESS
    fi

    _enable_nullglob
    local file
    for file in "$dir"/*; do
        [ -f "$file" ] || continue

        local basename
        basename=$(basename "$file")

        case "$basename" in
            .keep|.gitignore) continue ;;
        esac

        case "$basename" in
            *.pub) ;;
            *)
                _warn "SECURITY WARNING: Non-.pub file in public keys directory: $basename"
                found_private=true
                ;;
        esac

        if grep -q "PRIVATE KEY" "$file" 2>/dev/null; then
            _error "SECURITY CRITICAL: Private key detected in public directory: $basename"
            found_private=true
        fi
    done
    _disable_nullglob

    if [ "$found_private" = "true" ]; then
        _error "SECURITY: Private keys should NEVER be in the public-ssh-keys directory!"
        return $VDE_ERR_PERMISSION
    fi

    return $VDE_SUCCESS
}

# =============================================================================
# SSH KEY MANAGEMENT FUNCTIONS
# =============================================================================

# Detect available SSH private keys
# Returns: Outputs key filepath to stdout, VDE_SUCCESS (0) if found
detect_ssh_keys() {
    if [ -f "$VDE_SSH_IDENTITY" ] && [ -f "$VDE_SSH_IDENTITY_PUB" ]; then
        echo "$VDE_SSH_IDENTITY"
        return $VDE_SUCCESS
    fi
    return $VDE_ERR_NOT_FOUND
}

# Get primary SSH key filepath
# Returns: Outputs key filepath to stdout
get_primary_ssh_key() {
    if [ -f "$VDE_SSH_IDENTITY" ]; then
        echo "$VDE_SSH_IDENTITY"
        return $VDE_SUCCESS
    fi
    return $VDE_ERR_NOT_FOUND
}

# Get public key filepath for a private key
# Args: <private_key>
# Returns: Outputs public key filepath to stdout
get_ssh_pubkey() {
    local private_key="$1"

    if [ -f "${private_key}.pub" ]; then
        echo "${private_key}.pub"
        return $VDE_SUCCESS
    fi
    return $VDE_ERR_NOT_FOUND
}

# Get SSH identity file path
get_ssh_identity_file() {
    echo "$VDE_SSH_IDENTITY"
}

# Sync SSH public keys to VDE's build context
# Returns: VDE_SUCCESS (0) on success
sync_ssh_keys_to_vde() {
    mkdir -p "$VDE_SSH_KEYS_DIR"

    if [ ! -f "$VDE_SSH_IDENTITY_PUB" ]; then
        _error "VDE SSH public key not found"
        return $VDE_ERR_NOT_FOUND
    fi

    local dest_path="$VDE_SSH_KEYS_DIR/vde_id_ed25519.pub"

    if ! validate_public_key_file "$VDE_SSH_IDENTITY_PUB"; then
        _error "SECURITY: Invalid VDE public key file"
        return $VDE_ERR_INVALID_INPUT
    fi

    cp "$VDE_SSH_IDENTITY_PUB" "$dest_path"
    chmod 644 "$dest_path"

    check_for_private_keys_in_public_dir "$VDE_SSH_KEYS_DIR"

    if [ ! -f "$VDE_SSH_KEYS_DIR/.keep" ]; then
        touch "$VDE_SSH_KEYS_DIR/.keep"
    fi

    return $VDE_SUCCESS
}

# Validate or create SSH key
# Returns: VDE_SUCCESS (0) on success
validate_or_create_ssh_key() {
    # Check if VDE SSH key exists
    if [ -f "$VDE_SSH_IDENTITY" ] && [ -f "$VDE_SSH_IDENTITY_PUB" ]; then
        # Validate the key
        if ssh-keygen -l -f "$VDE_SSH_IDENTITY" >/dev/null 2>&1; then
            return $VDE_SUCCESS
        fi
    fi

    # Generate new key
    mkdir -p "$VDE_SSH_DIR"
    chmod 700 "$VDE_SSH_DIR"

    _info "Generating new VDE SSH key..."

    if ssh-keygen -t ed25519 -f "$VDE_SSH_IDENTITY" -N "" -C "vde@$(hostname)" 2>/dev/null; then
        chmod 600 "$VDE_SSH_IDENTITY"
        chmod 644 "$VDE_SSH_IDENTITY_PUB"
        sync_ssh_keys_to_vde
        return $VDE_SUCCESS
    fi

    _error "Failed to generate SSH key"
    return $VDE_ERR_GENERAL
}

# =============================================================================
# SSH CONFIG MANAGEMENT
# =============================================================================

# Check if SSH config entry exists
# Args: <host_alias>
# Returns: VDE_SUCCESS (0) if exists
ssh_config_has_entry() {
    local host_alias="$1"
    local ssh_config="$VDE_SSH_CONFIG"

    if [ ! -f "$ssh_config" ]; then
        return $VDE_ERR_NOT_FOUND
    fi

    if grep -q "^Host $host_alias$" "$ssh_config" 2>/dev/null; then
        return $VDE_SUCCESS
    fi
    return $VDE_ERR_NOT_FOUND
}

# Backup SSH config
backup_ssh_config() {
    local ssh_config="$VDE_SSH_CONFIG"
    local backup_file="${ssh_config}.vde-backup-$(date +%Y%m%d-%H%M%S)"

    if [ -f "$ssh_config" ]; then
        cp "$ssh_config" "$backup_file"
    fi
}

# Acquire lock for atomic operations
acquire_lock() {
    local lock_file="$1"
    local timeout="${2:-30}"
    local elapsed=0

    while [ $elapsed -lt $timeout ]; do
        if mkdir "$lock_file" 2>/dev/null; then
            return $VDE_SUCCESS
        fi
        sleep 1
        elapsed=$((elapsed + 1))
    done

    _error "Timeout acquiring lock: $lock_file"
    return $VDE_ERR_TIMEOUT
}

# Release lock
release_lock() {
    local lock_file="$1"
    rmdir "$lock_file" 2>/dev/null
}

# Merge SSH config entry
merge_ssh_config_entry() {
    local host_alias="$1"
    local ssh_port="$2"
    local display_name="$3"
    local identity_file="$4"

    local ssh_config="$VDE_SSH_CONFIG"
    local temp_file
    temp_file=$(mktemp "${ssh_config}.tmp.XXXXXX")

    if [ -z "$temp_file" ]; then
        _error "Failed to create temporary file"
        return $VDE_ERR_GENERAL
    fi

    local entry="
Host $host_alias
    HostName localhost
    Port $ssh_port
    User root
    IdentityFile $identity_file
    StrictHostKeyChecking no
    UserKnownHostsFile $VDE_SSH_KNOWN_HOSTS
    ForwardAgent yes
    LogLevel ERROR"

    mkdir -p "$(dirname "$ssh_config")"

    if [ -f "$ssh_config" ]; then
        cp "$ssh_config" "$temp_file"
    fi

    echo "" >> "$temp_file"
    echo "$entry" >> "$temp_file"
    chmod 600 "$temp_file"

    if mv "$temp_file" "$ssh_config"; then
        return $VDE_SUCCESS
    fi

    rm -f "$temp_file" 2>/dev/null
    return $VDE_ERR_GENERAL
}

# Add SSH config entry
add_ssh_config_entry() {
    local host_alias="$1"
    local ssh_port="$2"
    local display_name="$3"
    local identity_file="$4"

    local ssh_config="$VDE_SSH_CONFIG"
    local temp_file
    temp_file=$(mktemp "${ssh_config}.tmp.XXXXXX")

    if [ -z "$temp_file" ]; then
        _error "Failed to create temporary file"
        return $VDE_ERR_GENERAL
    fi

    if [ -f "$ssh_config" ]; then
        cp "$ssh_config" "$temp_file"
    fi

    echo "" >> "$temp_file"
    echo "$entry" >> "$temp_file"
    chmod 600 "$temp_file"

    if mv "$temp_file" "$ssh_config"; then
        return $VDE_SUCCESS
    fi

    rm -f "$temp_file" 2>/dev/null
    return $VDE_ERR_GENERAL
}

# Remove SSH config entry
# Args: <host_alias>
# Returns: VDE_SUCCESS (0) on success
remove_ssh_config_entry() {
    local host_alias="$1"
    local ssh_config="$VDE_SSH_CONFIG"

    if [ ! -f "$ssh_config" ]; then
        _error "VDE SSH config file does not exist"
        return $VDE_ERR_NOT_FOUND
    fi

    if ! ssh_config_has_entry "$host_alias"; then
        _error "VDE SSH config entry for '$host_alias' does not exist"
        return $VDE_ERR_NOT_FOUND
    fi

    backup_ssh_config

    local temp_file
    temp_file=$(mktemp "${ssh_config}.tmp.XXXXXX")

    awk -v host="$host_alias" '
        /^Host / && $2 == host { in_block=1; next }
        in_block && /^[A-Za-z]/ { in_block=0 }
        !in_block { print }
    ' "$ssh_config" > "$temp_file"

    chmod 600 "$temp_file"

    if mv "$temp_file" "$ssh_config"; then
        return $VDE_SUCCESS
    fi

    rm -f "$temp_file" 2>/dev/null
    return $VDE_ERR_GENERAL
}

# =============================================================================
# SSH KNOWN HOSTS MANAGEMENT
# =============================================================================

# Remove known_hosts entries for a VM
# Args: <vm_name> [<ssh_port>]
# Returns: VDE_SUCCESS (0) on success
remove_known_hosts_entry() {
    local vm_name="$1"
    local ssh_port="$2"
    local known_hosts="$VDE_SSH_KNOWN_HOSTS"
    local removed=false

    if [ -z "$ssh_port" ]; then
        return $VDE_ERR_INVALID_INPUT
    fi

    if [ ! -f "$known_hosts" ]; then
        return $VDE_SUCCESS
    fi

    local patterns=(
        "[localhost]:$ssh_port"
        "[::1]:$ssh_port"
        "localhost:$ssh_port"
    )

    if [ -n "$vm_name" ]; then
        patterns+=("$vm_name")
    fi

    for pattern in "${patterns[@]}"; do
        if ssh-keygen -f "$known_hosts" -R "$pattern" 2>/dev/null; then
            removed=true
        fi
    done

    if [ -f "$known_hosts" ]; then
        local temp_file
        temp_file=$(mktemp "${known_hosts}.tmp.XXXXXX")
        grep -v ":$ssh_port" "$known_hosts" > "$temp_file" 2>/dev/null || true

        if [ -s "$temp_file" ]; then
            mv "$temp_file" "$known_hosts"
            chmod 600 "$known_hosts"
        else
            rm -f "$temp_file"
        fi
    fi

    return $VDE_SUCCESS
}

# =============================================================================
# SSH AGENT FUNCTIONS
# =============================================================================

# Check if SSH agent is running
# Returns: 0 if running, 1 otherwise
ssh_agent_is_running() {
    [ -n "$SSH_AUTH_SOCK" ] && [ -S "$SSH_AUTH_SOCK" ]
}

# Start SSH agent and add keys
# Returns: VDE_SUCCESS (0) on success
ensure_ssh_agent() {
    if ssh_agent_is_running; then
        return $VDE_SUCCESS
    fi

    eval "$(ssh-agent -s)" >/dev/null 2>&1
    export SSH_AUTH_SOCK

    local keys
    keys=$(detect_ssh_keys)

    local key_count=0
    local key
    for key in $keys; do
        [ -n "$key" ] || continue
        key_count=$((key_count + 1))
    done

    if [ $key_count -eq 0 ]; then
        _info "Generating SSH key for VDE..."
        ssh-keygen -t ed25519 -f "$VDE_SSH_IDENTITY" -N "" -C "$(whoami)@$(hostname)-vde" >/dev/null 2>&1
        sync_ssh_keys_to_vde >/dev/null 2>&1
        keys=$(detect_ssh_keys)
    fi

    local keys_added=0
    for key in $keys; do
        [ -n "$key" ] || continue
        ssh-add "$key" 2>/dev/null
        keys_added=$((keys_added + 1))
    done

    _info "SSH agent started with $keys_added key(s)"
    return $VDE_SUCCESS
}

# =============================================================================
# SSH SETUP AND VERIFICATION
# =============================================================================

# Verify SSH configuration for a VM
# Args: <vm_name> <ssh_port>
# Returns: VDE_SUCCESS (0) if configured, error code otherwise
verify_ssh_config() {
    local vm_name="$1"
    local ssh_port="$2"

    if ! ssh_config_has_entry "$vm_name"; then
        _error "SSH config entry for '$vm_name' not found"
        return $VDE_ERR_NOT_FOUND
    fi

    local known_hosts_file="$VDE_SSH_KNOWN_HOSTS"
    if [ ! -f "$known_hosts_file" ]; then
        _warn "Known hosts file not found: $known_hosts_file"
        return $VDE_ERR_NOT_FOUND
    fi

    return $VDE_SUCCESS
}

# Setup SSH for VM-to-VM communication
# Args: <vm_name> <ssh_port> [<display_name>]
# Returns: VDE_SUCCESS (0) on success
setup_ssh_for_vm() {
    local vm_name="$1"
    local ssh_port="$2"
    local display_name="${3:-$vm_name}"

    # Generate or validate SSH key
    if ! validate_or_create_ssh_key; then
        _error "Failed to setup SSH key for VDE"
        return $VDE_ERR_GENERAL
    fi

    # Add SSH config entry - use vde- prefix for SSH host
    local ssh_host
    ssh_host=$(vde_get_ssh_host "$vm_name")
    if ! add_ssh_config_entry "$ssh_host" "$ssh_port" "$display_name" "$VDE_SSH_IDENTITY"; then
        _error "Failed to add SSH config entry for '$ssh_host'"
        return $VDE_ERR_GENERAL
    fi

    # Sync public key to VDE
    if ! sync_ssh_keys_to_vde; then
        _warn "Failed to sync SSH keys to VDE"
    fi

    _success "SSH configured for VM: $vm_name (port: $ssh_port)"
    return $VDE_SUCCESS
}

# Get SSH port for a VM
# Args: <vm_name>
# Returns: SSH port number or empty
get_vm_ssh_port() {
    local vm_name="$1"

    # First check vde-core for cached types
    vde_core_load_types

    # Try to get port from VM types
    local vm_type
    vm_type=$(vde_core_get_vm_type "$vm_name")

    if [ -n "$vm_type" ]; then
        # Extract port from type (format: lang:<port> or service:<port>)
        echo "$vm_type" | cut -d':' -f2
        return
    fi

    # Fallback: try to extract from SSH config
    if [ -f "$VDE_SSH_CONFIG" ]; then
        local entry
        entry=$(grep -A10 "^Host $vm_name$" "$VDE_SSH_CONFIG" 2>/dev/null | grep "Port" | head -1 | awk '{print $2}')
        if [ -n "$entry" ]; then
            echo "$entry"
            return
        fi
    fi

    # Default port for VDE VMs
    echo "2200"
}

# Ensure VDE SSH environment is properly configured
# Returns: VDE_SUCCESS (0) if configured
ensure_vde_ssh_environment() {
    # Create SSH directory
    mkdir -p "$VDE_SSH_DIR"
    chmod 700 "$VDE_SSH_DIR"

    # Validate or create SSH key
    if ! validate_or_create_ssh_key; then
        _error "Failed to create VDE SSH key"
        return $VDE_ERR_GENERAL
    fi

    # Create SSH config directory if needed
    mkdir -p "$(dirname "$VDE_SSH_CONFIG")"
    chmod 700 "$(dirname "$VDE_SSH_CONFIG")"

    # Create known_hosts file if needed
    touch "$VDE_SSH_KNOWN_HOSTS"
    chmod 600 "$VDE_SSH_KNOWN_HOSTS"

    # Ensure SSH agent if needed
    if [ -z "$SSH_AUTH_SOCK" ] || [ ! -S "$SSH_AUTH_SOCK" ]; then
        ensure_ssh_agent
    fi

    return $VDE_SUCCESS
}

# Alias for ensure_vde_ssh_environment (used by scripts)
ensure_ssh_environment() {
    ensure_vde_ssh_environment "$@"
}

# generate_vm_ssh_config - Regenerate SSH config entries for all known VMs
# Returns: VDE_SUCCESS (0) on success
generate_vm_ssh_config() {
    _info "Generating VM-to-VM SSH config..."

    # Ensure SSH directory exists
    mkdir -p "$VDE_SSH_DIR"

    # Get all known VMs
    # Note: get_all_vms is expected to be provided by vm-common or vde-commands
    if ! command -v get_all_vms >/dev/null 2>&1; then
        _error "Dependency error: get_all_vms function not found"
        return $VDE_ERR_DEPENDENCY
    fi

    local vms
    vms=($(get_all_vms))

    local count=0
    for vm in "${vms[@]}"; do
        local port
        port=$(get_vm_ssh_port "$vm")
        [[ -z "$port" ]] && continue

        local display
        display=$(get_vm_info display "$vm" 2>/dev/null || echo "$vm")

        # Use vde- prefix for SSH host alias
        local ssh_host
        ssh_host=$(vde_get_ssh_host "$vm")

        if add_ssh_config_entry "$ssh_host" "$port" "$display" "$VDE_SSH_IDENTITY" >/dev/null 2>&1; then
            count=$((count + 1))
        fi
    done

    _success "Generated SSH config for $count VMs"
    return $VDE_SUCCESS
}

# Get SSH directory
get_ssh_dir() {
    echo "$VDE_SSH_DIR"
}
