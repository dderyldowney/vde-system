# Get VM info field
# Args: <field> <vm_name>
# Returns: Outputs field value, or error
get_vm_info() {
    # Ensure XTRACE is off to prevent output pollution
    unsetopt XTRACE 2>/dev/null
    
    local field="$1"
    local vm_name="$2"

    # DEBUG
    # echo "DEBUG: get_vm_info field=$field vm=$vm_name type=${VM_TYPE[$vm_name]}" >&2

    # Check if VM is known
    if [[ -z "${VM_TYPE[$vm_name]:-}" ]]; then
        return $VDE_ERR_NOT_FOUND
    fi

    local var_name="VM_${(U)field}[$vm_name]"
    local value="${(P)var_name}"

    # Output value (even if empty) and return success
    echo "$value"
    return $VDE_SUCCESS
}

# Get all VMs of a specific type
# Args: <type> (lang|service)
# Returns: Outputs VM names
get_vms_by_type() {
    local vm_type="$1"

    case "$vm_type" in
        lang)
            echo "${lang_vms[@]}"
            ;;
        service)
            echo "${service_vms[@]}"
            ;;
        *)
            echo ""
            ;;
    esac
}

# Get all language VMs
get_lang_vms() {
    echo "${lang_vms[@]}"
}

# Get all service VMs
get_service_vms() {
    echo "${service_vms[@]}"
}

# Get all known VMs
get_all_vms() {
