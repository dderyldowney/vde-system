# =============================================================================

# Ensure VM directories exist
# Args: <vm_name> <vm_type>
ensure_vm_directories() {
    local vm="$1"
    local vm_type="$2"

    local -a dirs

    if [ "$vm_type" = "lang" ]; then
        dirs=("$CONFIGS_DIR/$vm" "$VDE_ROOT_DIR/projects/$vm" "$VDE_ROOT_DIR/logs/$vm")
    else
        dirs=("$CONFIGS_DIR/$vm" "$VDE_ROOT_DIR/data/$vm" "$VDE_ROOT_DIR/logs/$vm")
    fi

    local dir
    for dir in "${dirs[@]}"; do
        if [ ! -d "$dir" ]; then
            mkdir -p "$dir"
            _info "Created directory: $dir"
        fi
    done
}

