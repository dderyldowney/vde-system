# Get Docker state directory
get_docker_state_dir() {
    echo "$VDE_ROOT_DIR/.docker-state"
}

# Save Docker state
# Args: <vm_name> <state_json>
save_docker_state() {
    local vm_name="$1"
    local state="$2"
    local state_dir
    state_dir=$(get_docker_state_dir)

    mkdir -p "$state_dir"
    echo "$state" > "$state_dir/${vm_name}.json"
}

# Load Docker state
# Args: <vm_name>
# Returns: Outputs state JSON
load_docker_state() {
    local vm_name="$1"
    local state_dir
    state_dir=$(get_docker_state_dir)
    local state_file="$state_dir/${vm_name}.json"

    if [ -f "$state_file" ]; then
        cat "$state_file"
        return $VDE_SUCCESS
    fi
    return $VDE_ERR_NOT_FOUND
}

# Clear Docker state
# Args: [<vm_name>]
clear_docker_state() {
    local vm_name="${1:-}"
    local state_dir
    state_dir=$(get_docker_state_dir)

    if [ -n "$vm_name" ]; then
        rm -f "$state_dir/${vm_name}.json"
    else
        rm -rf "$state_dir"
        mkdir -p "$state_dir"
    fi
}

