# =============================================================================
# CACHE VALIDATION
# =============================================================================

# Check if cache is valid based on source file modification time
# Args: <cache_file> <source_file>
# Returns: 0 if cache is valid, 1 if stale
# Usage: _is_cache_valid cache_file source_file1 [source_file2 ...]
_is_cache_valid() {
    local cache_file="$1"
    shift
    local source_files=("$@")

    if [[ ! -f "$cache_file" ]]; then
        return 1
    fi

    # Check if any source file is newer than cache
    local cache_mtime source_mtime
    cache_mtime=$(stat -f "%m" "$cache_file" 2>/dev/null || stat -c "%Y" "$cache_file" 2>/dev/null)

    for source_file in "${source_files[@]}"; do
        if [[ -f "$source_file" ]]; then
            source_mtime=$(stat -f "%m" "$source_file" 2>/dev/null || stat -c "%Y" "$source_file" 2>/dev/null)
            if [[ "$source_mtime" -gt "$cache_mtime" ]]; then
                return 1
            fi
        fi
    done

    return 0
}

# =============================================================================
# VM TYPE LOADING
# =============================================================================

# Load VM types from configuration file
# Uses cache if available and valid
# Format: shortname|type|display_name|install_command|port_base
load_vm_types() {
    # Ensure associative arrays are globally declared
    typeset -gA VM_TYPE VM_ALIASES VM_DISPLAY VM_INSTALL VM_SVC_PORT

    # Guard to prevent redundant loading
    if [[ "${_VM_TYPES_LOADED:-0}" == "1" ]] && [[ ${#VM_TYPE[@]} -gt 0 ]]; then
        return 0
    fi

    # Prefer JSON config if available
    if [[ -f "$VM_TYPES_JSON" ]]; then
        _info "Using JSON VM types config: $VM_TYPES_JSON"

        # Validate against schema using centralized vde-core function
        local schema_file
        schema_file=$(vde_get_schema_for_json "$VM_TYPES_JSON" 2>/dev/null)
        if [[ -n "$schema_file" && -f "$schema_file" ]]; then
            _info "Validating config against schema: $schema_file"
            if ! vde_validate_json_schema "$VM_TYPES_JSON" "$schema_file"; then
                _error "VM types JSON schema validation failed"
                _error "Config file may be corrupt or missing required fields"
                return $VDE_ERR_INVALID_DATA
            fi
        else
            _warn "No schema file found for $VM_TYPES_JSON, skipping validation"
        fi
    elif [[ -f "$VM_TYPES_CONF" ]]; then
        _info "Using legacy CONF VM types config: $VM_TYPES_CONF"
    else
        _error "VM types configuration file not found (JSON or CONF)"
        return $VDE_ERR_NOT_FOUND
    fi

    # Try cache first - validate it's not corrupt
    local use_cache=0
    if _is_cache_valid "$VM_TYPES_CACHE" "$VM_TYPES_JSON" "$VM_TYPES_CONF"; then
        # Verify cache file is valid zsh before sourcing
        if zsh -n "$VM_TYPES_CACHE" 2>/dev/null; then
            _info "Loading VM types from cache..."
            if . "$VM_TYPES_CACHE" 2>/dev/null; then
                use_cache=1
                # Read lang_vms and service_vms from cache if present
                # These are stored as simple arrays after the associative arrays
                if [[ -f "$VM_TYPES_CACHE" ]]; then
                    # Extract lang_vms and service_vms from cache file
                    local lang_line svc_line
                    lang_line=$(grep "^lang_vms=" "$VM_TYPES_CACHE" 2>/dev/null)
                    svc_line=$(grep "^service_vms=" "$VM_TYPES_CACHE" 2>/dev/null)
                    if [[ -n "$lang_line" ]]; then
                        local content=${lang_line#*=\(}
                        content=${content%\)}
                        lang_vms=($(echo $content))
                    fi
                    if [[ -n "$svc_line" ]]; then
                        local content=${svc_line#*=\(}
                        content=${content%\)}
                        service_vms=($(echo $content))
                    fi
                fi
                # VM_INSTALL is not cached - will load from config below
                _info "Cache loaded successfully"
            else
                _warn "Cache file corrupt, will regenerate: $VM_TYPES_CACHE"
                rm -f "$VM_TYPES_CACHE"
            fi
        else
            _warn "Cache file has syntax errors, will regenerate: $VM_TYPES_CACHE"
            rm -f "$VM_TYPES_CACHE"
        fi
    fi

    # If cache was successfully loaded, we still need to load VM_INSTALL
    # as it is not cached due to complex shell syntax
    if [[ "$use_cache" -eq 1 ]]; then
        if [[ -f "$VM_TYPES_JSON" ]]; then
            # Parse language VM installs - suppress all output to avoid pollution
            {
                lang_configs=$(jq -c ".vms.language[]" "$VM_TYPES_JSON" 2>/dev/null)
                if [[ -n "$lang_configs" ]]; then
                    local temp_file
                    temp_file=$(mktemp)
                    print -r "$lang_configs" > "$temp_file"
                    while IFS= read -r vm_entry; do
                        [[ -z "$vm_entry" ]] && continue
                        local name install
                        name=$(echo "$vm_entry" | jq -r ".name")
                        install=$(echo "$vm_entry" | jq -r '.install // "-"')
                        [[ -z "$name" ]] && continue
                        VM_INSTALL[$name]="$install"
                    done < "$temp_file"
                    rm -f "$temp_file"
                fi
                # Parse service VM installs
                local svc_configs
                svc_configs=$(jq -c ".vms.service[]" "$VM_TYPES_JSON" 2>/dev/null)
                if [[ -n "$svc_configs" ]]; then
                    local temp_file
                    temp_file=$(mktemp)
                    print -r "$svc_configs" > "$temp_file"
                    while IFS= read -r vm_entry; do
                        [[ -z "$vm_entry" ]] && continue
                        local name install
                        name=$(echo "$vm_entry" | jq -r ".name")
                        install=$(echo "$vm_entry" | jq -r '.install // "-"')
                        [[ -z "$name" ]] && continue
                        VM_INSTALL[$name]="$install"
                    done < "$temp_file"
                    rm -f "$temp_file"
                fi
            } >/dev/null 2>&1
        elif [[ -f "$VM_TYPES_CONF" ]]; then
            while IFS='|' read -r type name vm_aliases display install _rest; do
                [[ -z "$name" || "$type" == "#"* ]] && continue
                VM_INSTALL[$name]="$install"
            done < "$VM_TYPES_CONF" 2>/dev/null
        fi
    fi

    if [[ "$use_cache" -ne 1 ]]; then
        _info "Loading VM types from JSON config..."

        # Clear existing arrays
        VM_TYPE=()
        VM_ALIASES=()
        VM_DISPLAY=()
        VM_INSTALL=()
        VM_SVC_PORT=()

        # Read and parse configuration from JSON
        # Format: .vms.language[] and .vms.service[] with fields: name, aliases, display, install, port
        if [[ -f "$VM_TYPES_JSON" ]]; then
            _info "Parsing VM types from JSON: $VM_TYPES_JSON"

            # Parse language VMs
            local lang_vms
            lang_vms=$(jq -c ".vms.language[]" "$VM_TYPES_JSON" 2>/dev/null)
            if [[ -n "$lang_vms" ]]; then
                while IFS= read -r vm_entry; do
                    [[ -z "$vm_entry" ]] && continue

                    vm_type="lang"
                    name=$(echo "$vm_entry" | jq -r ".name")
                    alias_value=$(echo "$vm_entry" | jq -r '.aliases | join(",")' )
                    display=$(echo "$vm_entry" | jq -r ".display")
                    install=$(echo "$vm_entry" | jq -r '.install // "-"')
                    port=$(echo "$vm_entry" | jq -r '.port // empty')

                    [[ -z "$name" ]] && continue

                    VM_TYPE[$name]="$vm_type"
                    VM_ALIASES[$name]="$alias_value"
                    VM_DISPLAY[$name]="${display:-$name}"
                    VM_INSTALL[$name]="${install:--}"
                    VM_SVC_PORT[$name]="${port:-}"

                    # Build index by type
                    if [[ -z "${lang_vms_array[*]}" ]]; then
                        lang_vms_array=("$name")
                    else
                        lang_vms_array+=("$name")
                    fi
                done <<< "$lang_vms"
            fi

            # Parse service VMs
            local svc_vms
            svc_vms=$(jq -c ".vms.service[]" "$VM_TYPES_JSON" 2>/dev/null)
            if [[ -n "$svc_vms" ]]; then
                while IFS= read -r vm_entry; do
                    [[ -z "$vm_entry" ]] && continue

                    vm_type="service"
                    name=$(echo "$vm_entry" | jq -r ".name")
                    alias_value=$(echo "$vm_entry" | jq -r '.aliases | join(",")' )
                    display=$(echo "$vm_entry" | jq -r ".display")
                    install=$(echo "$vm_entry" | jq -r '.install // "-"')
                    port=$(echo "$vm_entry" | jq -r '.port // empty')

                    [[ -z "$name" ]] && continue

                    VM_TYPE[$name]="$vm_type"
                    VM_ALIASES[$name]="$alias_value"
                    VM_DISPLAY[$name]="${display:-$name}"
                    VM_INSTALL[$name]="${install:--}"
                    VM_SVC_PORT[$name]="${port:-}"

                    # Build index by type
                    if [[ -z "${service_vms_array[*]}" ]]; then
                        service_vms_array=("$name")
                    else
                        service_vms_array+=("$name")
                    fi
                done <<< "$svc_vms"
            fi

            # Export type indexes
            lang_vms=("${lang_vms_array[@]}")
            service_vms=("${service_vms_array[@]}")
        else
            _error "JSON config not found: $VM_TYPES_JSON"
            return 1
        fi

        # Create cache directory
        mkdir -p "$VDE_CACHE_DIR"

        # Generate cache file with proper zsh associative array syntax
        # Note: VM_INSTALL is not cached due to complex shell syntax in install commands
        # Use typeset -gA to ensure variables persist when sourced inside functions
        {
            echo "# VM Types Cache - Auto-generated by load_vm_types()"
            echo "# DO NOT EDIT MANUALLY"
            echo "# VM_INSTALL array is NOT cached due to shell command complexity"
            echo ""
            echo "typeset -gA VM_TYPE"
            for key in "${(@k)VM_TYPE}"; do
                value="${VM_TYPE[$key]//'/'\\''}"
                print -r -- "VM_TYPE[${key}]='${value}'"
            done
            echo ""
            echo "typeset -gA VM_ALIASES"
            for key in "${(@k)VM_ALIASES}"; do
                value="${VM_ALIASES[$key]//'/'\\''}"
                print -r -- "VM_ALIASES[${key}]='${value}'"
            done
            echo ""
            echo "typeset -gA VM_DISPLAY"
            for key in "${(@k)VM_DISPLAY}"; do
                value="${VM_DISPLAY[$key]//'/'\\''}"
                print -r -- "VM_DISPLAY[${key}]='${value}'"
            done
            echo ""
            echo "typeset -gA VM_SVC_PORT"
            for key in "${(@k)VM_SVC_PORT}"; do
                value="${VM_SVC_PORT[$key]//'/'\\''}"
                print -r -- "VM_SVC_PORT[${key}]='${value}'"
            done
            echo ""
            # Cache lang_vms and service_vms (use eval-safe quoting)
            lang_vms_quoted=("${lang_vms[@]}"); echo "lang_vms=(${lang_vms_quoted[*]})"
            service_vms_quoted=("${service_vms[@]}"); echo "service_vms=(${service_vms_quoted[*]})"
        } > "$VM_TYPES_CACHE"

        _info "VM types cached for faster loading"
    else
        _info "VM types loaded from cache"
    fi

    _VM_TYPES_LOADED=1
}

