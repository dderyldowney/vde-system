# Get port from registry
# Args: <vm_name>
# Returns: Outputs port number
get_port_from_registry() {
    local vm_name="$1"
    local port_file="$VDE_CACHE_DIR/port-registry/${vm_name}.port"

    if [ -f "$port_file" ]; then
        cat "$port_file"
        return $VDE_SUCCESS
    fi
    return $VDE_ERR_NOT_FOUND
}

# Save port to registry
# Args: <vm_name> <port>
save_port_to_registry() {
    local vm_name="$1"
    local port="$2"
    local port_dir="$VDE_CACHE_DIR/port-registry"

    mkdir -p "$port_dir"
    echo "$port" > "$port_dir/${vm_name}.port"
}

# Remove port from registry
# Args: <vm_name>
remove_port_from_registry() {
    local vm_name="$1"
    local port_file="$VDE_CACHE_DIR/port-registry/${vm_name}.port"

    rm -f "$port_file"
}

# Clear port registry
clear_port_registry() {
    rm -rf "$VDE_CACHE_DIR/port-registry"
    mkdir -p "$VDE_CACHE_DIR/port-registry"
}

# =============================================================================
# PORT ALLOCATION
# =============================================================================

# find_next_available_port - Find next available port for VM type
# Args: <vm_type>
# Returns: VDE_SUCCESS (0) and outputs port to stdout
find_next_available_port() {
    local vm_type="$1"
    local min_port max_port

    if [ "$vm_type" = "lang" ]; then
        min_port=$VDE_LANG_PORT_START
        max_port=$VDE_LANG_PORT_END
    else
        min_port=$VDE_SVC_PORT_START
        max_port=$VDE_SVC_PORT_END
    fi

    local port
    port=$(find_available_port "$min_port" "$max_port")
    
    if [ $? -eq 0 ] && [ -n "$port" ]; then
        echo "$port"
        return $VDE_SUCCESS
    fi
    return $VDE_ERR_GENERAL
}

# Find available port in range
# Args: [min_port] [max_port]
# Returns: Outputs port number
find_available_port() {
    local min_port="${1:-2200}"
    local max_port="${2:-2299}"
    local port=$min_port

    while [ $port -le $max_port ]; do
        if ! _is_port_in_use "$port"; then
            echo "$port"
            return $VDE_SUCCESS
        fi
        port=$((port + 1))
    done

    _error "No available port in range $min_port-$max_port"
    return $VDE_ERR_NO_PORT
}

# Allocate port for VM
# Args: <vm_name> [min_port] [max_port]
# Returns: Outputs port number
allocate_port_for_vm() {
    local vm_name="$1"
    local min_port="${2:-2200}"
    local max_port="${3:-2299}"

    local existing_port
    existing_port=$(get_port_from_registry "$vm_name")

    if [ -n "$existing_port" ]; then
        echo "$existing_port"
        return $VDE_SUCCESS
    fi

    local new_port
    new_port=$(find_available_port "$min_port" "$max_port")

    if [ -z "$new_port" ]; then
        return $VDE_ERR_NO_PORT
    fi

    save_port_to_registry "$vm_name" "$new_port"
    echo "$new_port"
}

# Get or allocate port for VM
# Args: <vm_name>
# Returns: Outputs port number
get_or_allocate_port() {
    local vm_name="$1"
    local vm_type
    vm_type=$(get_vm_type "$vm_name")

    local min_port max_port
    case "$vm_type" in
        lang)
            min_port=$VDE_LANG_PORT_START
            max_port=$VDE_LANG_PORT_END
            ;;
        service)
            min_port=$VDE_SVC_PORT_START
            max_port=$VDE_SVC_PORT_END
            ;;
        *)
            min_port=$VDE_LANG_PORT_START
            max_port=$VDE_SVC_PORT_END
            ;;
    esac

    allocate_port_for_vm "$vm_name" "$min_port" "$max_port"
}

# =============================================================================
# BACKUP AND RESTORE
# =============================================================================

# Create timestamped backup
# Args: <source_path>
# Returns: Outputs backup path
create_backup() {
    local source_path="$1"

    if [ ! -e "$source_path" ]; then
        return $VDE_ERR_NOT_FOUND
    fi

    local backup_dir="$BACKUP_DIR/$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$backup_dir"

    local basename
    basename=$(basename "$source_path")
    local backup_path="$backup_dir/$basename"

    cp -a "$source_path" "$backup_path"
    echo "$backup_path"
}

