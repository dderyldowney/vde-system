    echo "${lang_vms[@]}" "${service_vms[@]}"
}

# =============================================================================
# VM QUERY FUNCTIONS
# =============================================================================

# Check if VM is known
# Args: <vm_name>
# Returns: VDE_SUCCESS (0) if known
is_known_vm() {
    local vm_name="$1"

    if [ -n "${VM_TYPE[$vm_name]}" ]; then
        return $VDE_SUCCESS
    fi
    return $VDE_ERR_NOT_FOUND
}

# vm_is_created - Check if a VM has been created (exists in docker-state or has container)
# Args: <vm_name>
# Returns: 0 if VM has been created, 1 otherwise
vm_is_created() {
    local vm_name="$1"
    local state_dir
    state_dir=$(get_docker_state_dir)
    
    # Check if state file exists
    if [[ -f "$state_dir/${vm_name}.json" ]]; then
        return 0
    fi
    return 1
}

# vm_template_exists - Check if a VM template exists (for create validation)
# Args: <vm_name>
# Returns: 0 if template exists, 1 otherwise
vm_template_exists() {
    local vm_name="$1"
    if [[ -f "$CONFIGS_DIR/$vm_name/docker-compose.yml" ]]; then
        return 0
    fi
    return 1
}

# vm_exists - Check if a VM has been created (not just template exists)
# Args: <vm_name>
# Returns: 0 if VM exists (has been created), 1 otherwise
vm_exists() {
    local vm_name="$1"
    vm_is_created "$vm_name"
}

# validate_vm_doesnt_exist - Ensure a VM has not been created yet
# Args: <vm_name>
# Returns: VDE_SUCCESS (0) if not exists, VDE_ERR_EXISTS (6) if already exists
validate_vm_doesnt_exist() {
    local vm_name="$1"
    if vm_is_created "$vm_name"; then
        vde_error_container_exists "$vm_name"
        return $VDE_ERR_EXISTS
    fi
    return $VDE_SUCCESS
}

# validate_vm_type - Ensure a VM type/template exists
# Args: <vm_name>
# Returns: VDE_SUCCESS (0) if template exists, VDE_ERR_INVALID_DATA if not
validate_vm_type() {
    local vm_name="$1"
    if ! vm_template_exists "$vm_name"; then
        vde_error_invalid_vm_type "$vm_name"
        return $VDE_ERR_INVALID_DATA
    fi
    return $VDE_SUCCESS
}

# Get VM type
get_vm_type() {
    local vm_name="$1"
    echo "${VM_TYPE[$vm_name]:-unknown}"
}

# Get VM display name
get_vm_display_name() {
    local vm_name="$1"
    echo "${VM_DISPLAY[$vm_name]:-$vm_name}"
}

# Get VM install command
get_vm_install() {
    local vm_name="$1"
    echo "${VM_INSTALL[$vm_name]:--}"
}

# resolve_vm_name - Resolve VM name or alias to canonical name
# Args: <input>
# Returns: Outputs canonical name to stdout
resolve_vm_name() {
    local input="$1"
    
    # Check if it's already a canonical name
    if [[ -n "${VM_TYPE[$input]}" ]]; then
        echo "$input"
        return 0
    fi
    
    # Check aliases
    for name in "${(@k)VM_ALIASES}"; do
        local aliases="${VM_ALIASES[$name]}"
        if [[ ",$aliases," == *",$input,"* ]]; then
            echo "$name"
            return 0
        fi
    done
    
    # Not found
    return 1
}

# validate_vm_name - Validate VM name against naming conventions
# Alias for vde_validate_name from vde-naming
validate_vm_name() {
    vde_validate_name "$@"
}

# _cache_vm_types - Manual cache generation (compat wrapper)
_cache_vm_types() {
    load_vm_types
}

# get_allocated_ports - Get list of ports currently in use in a range
# Args: <min_port> <max_port>
# Returns: Outputs list of ports to stdout
get_allocated_ports() {
    local min_port="$1"
    local max_port="$2"
    local port=$min_port
    local allocated=""

    while [ $port -le $max_port ]; do
        if _is_port_in_use "$port"; then
            allocated="$allocated $port"
        fi
        port=$((port + 1))
    done

    echo "${allocated# }"
}

