#!/usr/bin/env zsh
# VM Common Library for VDE Management Scripts
# Source this library with: source ./scripts/lib/vm-common
# Requires: zsh 5.0+
#
# This library provides core functionality for VDE VM management including:
# - VM type configuration loading and querying (with caching)
# - Port management with atomic reservation (with registry)
#
# MODULAR ARCHITECTURE (Stage 5):
# This library now sources specialized libraries for:
#   - vde-ssh: SSH key management and configuration
#   - vde-docker: Docker container management
#   - vde-templates: Template rendering for VM creation
#
# For lightweight operations without Docker/SSH dependencies, use vde-core instead.
#
# Return Codes: All functions use standardized return codes from vde-constants:
#   VDE_SUCCESS (0)        - Operation completed successfully
#   VDE_ERR_GENERAL (1)    - Unspecified failure
#   VDE_ERR_INVALID_INPUT (2) - Bad arguments or validation failure
#   VDE_ERR_NOT_FOUND (3)  - Resource doesn't exist
#   VDE_ERR_PERMISSION (4) - Insufficient permissions
#   VDE_ERR_TIMEOUT (5)    - Operation exceeded time limit
#   VDE_ERR_EXISTS (6)     - Resource already exists
#   VDE_ERR_DEPENDENCY (7) - Required dependency missing

# =============================================================================
# SOURCE GUARD
# =============================================================================

if [ "${_VM_COMMON_LOADED:-}" = "1" ]; then
    return 0 2>/dev/null || exit 0
fi
_VM_COMMON_LOADED=1

# Ensure XTRACE is off to prevent output pollution during sourcing/execution
unsetopt XTRACE 2>/dev/null

# =============================================================================
# BOOTSTRAP: DETERMINE VDE ROOT DIRECTORY
# =============================================================================

# If VDE_ROOT_DIR is already exported, use it. Otherwise, derive it.
if [ -z "${VDE_ROOT_DIR:-}" ]; then
    # Derivation logic for VDE root directory
    if [ -n "$ZSH_VERSION" ]; then
        # zsh-specific way to get the path of the current file being sourced
        _VM_COMMON_SOURCE="${(%):-%x}"
    else
        # fallback for other shells
        _VM_COMMON_SOURCE="${BASH_SOURCE[0]:-$0}"
    fi
    
    # Calculate absolute path to root (assuming lib/ is at scripts/lib/)
    VDE_ROOT_DIR="$(cd "$(dirname "$_VM_COMMON_SOURCE")/../.." && pwd)"
fi
export VDE_ROOT_DIR # Ensure VDE_ROOT_DIR is always exported

# =============================================================================
# DEPENDENCIES (CORE)
# =============================================================================

. "$VDE_ROOT_DIR/scripts/lib/vde-log"
. "$VDE_ROOT_DIR/scripts/lib/vde-shell-compat"
. "$VDE_ROOT_DIR/scripts/lib/vde-constants"
. "$VDE_ROOT_DIR/scripts/lib/vde-errors"
. "$VDE_ROOT_DIR/scripts/lib/vde-naming"
. "$VDE_ROOT_DIR/scripts/lib/vde-path-utils"
. "$VDE_ROOT_DIR/scripts/lib/vde-core"

# =============================================================================
# LOGGING ALIASES (map log_*/vde_log_* to vde-log library functions)
# =============================================================================
# These provide consistent logging API across all VDE scripts

# Source vde-log if not already loaded
if [[ "${_VDE_LOG_LOADED:-}" != "1" ]]; then
    . "$VDE_ROOT_DIR/scripts/lib/vde-log"
fi

# Create aliases for scripts that expect log_* prefix
if ! command -v log_info >/dev/null 2>&1; then
    log_info() { vde_log_info "$@"; }
fi

if ! command -v log_error >/dev/null 2>&1; then
    log_error() { vde_log_error "$@"; }
fi

if ! command -v log_warn >/dev/null 2>&1; then
    log_warn() { vde_log_warn "$@"; }
fi

if ! command -v log_debug >/dev/null 2>&1; then
    log_debug() { vde_log_debug "$@"; }
fi

if ! command -v log_success >/dev/null 2>&1; then
    log_success() { vde_log_info "[SUCCESS] $@"; }
fi

# Also create aliases for underscore-prefixed versions (_info, _error, _success, _warn)
if ! command -v _info >/dev/null 2>&1; then
    _info() { vde_log_info "$@"; }
fi

if ! command -v _error >/dev/null 2>&1; then
    _error() { vde_log_error "$@"; }
fi

if ! command -v _warn >/dev/null 2>&1; then
    _warn() { vde_log_warn "$@"; }
fi

if ! command -v _debug >/dev/null 2>&1; then
    _debug() { vde_log_debug "$@"; }
fi

if ! command -v _success >/dev/null 2>&1; then
    _success() { vde_log_info "[SUCCESS] $@"; }
fi

