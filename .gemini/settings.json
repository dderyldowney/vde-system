# VDE ARCHITECTURAL RECORD
<!-- @forge (Agent Configuration) -->
{
  "general": {
    "plan": {
      "directory": "plans"
    }
  },
  "mcp": {
    "allowed": [
      "context7",
      "gemini-docs-mcp",
      "MCP_DOCKER",
      "github",
      "redis",
      "firebase",
      "google-workspace"
    ]
  },
  "mcpServers": {
    "context7": {
      "timeout": 60000,
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ]
    },
    "MCP_DOCKER": {
      "command": "docker",
      "args": [
        "mcp",
        "gateway",
        "run"
      ]
    }
  }
}
