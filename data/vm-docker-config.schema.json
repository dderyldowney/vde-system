{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vde.local/schemas/vm-docker-config.schema.json",
  "title": "VDE VM Docker Configuration",
  "description": "Docker configuration settings for VDE language and service VMs including compose file locations, env files, and mount paths",
  "type": "object",
  "required": ["version", "base_settings", "languages", "services"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Configuration schema version",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string",
      "description": "Optional description of this configuration"
    },
    "base_settings": {
      "type": "object",
      "description": "Shared base settings for all VMs",
      "required": ["context", "base_dockerfile", "network", "username"],
      "properties": {
        "context": {
          "type": "string",
          "description": "Docker build context path",
          "minLength": 1
        },
        "base_dockerfile": {
          "type": "string",
          "description": "Path to base Dockerfile",
          "minLength": 1
        },
        "network": {
          "type": "string",
          "description": "Docker network name",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "description": "Container username",
          "minLength": 1
        },
        "uid": {
          "type": "integer",
          "description": "User ID",
          "minimum": 1000
        },
        "gid": {
          "type": "integer",
          "description": "Group ID",
          "minimum": 1000
        },
        "public_keys_dir": {
          "type": "string",
          "description": "Public SSH keys directory path"
        }
      },
      "additionalProperties": false
    },
    "languages": {
      "type": "object",
      "description": "Language VM configurations",
      "patternProperties": {
        "^[a-z0-9]+$": {
          "$ref": "#/definitions/languageVMConfig"
        }
      },
      "additionalProperties": false
    },
    "services": {
      "type": "object",
      "description": "Service VM configurations",
      "patternProperties": {
        "^[a-z0-9]+$": {
          "$ref": "#/definitions/serviceVMConfig"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "definitions": {
    "languageVMConfig": {
      "type": "object",
      "description": "Configuration for a language development VM",
      "required": ["compose_file", "env_file", "image", "container_name", "workspace_mount", "logs_mount"],
      "properties": {
        "compose_file": {
          "type": "string",
          "description": "Path to docker-compose.yml file",
          "pattern": "^configs/docker/(languages|services)/[a-z0-9]+/docker-compose\\.yml$"
        },
        "env_file": {
          "type": "string",
          "description": "Path to environment variables file",
          "pattern": "^env-files/[a-z0-9]+\\.env$"
        },
        "image": {
          "type": "string",
          "description": "Docker image name",
          "pattern": "^dev-[a-z0-9]+:latest$"
        },
        "container_name": {
          "type": "string",
          "description": "Docker container name (must end with -dev for language VMs)",
          "pattern": "^[a-z0-9]+-dev$"
        },
        "workspace_mount": {
          "type": "string",
          "description": "Workspace volume mount (format: host_path:container_path)",
          "pattern": "^projects/[a-z0-9]+:/home/devuser/workspace$"
        },
        "logs_mount": {
          "type": "string",
          "description": "Logs volume mount (format: host_path:container_path)",
          "pattern": "^logs/[a-z0-9]+:/logs$"
        }
      },
      "additionalProperties": false
    },
    "serviceVMConfig": {
      "type": "object",
      "description": "Configuration for a service VM (database, cache, etc.)",
      "required": ["compose_file", "env_file", "image", "container_name", "data_mount", "logs_mount"],
      "properties": {
        "compose_file": {
          "type": "string",
          "description": "Path to docker-compose.yml file",
          "pattern": "^configs/docker/(languages|services)/[a-z0-9]+/docker-compose\\.yml$"
        },
        "env_file": {
          "type": "string",
          "description": "Path to environment variables file",
          "pattern": "^env-files/[a-z0-9]+\\.env$"
        },
        "image": {
          "type": "string",
          "description": "Docker image name",
          "pattern": "^dev-[a-z0-9]+:latest$"
        },
        "container_name": {
          "type": "string",
          "description": "Docker container name (no -dev suffix for service VMs)",
          "pattern": "^[a-z0-9]+$"
        },
        "data_mount": {
          "type": "string",
          "description": "Data volume mount (format: host_path:container_path)",
          "pattern": "^data/[a-z0-9]+:/data$"
        },
        "logs_mount": {
          "type": "string",
          "description": "Logs volume mount (format: host_path:container_path)",
          "pattern": "^logs/[a-z0-9]+:/logs$"
        }
      },
      "additionalProperties": false
    }
  }
}
