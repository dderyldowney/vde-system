# Project directories - track immediate child directories, ignore their contents
projects/*/
projects/*/*
!projects/csharp/
!projects/js/
!projects/python/
!projects/ruby/
!projects/ros/
!projects/rust/

# Environment-specific files
.env
.env-files/*
logs/*
data/postgres/*
data/redis/*
data/mongodb/*
public-ssh-keys/*
coverage/*
.cache.test-backup/

# Backup files
*.bak
*.backup.*
*.backup

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# Claude Code CLI - local only (machine-specific)
.claude/settings.local.json
.claude/plans
**/.claude/CLAUDE.md
**/*.claude/CLAUDE.md

# All CLAUDE.md files EXCEPT root (only /CLAUDE.md is tracked)
**/CLAUDE.md
!/CLAUDE.md

# OS files
.DS_Store
Thumbs.db

# Docker
*.log
.locks/

# Python cache files
__pycache__

# Test output files
tests/behave-results.json
tests/pretty.output
# Test run output data - accidentally not added earlier
tests/behave-*.json

# Artifact outputs from tests
behave_output*.txt
pytest_output.txt
shell_test_output.txt
output/
tests/test-logs/
*.log
*.txt
*.zsh
bdd_results.txt
e2e_results.txt
pytest_results.txt
run_plan.zsh
test_*.zsh
test_*.txt
unit_test_results.txt
vmload.txt
vmtest.txt
test_parser_output*.txt
test_run_report.txt

