{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vde.local/schemas/behave-config.schema.json",
  "title": "VDE Behave Test Configuration",
  "description": "Configuration schema for Behave BDD testing framework",
  "type": "object",
  "required": ["version", "behave", "logging", "paths"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Configuration schema version",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string",
      "description": "Optional description of this configuration"
    },
    "behave": {
      "type": "object",
      "description": "Behave test runner settings",
      "required": ["format"],
      "properties": {
        "format": {
          "type": "string",
          "description": "Output format",
          "enum": ["pretty", "plain", "json", "progress"]
        },
        "color": {
          "type": "boolean",
          "description": "Enable ANSI color output",
          "default": true
        },
        "order": {
          "type": "string",
          "description": "Scenario execution order",
          "enum": ["normal", "random", "reverse"]
        },
        "show_skipped": {
          "type": "boolean",
          "description": "Show skipped scenarios",
          "default": true
        },
        "show_traceback": {
          "type": "boolean",
          "description": "Show full traceback on errors",
          "default": true
        },
        "stop_on_first_failure": {
          "type": "boolean",
          "description": "Stop on first failure",
          "default": false
        },
        "dry_run": {
          "type": "boolean",
          "description": "Perform dry run (no execution)",
          "default": false
        },
        "tags": {
          "type": "object",
          "description": "Tag filtering",
          "properties": {
            "include": {
              "type": "array",
              "description": "Tags to include",
              "items": {"type": "string"}
            },
            "exclude": {
              "type": "array",
              "description": "Tags to exclude",
              "items": {"type": "string"}
            }
          }
        }
      }
    },
    "logging": {
      "type": "object",
      "description": "Logging configuration",
      "required": ["level"],
      "properties": {
        "level": {
          "type": "string",
          "description": "Log level",
          "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"]
        },
        "format": {
          "type": "string",
          "description": "Log format string",
          "minLength": 1
        },
        "capture": {
          "type": "boolean",
          "description": "Capture stdout",
          "default": true
        },
        "capture_stderr": {
          "type": "boolean",
          "description": "Capture stderr",
          "default": true
        }
      }
    },
    "paths": {
      "type": "object",
      "description": "Test file paths",
      "required": ["features", "steps"],
      "properties": {
        "features": {
          "type": "string",
          "description": "Features directory path",
          "pattern": "^tests/"
        },
        "steps": {
          "type": "string",
          "description": "Step definitions directory path",
          "pattern": "^tests/"
        },
        "test_data": {
          "type": "string",
          "description": "Test fixtures directory path"
        },
        "output": {
          "type": "string",
          "description": "Test results output directory"
        }
      }
    },
    "test_categories": {
      "type": "object",
      "description": "Test category definitions",
      "patternProperties": {
        "^[a-z_]+$": {
          "type": "object",
          "properties": {
            "tags": {
              "type": "array",
              "items": {"type": "string"}
            },
            "description": {
              "type": "string"
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "description": "Test environment settings",
      "properties": {
        "vde_root": {
          "type": "string",
          "description": "VDE root directory"
        },
        "test_timeout": {
          "type": "integer",
          "description": "Test timeout in seconds",
          "minimum": 1
        },
        "cleanup_after_test": {
          "type": "boolean",
          "description": "Cleanup resources after test",
          "default": true
        }
      }
    }
  }
}
