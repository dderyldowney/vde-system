# Behave Configuration for VDE Test Suite
#
# Industry-standard tiered testing:
# - unit: Fast, no external dependencies (parser, library tests)
# - integration: Moderate setup (vde CLI, ssh-setup)
# - e2e: Full Docker/VM environment

{
  "version": "1.0",
  "description": "VDE BDD Test Configuration - Tiered Testing",
  "behave": {
    "format": "pretty",
    "color": true,
    "order": "normal",
    "show_skipped": true,
    "show_traceback": true,
    "stop_on_first_failure": false,
    "dry_run": false
  },
  "paths": {
    "features": "tests/features",
    "steps": "tests/features/steps",
    "test_data": "tests/fixtures"
  },
  "tiers": {
    "unit": {
      "description": "Fast unit tests - parser, library functions",
      "tags": ["@unit"],
      "environment": "environment.unit",
      "timeout": 30,
      "setup": "minimal"
    },
    "integration": {
      "description": "Integration tests - vde CLI, ssh-setup",
      "tags": ["@integration"],
      "environment": "environment.integration", 
      "timeout": 120,
      "setup": "vde_init"
    },
    "e2e": {
      "description": "End-to-end tests - full Docker/VM workflows",
      "tags": ["@docker", "@e2e"],
      "environment": "environment.e2e",
      "timeout": 300,
      "setup": "full"
    }
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(levelname)s - %(message)s"
  },
  "environment": {
    "vde_root": "${VDE_ROOT_DIR}",
    "test_timeout": 300,
    "cleanup_after_test": true
  }
}
