#!/usr/bin/env zsh
# VDE Naming Conventions Library
# Enforces consistent naming for VMs and validates naming patterns
# Source this library with: source ./lib/vde-naming
#
# Naming Convention:
#   Directories (configs/docker/): <name> (e.g., python, postgres)
#   Containers & SSH Aliases: vde-<name> (e.g., vde-python, vde-postgres)
#
# Shell Compatibility: POSIX-compliant (sh, bash, zsh)

if [ "${_VDE_NAMING_LOADED:-}" = "1" ]; then
    return 0 2>/dev/null || exit 0
fi
_VDE_NAMING_LOADED=1

# Patterns
VDE_NAME_PATTERN='^[a-z0-9-]+$'

# vde_validate_name - Validate a VM name
vde_validate_name() {
    local name="${1}"
    
    if [ -z "${name}" ]; then
        echo "VM name cannot be empty"
        return ${VDE_ERR_GENERAL}
    fi
    
    # Allow names with or without vde- prefix for validation
    local base_name="${name#vde-}"
    
    if ! echo "${base_name}" | grep -qE "${VDE_NAME_PATTERN}"; then
        echo "VM name must be lowercase alphanumeric (a-z, 0-9) and can include dashes"
        return ${VDE_ERR_GENERAL}
    fi
    
    return 0
}

# vde_validate_name_or_fail - Validate and exit on failure
vde_validate_name_or_fail() {
    local name="${1}"
    
    if ! vde_validate_name "${name}"; then
        local msg
        msg=$(vde_validate_name "${name}")
        log_error "${msg}"
        exit ${VDE_ERR_INVALID_INPUT}
    fi
}

# vde_normalize_name - Normalize a name to raw canonical format (strips prefix)
# This is used for directory paths and metadata lookups.
vde_normalize_name() {
    local name="${1}"
    name=$(echo "${name}" | tr '[:upper:]' '[:lower:]')
    echo "${name#vde-}"
}

# vde_get_container_name - Get the Docker container name for a VM
vde_get_container_name() {
    local vm_name="${1}"
    # Ensure it starts with vde-
    if [[ ! "${vm_name}" =~ ^vde- ]]; then
        echo "vde-${vm_name}"
    else
        echo "${vm_name}"
    fi
}

# vde_get_ssh_host - Get the SSH Host alias for a VM
vde_get_ssh_host() {
    vde_get_container_name "${1}"
}

# vde_get_hostname - Get the internal hostname (same as container name)
vde_get_hostname() {
    vde_get_container_name "${1}"
}

# vde_detect_vm_type_from_name - Detect VM type from name
vde_detect_vm_type_from_name() {
    local name="${1}"
    local base_name="${name#vde-}"
    
    # Try looking it up in known VM types
    if [[ -n "${VM_TYPE[${base_name}]:-}" ]]; then
        echo "${VM_TYPE[${base_name}]}"
        return 0
    fi

    # Fallback to common patterns
    case "${base_name}" in
        python|rust|js|go|ruby|c|cpp|asm|java|kotlin|swift|php|scala|r|lua|flutter|elixir|haskell)
            echo "lang"
            ;;
        postgres|redis|mongodb|nginx|couchdb|mysql|rabbitmq)
            echo "service"
            ;;
        *)
            echo "lang"
            ;;
    esac
}

# vde_format_name_help - Show naming help
vde_format_name_help() {
    cat <<EOF
VM Naming Conventions:

Config Directories:
  - Format: <name> (e.g., configs/docker/python)

Containers & SSH Access:
  - Format: vde-<name> (e.g., vde-python, vde-postgres)

Rules:
  - Names must be lowercase alphanumeric with dashes
  - Use the vde- prefix for all CLI and SSH interactions
EOF
}
