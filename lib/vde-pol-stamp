#!/usr/bin/env zsh
# @forge (Governance Sentinel)
# ZSH-native shibboleth (Rule 1)
typeset _ZSH_PURE=${(%):-%x}

# lib/vde-pol-stamp - per-tree and per-commit gate stamps (Signet #602, #770)
#
# A stamp records that a git tree (or one commit of it) passed the gate, when, and at which tier:
#   fast  the per-commit check (Sovereign Audit, Gospel, the unit suites the commit changes)
#   full  the tip-of-push certification (audit, suite, Proof of Life, Gospel)
# Two file forms live in the store, and each file holds exactly "<epoch> <tier>":
#   <tree>            a full stamp for that tree; it satisfies any request (fast or full) for it
#   <tree>.<commit>   a fast stamp for exactly that tree and commit; it satisfies only a fast
#                     request for that same tree AND commit
# A fast stamp never satisfies a full request, and a fast stamp for one commit never satisfies
# a fast request for another commit, even when both commits share the tree. A record under the
# bare tree name is accepted only as a full stamp. Stamps expire after VDE_POL_STAMP_TTL seconds
# (default 1800). The store is <git common dir>/vde-gate-stamps, shared by every worktree of
# the repository, local and untracked, never pushed.

zmodload zsh/datetime

# A 40- or 64-hex object name: used for trees and for commits.
typeset -g _VDE_STAMP_TREE_RE='^([0-9a-f]{40}|[0-9a-f]{64})$'
# The fast stamp file name: <tree>.<commit>.
typeset -g _VDE_STAMP_PAIR_RE='^([0-9a-f]{40}|[0-9a-f]{64})\.([0-9a-f]{40}|[0-9a-f]{64})$'

# Print the absolute store directory (under the git common dir).
vde_stamp_dir() {
    local common
    common="$(git rev-parse --git-common-dir)" || return 1
    common="$(cd "${common}" && pwd -P)" || return 1
    print -r -- "${common}/vde-gate-stamps"
}

# Print HEAD's tree hash when the tracked worktree and index are clean; else fail.
# git status hides assume-unchanged and skip-worktree files, so refuse those too,
# and treat any failing git command as "not verified clean".
vde_pol_clean_tree() {
    local st flags
    st="$(git status --porcelain --untracked-files=no)" || return 1
    [[ -z "${st}" ]] || return 1
    flags="$(git ls-files -v)" || return 1
    [[ "${flags}" != *$'\n'[^H]\ * && "${flags}" != [^H]\ * ]] || return 1
    git rev-parse 'HEAD^{tree}'
}

# Succeed when <file> is a fresh, regular, non-symlink record whose content is exactly
# "<epoch> <tier>" with the wanted tier. Any other content (extra words, extra lines,
# a non-numeric epoch, another tier) is refused.
_vde_stamp_record_ok() {
    local file="$1" tier="$2" ttl="$3" content rec_time rec_tier rest
    [[ ! -L "${file}" && -f "${file}" ]] || return 1
    content="$(<"${file}")" || return 1
    [[ "${content}" != *$'\n'* ]] || return 1
    read -r rec_time rec_tier rest <<< "${content}"
    [[ "${rec_time}" == <-> && "${rec_tier}" == "${tier}" && -z "${rest}" ]] || return 1
    (( EPOCHSECONDS - rec_time >= 0 && EPOCHSECONDS - rec_time <= ttl ))
}

# Succeed when the store holds a fresh stamp that satisfies the request.
#   vde_stamp_valid <tree> full                 needs the tree's full stamp
#   vde_stamp_valid <tree> fast <commit>        needs the tree's full stamp, or a fast
#                                               stamp for exactly <tree> and <commit>
# A fast request with no (or a malformed) commit is refused.
vde_stamp_valid() {
    local tree="$1" want="${2:-fast}" commit="${3:-}" ttl="${VDE_POL_STAMP_TTL:-1800}" dir
    [[ "${ttl}" == <-> ]] || ttl=1800
    [[ "${tree}" =~ ${_VDE_STAMP_TREE_RE} ]] || return 1
    case "${want}" in
        full) ;;
        fast) [[ "${commit}" =~ ${_VDE_STAMP_TREE_RE} ]] || return 1 ;;
        *) return 1 ;;
    esac
    dir="$(vde_stamp_dir)" || return 1
    _vde_stamp_record_ok "${dir}/${tree}" full "${ttl}" && return 0
    [[ "${want}" == fast ]] || return 1
    _vde_stamp_record_ok "${dir}/${tree}.${commit}" fast "${ttl}"
}

# Remove every stamp in the store that is a symlink, a malformed or expired record, a record
# whose tier does not match its name (bare name = full, <tree>.<commit> = fast), or an
# unrecognised non-hidden name. Hidden temp files (.stamp.XXXXXX, left by a killed write) are
# never read and are left alone: the glob below never matches dotfiles.
vde_stamp_prune() {
    local dir="$1" ttl="${VDE_POL_STAMP_TTL:-1800}" f base want
    [[ "${ttl}" == <-> ]] || ttl=1800
    for f in "${dir}"/*(N); do
        base="${f:t}"
        if [[ -L "${f}" ]]; then
            rm -f -- "${f}"
            continue
        fi
        [[ -f "${f}" ]] || continue
        if [[ "${base}" =~ ${_VDE_STAMP_TREE_RE} ]]; then
            want=full
        elif [[ "${base}" =~ ${_VDE_STAMP_PAIR_RE} ]]; then
            want=fast
        else
            rm -f -- "${f}"
            continue
        fi
        _vde_stamp_record_ok "${f}" "${want}" "${ttl}" || rm -f -- "${f}"
    done
}

# Write a stamp at <tier> (fast|full) for <tree>; a fast stamp also needs <commit>.
#   full  writes <tree>
#   fast  writes <tree>.<commit>, and never touches the tree's full stamp
# Mode 700 dir, atomic temp file + mv, expired stamps removed. A refused write writes nothing.
vde_stamp_write() {
    local tree="$1" tier="$2" commit="${3:-}" dir file tmp
    [[ "${tree}" =~ ${_VDE_STAMP_TREE_RE} ]] || { print -u2 "[WARN] vde_stamp_write: refusing a non-hex tree name."; return 1; }
    case "${tier}" in
        full) file="${tree}" ;;
        fast)
            [[ "${commit}" =~ ${_VDE_STAMP_TREE_RE} ]] \
                || { print -u2 "[WARN] vde_stamp_write: a fast stamp needs a 40 or 64 hex commit."; return 1; }
            file="${tree}.${commit}"
            ;;
        *) print -u2 "[WARN] vde_stamp_write: tier must be fast or full."; return 1 ;;
    esac
    dir="$(vde_stamp_dir)" || return 1
    mkdir -p -- "${dir}" && chmod 700 -- "${dir}" || { print -u2 "[WARN] vde_stamp_write: could not create ${dir}."; return 1; }
    vde_stamp_prune "${dir}"
    tmp="$(mktemp "${dir}/.stamp.XXXXXX")" || { print -u2 "[WARN] vde_stamp_write: could not create a temp file."; return 1; }
    print -r -- "${EPOCHSECONDS} ${tier}" >| "${tmp}" \
        && mv -f -- "${tmp}" "${dir}/${file}" \
        || { rm -f -- "${tmp}"; print -u2 "[WARN] vde_stamp_write: could not write the stamp for ${file}."; return 1; }
}

# Remove the full stamp for <tree> and every fast stamp of it (<tree>.<commit>). No other tree's.
vde_stamp_clear() {
    local tree="$1" dir
    local -a hits
    [[ "${tree}" =~ ${_VDE_STAMP_TREE_RE} ]] || return 1
    dir="$(vde_stamp_dir)" || return 1
    hits=( "${dir}/${tree}"(N) "${dir}/${tree}".*(N) )
    (( ${#hits} )) || return 0
    rm -f -- "${hits[@]}"
}
