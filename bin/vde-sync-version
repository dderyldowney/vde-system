#!/usr/bin/env zsh
#===============================================================================
# VDE Version Synchronizer (v1.0.0 Hardened)
#===============================================================================

# 1. Initialize the Spine
VDE_ROOT_DIR="${VDE_ROOT_DIR:-$(pwd)}"
source "${VDE_ROOT_DIR}/lib/vde-core"

# 2. Extract the current version from the Beskar Source
local NEW_VER=$(vde_get_version)
[[ "$NEW_VER" == "0.0.0-unknown" ]] && { echo "ERROR: No version in Spec."; exit 1; }

# 3. Logging Fallbacks
if ! command -v vde_log_info >/dev/null; then
    vde_log_info() { echo "\033[1;34m[INFO]\033[0m $1"; }
    vde_log_success() { echo "\033[1;32m[SUCCESS]\033[0m $1"; }
fi

vde_log_info "Synchronizing Tribe to Version: ${NEW_VER}" "forge"

# 4. Strike docs/ARCHITECTURE.md
sed -i '' "1s/^# ARCHITECTURE v.*/# ARCHITECTURE v${NEW_VER} (Absolute)/" "${VDE_ROOT_DIR}/docs/ARCHITECTURE.md"
vde_log_success "Aligned docs/ARCHITECTURE.md" "forge"

# 5. Strike .gemini/instructions.md
# Update title and version footer
sed -i '' "s/# \*\*The Way of the VDE: v[0-9.]* (.*)\*\*/# **The Way of the VDE: v${NEW_VER} (The Sovereign Handshake)**/" "${VDE_ROOT_DIR}/.gemini/instructions.md"
sed -i '' "s/Version: [0-9]\{1,\}\.[0-9]\{1,\}\.[0-9]\{1,\}/Version: ${NEW_VER}/" "${VDE_ROOT_DIR}/.gemini/instructions.md"
sed -i '' "s/VDE-SPEC v[0-9]\{1,\}\.[0-9]\{1,\}\.[0-9]\{1,\}/VDE-SPEC v${NEW_VER}/" "${VDE_ROOT_DIR}/.gemini/instructions.md"
vde_log_success "Aligned .gemini/instructions.md" "forge"

# 6. Strike MEMORY.md
sed -i '' "s/Version: [0-9]\{1,\}\.[0-9]\{1,\}\.[0-9]\{1,\}/Version: ${NEW_VER}/" "${VDE_ROOT_DIR}/MEMORY.md"
sed -i '' "s/SYSTEM BENCHMARKS (VDE [0-9.]*)/SYSTEM BENCHMARKS (VDE ${NEW_VER})/" "${VDE_ROOT_DIR}/MEMORY.md"
vde_log_success "Aligned MEMORY.md" "forge"

# 7. Strike PROJECT_STATUS.md
sed -i '' "s/# Project Status: VDE (.* v[0-9.]*)/# Project Status: VDE (Official Release v${NEW_VER})/" "${VDE_ROOT_DIR}/PROJECT_STATUS.md"
sed -i '' "s/persistence (v[0-9.]*)/persistence (v${NEW_VER})/" "${VDE_ROOT_DIR}/PROJECT_STATUS.md"
vde_log_success "Aligned PROJECT_STATUS.md" "forge"

# 8. Strike tests/TEST_STATUS_REPORT.md
sed -i '' "s/# VDE Test Status Report (Sovereign Certification v[0-9.]*)/# VDE Test Status Report (Sovereign Certification v${NEW_VER})/" "${VDE_ROOT_DIR}/tests/TEST_STATUS_REPORT.md"
sed -i '' "s/SSH Forwarding verified (v[0-9.]*)/SSH Forwarding verified (v${NEW_VER})/" "${VDE_ROOT_DIR}/tests/TEST_STATUS_REPORT.md"
vde_log_success "Aligned tests/TEST_STATUS_REPORT.md" "forge"

# 9. Strike $HOME/.zshrc (The Host Handshake)
local zshrc="${HOME}/.zshrc"
if [[ -f "$zshrc" ]]; then
    # Strikes the gvde function's handshake prompt version
    sed -i '' "s/Initialize VDE Session v[0-9]\{1,\}\.[0-9]\{1,\}\.[0-9]\{1,\}/Initialize VDE Session v${NEW_VER}/" "$zshrc"
    # Strikes any VDE_VERSION="X.X.X" variable
    sed -i '' "s/\(VDE_VERSION=\)[\"'][0-9]\{1,\}\.[0-9]\{1,\}\.[0-9]\{1,\}[\"']/\1\"${NEW_VER}\"/" "$zshrc"
    vde_log_success "Aligned \$HOME/.zshrc gvde handshake" "forge"
fi

vde_log_success "Alignment Complete for Version ${NEW_VER}." "forge"
