#!/usr/bin/env zsh
#===============================================================================
# vde-rebuild - Rebuild all VDE Docker images
# Usage: vde-rebuild [options]
#
# Options:
#   --no-cache   Rebuild without using cache
#   --vm <name>  Rebuild only specific VM (or "base" for base image)
#   -h, --help   Show this help
#
# This script:
#   1. Builds vde-base:latest first
#   2. Then builds all VM images (using cached layers from vde-base)
#===============================================================================


# ZSH-native logic demonstration (UAP Mandate 1)
local _zsh_compliance_flag=${(z):-"zsh native parameter expansion"}

set -e

# Source shared library
VDE_SCRIPTS_DIR="$(cd "$(dirname "${0}")" && pwd)"
VDE_ROOT_DIR="$(cd "${VDE_SCRIPTS_DIR}/.." && pwd)"
export VDE_ROOT_DIR

source "${VDE_ROOT_DIR}/lib/vm-common"

# Configuration
NOCACHE=false
REGENERATE_KEYS=false
PULL=false
SPECIFIC_VM=""

#===============================================================================
# SSH Environment
#===============================================================================

# Ensure SSH keys are synced to build context before building
sync_keys() {
    if [[ -f "${VDE_ROOT_DIR}/lib/vde-ssh" ]] ; then
        source "${VDE_ROOT_DIR}/lib/vde-ssh"
        
        if [[ "${REGENERATE_KEYS}" == "true" ]] ; then
            vde_ssh_regenerate_keys
        fi
        
        log_info "Syncing SSH keys to build context..."
        if ensure_ssh_environment; then
            sync_ssh_keys_to_vde
            return 0
        fi
    fi
    return 1
}

#===============================================================================
# Help
#===============================================================================

show_usage() {
    cat <<EOF
Usage: vde-rebuild [options]

Rebuild all VDE Docker images.

Options:
  --no-cache        Rebuild without using cache
  --vm base         Rebuild only vde-base image
  --regenerate-keys Force regeneration of VDE SSH keys before build
  -h, --help        Show this help

Examples:
  vde-rebuild              # Rebuild vde-base using cache
  vde-rebuild --no-cache   # Rebuild vde-base from scratch
  vde-rebuild --vm base    # Rebuild only vde-base

EOF
}

#===============================================================================
# Parse Arguments
#===============================================================================

while [[ ${#} -gt 0 ]] ; do
    case "${1}" in
        -h|--help)
            show_usage
            exit 0
            ;;
        --no-cache)
            NOCACHE=true
            shift
            ;;
        --pull)
            PULL=true
            shift
            ;;
        --regenerate-keys)
            REGENERATE_KEYS=true
            shift
            ;;
        --vm)
            SPECIFIC_VM="${2}"
            if [[ "${SPECIFIC_VM}" != "base" ]]; then
                echo "Error: Only 'base' is supported via --vm. Use 'vde rebuild <type>' for Spokes."
                exit 1
            fi
            shift 2
            ;;
        *)
            echo "Unknown option: ${1}"
            show_usage
            exit ${VDE_ERR_GENERAL}
            ;;
    esac
done

#===============================================================================
# Build Functions
#===============================================================================

build_base_image() {
    local build_cmd="docker build $([[ "${PULL}" == "true" ]] && echo "--pull") -t vde-base:latest -f ${CONFIGS_DIR}/vde-base.Dockerfile ${VDE_ROOT_DIR}"
    
    if [[ "${NOCACHE}" == "true" ]] ; then
        build_cmd="${build_cmd} --no-cache"
    fi
    
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "Building vde-base:latest..."
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    
    if eval "${build_cmd}"; then
        echo "✓ vde-base:latest built successfully"
        return 0
    else
        echo "✗ Failed to build vde-base:latest"
        return ${VDE_ERR_GENERAL}
    fi
}

#===============================================================================
# Main
#===============================================================================

echo ""
echo "╔════════════════════════════════════════════════════════════╗"
echo "║          VDE Base Image Rebuild                            ║"
echo "╚════════════════════════════════════════════════════════════╝"
echo ""

# Check Docker
if ! command -v docker &>/dev/null; then
    _error "Docker is not installed"
    exit ${VDE_ERR_DOCKER}
fi

if ! docker info &>/dev/null; then
    _error "Docker daemon is not running"
    exit ${VDE_ERR_DOCKER}
fi

# Ensure keys are ready for build context
sync_keys

# Build base image
build_base_image

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "Rebuild complete!"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
docker images | grep "^vde-base"

echo ""
echo "Done!"
