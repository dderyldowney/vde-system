#!/usr/bin/env zsh
set -e

# Source shared library
VDE_SCRIPTS_DIR="$(cd "$(dirname "${0}")" && pwd)"
source "${VDE_ROOT_DIR}/lib/vde-core"
source "${VDE_ROOT_DIR}/lib/vm-common"

# -----------------------
# Usage
# -----------------------
show_usage() {
    cat <<EOF
Usage: add-vm-type [OPTIONS] <name> "<install_cmd>" [aliases]

Add a new language or service to the predefined VM types list.

Arguments:
  name          Name of the VM (e.g., dart, couchdb)
  install_cmd   Installation command (must be quoted)
  aliases       Optional comma-separated aliases (e.g., "js,node,nodejs")

Options:
  --type TYPE       Type of VM: lang or service (default: auto-detect)
  --svc-port PORT   Service port (required for services, e.g., 5432)
  --ssh-port PORT   SSH host port for this VM (required; must be unique in range)
  --display NAME    Display name (default: auto-generated from name)
  --help, -h        Show this help message

Examples:
  # Add a language (auto-detects type as 'lang')
  add-vm-type dart "apt-get update -y && apt-get install -y dart"

  # Add a language with aliases
  add-vm-type dart "apt-get update -y && apt-get install -y dart" "dartlang,flutter"

  # Add a service (requires --type and --svc-port)
  add-vm-type --type service --svc-port 5672 rabbitmq \\
      "apt-get update -y && apt-get install -y rabbitmq-server" "rabbit"

  # Add with custom display name
  add-vm-type --display "Dart Language" dart \\
      "apt-get update -y && apt-get install -y dart"

The script will:
  1. Validate the VM type and parameters
  2. Check if the VM name already exists
  3. Backup the vm-types.conf file
  4. Append the new entry to vm-types.conf
  5. Show the diff

After adding a VM type, you can create it with:
  ./bin/create-virtual-for <name>

EOF
}

# -----------------------
# Parse Arguments
# -----------------------
VM_TYPE_STR=""
SVC_PORT=""
SSH_PORT=""
DISPLAY_NAME=""
INSTALL_CMD=""
ALIASES=""

while [[ ${#} -gt 0 ]]; do
    case ${1} in
        --type)
            VM_TYPE_STR="${2}"
            shift 2
            ;;
        --svc-port)
            SVC_PORT="${2}"
            shift 2
            ;;
        --ssh-port)
            SSH_PORT="${2}"
            shift 2
            ;;
        --display)
            DISPLAY_NAME="${2}"
            shift 2
            ;;
        --help|-h)
            show_usage
            exit 0
            ;;
        *)
            # First positional argument is the name
            if [[ -z "${VM_NAME}" ]]; then
                VM_NAME="${1}"
            # Second positional argument is the install command
            elif [[ -z "${INSTALL_CMD}" ]]; then
                INSTALL_CMD="${1}"
            # Third positional argument is aliases
            elif [[ -z "${ALIASES}" ]]; then
                ALIASES="${1}"
            else
                log_error "Too many arguments"
                echo ""
                show_usage
                exit ${VDE_ERR_GENERAL}
            fi
            shift
            ;;
    esac
done

# Validate required arguments
if [[ -z "${VM_NAME}" ]] || [[ -z "${INSTALL_CMD}" ]]; then
    log_error "Missing required arguments"
    echo ""
    show_usage
    exit ${VDE_ERR_GENERAL}
fi

# -----------------------
# Auto-detect type if not specified
# -----------------------
if [[ -z "${VM_TYPE_STR}" ]]; then
    # If service port is specified, it's a service
    if [[ -n "${SVC_PORT}" ]]; then
        VM_TYPE_STR="service"
    else
        VM_TYPE_STR="lang"
    fi
    log_info "Auto-detected VM type as: ${VM_TYPE_STR}"
fi

if [[ -z "${SSH_PORT}" ]]; then
    log_info "No SSH port specified, auto-allocating..."
    SSH_PORT=$(find_available_ssh_port)
    if [[ $? -ne 0 ]]; then
        log_error "Failed to auto-allocate port (range full or internal error)"
        exit ${VDE_ERR_GENERAL}
    fi
    log_success "Allocated port: ${SSH_PORT}"
fi

# -----------------------
# Validation
# -----------------------
log_info "Validating configuration..."

# Validate VM type
if [[ "${VM_TYPE_STR}" != "lang" ]] && [[ "${VM_TYPE_STR}" != "service" ]]; then
    log_error "Invalid VM type: ${VM_TYPE_STR} (must be 'lang' or 'service')"
    exit ${VDE_ERR_GENERAL}
fi

# Validate VM name format
if [[ ! "${VM_NAME}" =~ ^[a-z0-9]+$ ]]; then
    log_error "VM name must be lowercase alphanumeric (no spaces, hyphens, or special chars)"
    exit ${VDE_ERR_GENERAL}
fi

# Service type requires service port
if [[ "${VM_TYPE_STR}" == "service" ]] && [[ -z "${SVC_PORT}" ]]; then
    log_error "Service type requires --svc-port argument"
    exit ${VDE_ERR_GENERAL}
fi

# Language type should not have service port
if [[ "${VM_TYPE_STR}" == "lang" ]] && [[ -n "${SVC_PORT}" ]]; then
    log_error "Language type should not specify --svc-port"
    exit ${VDE_ERR_GENERAL}
fi

# Validate SSH port range
if [[ "${VM_TYPE_STR}" == "lang" ]] && { [[ "${SSH_PORT}" -lt "${VDE_LANG_PORT_START}" ]] || [[ "${SSH_PORT}" -gt "${VDE_LANG_PORT_END}" ]]; }; then
    log_error "Language SSH port must be in range ${VDE_LANG_PORT_START}-${VDE_LANG_PORT_END} (got ${SSH_PORT})"
    exit ${VDE_ERR_GENERAL}
fi

if [[ "${VM_TYPE_STR}" == "service" ]] && { [[ "${SSH_PORT}" -lt "${VDE_SVC_PORT_START}" ]] || [[ "${SSH_PORT}" -gt "${VDE_SVC_PORT_END}" ]]; }; then
    log_error "Service SSH port must be in range ${VDE_SVC_PORT_START}-${VDE_SVC_PORT_END} (got ${SSH_PORT})"
    exit ${VDE_ERR_GENERAL}
fi

# Validate SSH port not already in use
if grep -q "|${SSH_PORT}$" "${VM_TYPES_CONF}" 2>/dev/null; then
    log_error "SSH port ${SSH_PORT} is already assigned to another VM in vm-types.conf"
    exit ${VDE_ERR_GENERAL}
fi

# Auto-generate display name if not specified
if [[ -z "${DISPLAY_NAME}" ]]; then
    # Capitalize first letter
    DISPLAY_NAME="$(echo "${VM_NAME}" | awk '{print toupper(substr($0,1,1)) substr($0,2)}')"
fi

# -----------------------
# Check if VM already exists
# -----------------------
if is_known_vm "${VM_NAME}"; then
    log_error "VM '${VM_NAME}' already exists in vm-types.conf"
    exit ${VDE_ERR_GENERAL}
fi

# Check if name conflicts with existing vm_aliases
for existing_name in $(get_all_vms); do
    existing_vm_aliases=$(get_vm_info aliases "${existing_name}")
    if [[ ",${existing_vm_aliases}," =~ ",${VM_NAME}," ]]; then
        log_error "VM name '${VM_NAME}' conflicts with an alias for '${existing_name}'"
        exit ${VDE_ERR_GENERAL}
    fi
done

# Validate new aliases don't conflict
if [[ -n "${ALIASES}" ]]; then
    # Convert comma-separated to space-separated for iteration
    local new_aliases_array
    new_aliases_array=(${(s:,:)ALIASES})
    for new_alias in "${new_aliases_array[@]}"; do
        new_alias=$(echo "${new_alias}" | tr -d ' ')
        if resolve_vm_name "${new_alias}" > /dev/null 2>&1; then
            existing_vm=$(resolve_vm_name "${new_alias}")
            log_error "Alias '${new_alias}' conflicts with existing VM: ${existing_vm}"
            exit ${VDE_ERR_GENERAL}
        fi
    done
fi

# -----------------------
# Show what will be added
# -----------------------
echo ""
log_info "Will add the following VM type:"
echo ""
echo "  Type:         ${VM_TYPE_STR}"
echo "  Name:         vde-${VM_NAME}"
echo "  Display:      ${DISPLAY_NAME}"
echo "  Aliases:      ${ALIASES:-<none>}"
echo "  Install:      ${INSTALL_CMD}"
echo "  SSH Port:     ${SSH_PORT}"
if [[ "${VM_TYPE_STR}" == "service" ]]; then
    echo "  Service Port: ${SVC_PORT}"
fi
echo ""

# -----------------------
# Backup vm-types.conf
# -----------------------
log_info "Backing up vm-types.conf..."
backup_file="${BACKUP_DIR}/vm-types.conf.backup.$(date +%Y%m%d_%H%M%S)"
mkdir -p "$(dirname "${backup_file}")"
cp "${VM_TYPES_CONF}" "${backup_file}"
log_success "Backup created: ${backup_file}"

# -----------------------
# Atomic Registry Update
# -----------------------
log_info "Updating Pure Beskar registry..."
local global_lock="${VDE_LOCKS_DIR}/global-config.lock"
acquire_lock "${global_lock}" 60 || exit 1

{
    # 1. Atomic Append to Raw Beskar (.conf)
    # 8-FIELD STANDARD: type|name|aliases|display|pkgs|custom_cmd|env|ports
    local _entry="${VM_TYPE_STR}|vde-${VM_NAME}|${ALIASES}|${DISPLAY_NAME}||zsh /vde/scripts/setup/${VM_NAME}-init.zsh|${SVC_PORT}|${SSH_PORT}"
    echo "${_entry}" >> "${VM_TYPES_CONF}"
    
    # 2. Re-smelt JSON from CONF (vde_translate_conf_to_json handles its own internal locking now too, 
    # but we wrap it here for logical atomicity of the whole operation)
    vde_translate_conf_to_json "${VM_TYPES_CONF}" "${VM_TYPES_JSON}"
    
    # 3. Commit Port to Registry (Numeric lock file)
    allocate_ssh_port "${VM_NAME}" "${SSH_PORT}"
    
    # 4. Invalidate cache to force Ignition on next load
    rm -f "${VDE_ROOT_DIR}/.cache/vm-types.cache" 2>/dev/null
} always {
    release_lock "${global_lock}"
}

log_success "Registry updated and port committed."

# Create the hydration script if it doesn't exist
local _init_script="${VDE_ROOT_DIR}/scripts/setup/${VM_NAME}-init.zsh"
if [[ ! -f "${_init_script}" ]]; then
    log_info "Forging USP hydration script: ${_init_script}"
    mkdir -p "$(dirname "${_init_script}")"
    cat <<EOF > "${_init_script}"
#!/usr/bin/env zsh
# VDE USP Hydration Script: ${VM_NAME}
# Part of the Universal Script Parity (USP) mandate.
# Forged in Beskar
set -e

# 1. THE PACKAGE ALLOY
export DEBIAN_FRONTEND=noninteractive
local vde_${VM_NAME}_pkgs=""

# 2. THE FORGE WORK
${INSTALL_CMD}

# 3. PURGING THE GHOSTS
apt-get clean
rm -rf /var/lib/apt/lists/*
EOF
    chmod +x "${_init_script}"
    log_success "Hydration script forged."
fi

# Update configs/ssh/config with the new entry
local project_ssh_config="${VDE_ROOT_DIR}/configs/ssh/config"
if [[ -f "${project_ssh_config}" ]]; then
    cat >> "${project_ssh_config}" <<SSHEOF


Host vde-${VM_NAME}
    HostName localhost
    Port ${SSH_PORT}
    User devuser
    IdentityFile ${VDE_SSH_IDENTITY}
    StrictHostKeyChecking no
    UserKnownHostsFile ${VDE_SSH_KNOWN_HOSTS}
    ForwardAgent yes
    LogLevel ERROR
SSHEOF
    log_success "Entry added to configs/ssh/config"
fi

# Sync to live SSH config
if [[ -f "${VDE_SSH_CONFIG}" ]]; then
    cp "${project_ssh_config}" "${VDE_SSH_CONFIG}"
    log_success "Synced to ${VDE_SSH_CONFIG}"
fi

# -----------------------
# Show diff
# -----------------------
log_info "Showing diff..."
echo ""
diff "${backup_file}" "${VM_TYPES_CONF}" || true
echo ""

# -----------------------
# Invalidate cache and reload VM types
# -----------------------
log_info "Invalidating VM types cache..."
local cache_file="${VDE_ROOT_DIR}/.cache/vm-types.cache"
[[ -f "${cache_file}" ]] && rm -f "${cache_file}"
log_info "Reloading VM types..."
load_vm_types

# -----------------------
# Summary
# -----------------------
# -----------------------
# Regenerate Configs
# -----------------------
log_info "Regenerating VDE configurations..."
"${BIN_DIR}/generate-all-configs" >/dev/null 2>&1

log_success "VM type '${VM_NAME}' added successfully!"
echo ""
echo "Next steps:"
echo "  1. Create the VM: ./bin/create-virtual-for ${VM_NAME}"
echo "  2. Start the VM: ./bin/start-virtual ${VM_NAME}"
echo ""
