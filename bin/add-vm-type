#!/usr/bin/env zsh
# @armor (Engine Core)
set -e

# Source shared library
# Use zsh-native absolute path detection (Rule 1)
VDE_ROOT_DIR="${0:h:h}"
export VDE_ROOT_DIR
source "${VDE_ROOT_DIR}/lib/vde-core"
source "${VDE_ROOT_DIR}/lib/vm-common"

# ZSH-native logic demonstration (UAP Mandate 1)
typeset _zsh_compliance_flag=${(z):-"zsh native parameter expansion"}

# -----------------------
# Usage
# -----------------------
show_usage() {
    cat <<EOF
Usage: add-vm-type [OPTIONS] <name> "<install_cmd>" [aliases]

Add a new language or service to the predefined VM types list.

Arguments:
  name          Name of the VM (e.g., dart, couchdb)
  install_cmd   Installation command (must be quoted)
  aliases       Optional comma-separated aliases (e.g., "js,node,nodejs")

Options:
  --type TYPE       Type of VM: lang or service (default: auto-detect)
  --svc-port PORT   Service port (required for services, e.g., 5432)
  --ssh-port PORT   SSH host port for this VM (required; must be unique in range)
  --display NAME    Display name (default: auto-generated from name)
  --help, -h        Show this help message

Examples:
  # Add a language (auto-detects type as 'lang')
  add-vm-type dart "apt-get update -y && apt-get install -y dart"

  # Add a language with aliases
  add-vm-type dart "apt-get update -y && apt-get install -y dart" "dartlang,flutter"

  # Add a service (requires --type and --svc-port)
  add-vm-type --type service --svc-port 5672 rabbitmq \\
      "apt-get update -y && apt-get install -y rabbitmq-server" "rabbit"

  # Add with custom display name
  add-vm-type --display "Dart Language" dart \\
      "apt-get update -y && apt-get install -y dart"

The script will:
  1. Validate the VM type and parameters
  2. Check if the VM name already exists
  3. Backup the vm-types.conf file
  4. Append the new entry to vm-types.conf
  5. Show the diff

After adding a VM type, you can create it with:
  ./bin/create-virtual-for <name>

EOF
}

# -----------------------
# Parse Arguments
# -----------------------
VM_TYPE_STR=""
SVC_PORT=""
SSH_PORT=""
DISPLAY=""
INSTALL_CMD=""
ALIASES=""
PKGS=""
QUIET=false

while [[ ${#} -gt 0 ]]; do
    case ${1} in
        --type)
            VM_TYPE_STR="${2}"
            shift 2
            ;;
        --svc-port)
            SVC_PORT="${2}"
            shift 2
            ;;
        --ssh-port|--port)
            SSH_PORT="${2}"
            shift 2
            ;;
        --display)
            DISPLAY="${2}"
            shift 2
            ;;
        --pkgs)
            PKGS="${2}"
            shift 2
            ;;
        --custom)
            CUSTOM_CMD="${2}"
            shift 2
            ;;
        --quiet)
            QUIET=true
            shift
            ;;
        --help|-h)
            show_usage
            exit ${VDE_SUCCESS}
            ;;
        *)
            # First positional argument is the name
            if [[ -z "${VM_NAME}" ]]; then
                VM_NAME="${1}"
            # Second positional argument is the install command
            elif [[ -z "${INSTALL_CMD}" ]]; then
                INSTALL_CMD="${1}"
            # Third positional argument is aliases
            elif [[ -z "${ALIASES}" ]]; then
                ALIASES="${1}"
            else
                log_error "Too many arguments"
                echo ""
                show_usage
                exit ${VDE_ERR_GENERAL}
            fi
            shift
            ;;
    esac
done

# Validate required arguments
if [[ -z "${VM_NAME}" ]]; then
    log_error "Missing required arguments: name"
    echo ""
    show_usage
    exit ${VDE_ERR_GENERAL}
fi

# Default install command if not specified
if [[ -z "${INSTALL_CMD}" ]]; then
    if [[ -n "${PKGS}" ]]; then
        INSTALL_CMD="apt-get update -y && apt-get install -y ${PKGS} && apt-get clean && rm -rf /var/lib/apt/lists/*"
    else
        INSTALL_CMD="echo 'Hydration complete'"
    fi
fi

# -----------------------
# Auto-detect type if not specified
# -----------------------
if [[ -z "${VM_TYPE_STR}" ]]; then
    # If service port is specified, it's a service
    if [[ -n "${SVC_PORT}" ]]; then
        VM_TYPE_STR="service"
    else
        VM_TYPE_STR="lang"
    fi
    log_info "Auto-detected VM type as: ${VM_TYPE_STR}"
fi

# Ensure display name satisfies schema (minLength: 1)
if [[ -z "${DISPLAY}" ]]; then
    DISPLAY="${VM_NAME:c}"
fi

# -----------------------
# Field Normalisation (Signet #534)
# -----------------------
# The 8-Field Standard uses "-" for an absent value, not a blank. A blank is
# not merely cosmetic: the renderer passes the field through to
# PKGS_TO_INSTALL, and configs/docker/vde-lang.Dockerfile guards on
# [ -n "${PKGS_TO_INSTALL}" ], so a non-placeholder empty-ish value changes
# whether the image runs apt at build time. Blanks also leave the entry
# structurally unlike every sibling, which is a trap for anything parsing it.

# The primary name MUST appear among its own aliases. Resolution happens to
# work without it through name derivation, but then the Vault does not record
# what the Spoke answers to.
if [[ -z "${ALIASES}" ]]; then
    ALIASES="${VM_NAME}"
else
    # Zsh-native membership test; prepend when absent so the primary name leads.
    typeset -a _alias_list
    _alias_list=( ${(s:,:)ALIASES} )
    if [[ -z "${_alias_list[(r)${VM_NAME}]}" ]]; then
        ALIASES="${VM_NAME},${ALIASES}"
    fi
fi

# An alias must be unique across the Vault. Nothing validated this before, and
# a duplicate makes the two resolvers disagree for the same input:
# VM_ALIAS_MAP is built last-write-wins over file order, while resolve_vm_name
# checks the vde- prefix ahead of the alias table.
typeset _claimed
for _claimed in ${(s:,:)ALIASES}; do
    if awk -F'|' -v want="${_claimed}" '
        /^(lang|service)\|/ {
            n = split($3, a, ",")
            for (i = 1; i <= n; i++) if (a[i] == want) { print $2; exit }
        }' "${VM_TYPES_CONF}" | grep -q .; then
        log_error "Alias '${_claimed}' is already claimed by $(awk -F'|' -v want="${_claimed}" '/^(lang|service)\|/ { n = split($3, a, ","); for (i = 1; i <= n; i++) if (a[i] == want) { print $2; exit } }' "${VM_TYPES_CONF}")"
        log_error "Aliases must be unique, or resolution becomes ambiguous."
        exit ${VDE_ERR_EXISTS}
    fi
done

[[ -n "${PKGS}" ]] || PKGS="-"
[[ -n "${SVC_PORT}" ]] || SVC_PORT="-"

# -----------------------
# Port Range Authority (Signet #534)
# -----------------------
# ONE mapping from type to bounds, read from data/vm-types.schema.json, which
# is the authority on what the registry may contain (Mandate B, Mandate J).
#
# Validation and allocation use DIFFERENT windows on purpose:
#   - validation accepts anything the schema accepts, so an explicit
#     --ssh-port is never refused for a value the Vault would happily hold.
#   - allocation draws from the narrower VDE_*_PORT_START/END window, which is
#     the range the Forge conventionally hands out.
# Validating against the allocator's window would reject working registrations
# (language ports 2300-2399 are schema-valid) while claiming the schema
# rejected them, which is both a regression and a false error message.
_vde_schema_port_bounds() {
    local kind="${1}"
    local defn="languageVM"
    [[ "${kind}" == "service" ]] && defn="serviceVM"

    local lo hi
    lo=$(vde_query_json -r ".definitions.${defn}.properties.ssh_port.minimum" "${VDE_ROOT_DIR}/data/vm-types.schema.json" 2>/dev/null)
    hi=$(vde_query_json -r ".definitions.${defn}.properties.ssh_port.maximum" "${VDE_ROOT_DIR}/data/vm-types.schema.json" 2>/dev/null)

    [[ "${lo}" == <-> && "${hi}" == <-> ]] || return 1
    print -r -- "${lo} ${hi}"
}

_vde_alloc_port_bounds() {
    local kind="${1}"
    if [[ "${kind}" == "service" ]]; then
        print -r -- "${VDE_SVC_PORT_START} ${VDE_SVC_PORT_END}"
    else
        print -r -- "${VDE_LANG_PORT_START} ${VDE_LANG_PORT_END}"
    fi
}

# The type must be one the schema actually defines. Without this, --type foo
# writes a row no definition covers, which the schema rejects and which the
# alias scan's /^(lang|service)\|/ filter cannot even see.
if [[ "${VM_TYPE_STR}" != "lang" && "${VM_TYPE_STR}" != "service" ]]; then
    log_error "Unknown VM type '${VM_TYPE_STR}'. Only 'lang' and 'service' are defined by data/vm-types.schema.json."
    exit ${VDE_ERR_INVALID_INPUT}
fi

if [[ -n "${SSH_PORT}" ]]; then
    typeset _schema_bounds
    if ! _schema_bounds=$(_vde_schema_port_bounds "${VM_TYPE_STR}"); then
        log_error "Could not read ssh_port bounds for ${VM_TYPE_STR} from data/vm-types.schema.json."
        exit ${VDE_ERR_INVALID_DATA}
    fi
    typeset -i _want_lo=${${=_schema_bounds}[1]}
    typeset -i _want_hi=${${=_schema_bounds}[2]}

    if (( SSH_PORT < _want_lo || SSH_PORT > _want_hi )); then
        log_error "SSH port ${SSH_PORT} is outside the ${VM_TYPE_STR} range ${_want_lo}-${_want_hi} defined by data/vm-types.schema.json."
        log_error "Registering it would leave the registry schema-invalid, and uninstall validates on load, so the entry could not be removed."
        exit ${VDE_ERR_INVALID_INPUT}
    fi
fi

# -----------------------
# Atomic Registry Update
# -----------------------
typeset backup_file="${VM_TYPES_CONF}.bak"
cp "${VM_TYPES_CONF}" "${backup_file}"

log_info "Updating Pure Beskar registry..."
typeset global_lock="${VDE_LOCKS_DIR}/global-config.lock"

# The Seeker's Staggered Entry (Rule 10 Enhancement)
claim_lock "${global_lock}" || vde_handle_error "lock-acquisition" "${global_lock}"

{
    # AUTO-ALLOCATE PORT (Inside Lock)
    if [[ -z "${SSH_PORT}" ]]; then
        log_info "No SSH port specified, auto-allocating inside lock..."
        # Allocate from the range matching the TYPE (Signet #534), via the
        # single mapping defined above. Hard-coding the language range meant a
        # service type received a 22xx port, which the schema rejects, leaving
        # a Vault that uninstall refused to load -- so the canonical tool
        # created state the canonical tool could not remove.
        typeset _alloc_bounds
        _alloc_bounds=$(_vde_alloc_port_bounds "${VM_TYPE_STR}")
        SSH_PORT=$(find_available_ssh_port "${${=_alloc_bounds}[1]}" "${${=_alloc_bounds}[2]}" "${QUIET}")
        vde_handle_error "port-allocation" "${VM_NAME}"
        log_success "Allocated port: ${SSH_PORT}"
    fi

    # TRIPLE-GATE VALIDATION (Inside Lock)
    # ----------------------------------
    # 1. Re-check VM existence
    if grep -q "|vde-${VM_NAME}|" "${VM_TYPES_CONF}"; then
        log_error "VM '${VM_NAME}' was already added by another process"
        exit ${VDE_ERR_EXISTS}
    fi

    # 2. Re-check Port availability
    if grep -q "|${SSH_PORT}$" "${VM_TYPES_CONF}" 2>/dev/null; then
        log_error "SSH port ${SSH_PORT} was claimed by another process"
        exit ${VDE_ERR_EXISTS}
    fi

    # 1. Atomic Update to Raw Beskar (.conf)
    # 8-FIELD STANDARD: type|name|aliases|display|pkgs|custom_cmd|service_ports|ssh_port
    local _entry="${VM_TYPE_STR}|vde-${VM_NAME}|${ALIASES}|${DISPLAY}|${PKGS}|zsh /vde/scripts/setup/${VM_NAME}-init.zsh|${SVC_PORT}|${SSH_PORT}"
    local _conf_tmp="${VM_TYPES_CONF}.tmp.${$}"

    # Insert INSIDE the entry's own type block, alphabetically by Spoke name
    # (Signet #534). Appending to the end of the file put language entries
    # after the service block, outside the section the header documents, so a
    # reader scanning "Language VMs" would not see them. Both loaders group on
    # field 1, so nothing broke -- the file simply stopped matching its own
    # documented layout.
    typeset -a _conf_body
    # "${(@f)...}" preserves empty elements. The unquoted form ${(f)"$(<f)"}
    # drops them, which silently deletes the blank lines that separate the
    # type blocks every time the registry is rewritten.
    _conf_body=( "${(@f)$(<${VM_TYPES_CONF})}" )

    typeset -i _insert_at=0 _idx
    typeset _row_name
    for (( _idx = 1; _idx <= ${#_conf_body}; _idx++ )); do
        [[ "${_conf_body[_idx]}" == "${VM_TYPE_STR}|"* ]] || continue
        _row_name="${${(s:|:)_conf_body[_idx]}[2]}"
        if [[ "${_row_name}" > "vde-${VM_NAME}" ]]; then
            _insert_at=${_idx}
            break
        fi
        _insert_at=$(( _idx + 1 ))
    done

    if (( _insert_at > 0 && _insert_at <= ${#_conf_body} )); then
        _conf_body[${_insert_at}]=( "${_entry}" "${_conf_body[${_insert_at}]}" )
        print -rl -- "${_conf_body[@]}" > "${_conf_tmp}"
    elif (( _insert_at > ${#_conf_body} )); then
        # Sorts after the final line: append, rather than splicing past the
        # end. Splicing an unset element expands it to "" and leaves a
        # spurious trailing blank line in the registry.
        _conf_body+=( "${_entry}" )
        print -rl -- "${_conf_body[@]}" > "${_conf_tmp}"
    else
        # No existing rows of this type: fall back to appending.
        cp "${VM_TYPES_CONF}" "${_conf_tmp}"
        print -r -- "${_entry}" >> "${_conf_tmp}"
    fi

    mv "${_conf_tmp}" "${VM_TYPES_CONF}"
    
    # 2. Re-smelt JSON from CONF (vde_translate_conf_to_json handles its own lock)
    vde_translate_conf_to_json "${VM_TYPES_CONF}" "${VM_TYPES_JSON}"
    vde_handle_error "re-smelt" "${VM_TYPES_JSON}"
    
    # 3. Commit Port to Registry (Numeric lock file)
    # Already done by find_available_ssh_port via mkdir, but we ensure persistence
    allocate_ssh_port "vde-${VM_NAME}" "${SSH_PORT}"
    
    # 4. Invalidate cache to force Ignition on next load
    rm -f "${VDE_ROOT_DIR}/.cache/vm-types.cache" 2>/dev/null
} always {
    release_lock "${global_lock}"
}

log_success "Registry updated and port committed."

# Create the hydration script if it doesn't exist
# A VM name is a Spoke name, not a shell identifier: "dynamic-vm" and
# "certified-ghost" are legal names but illegal variable names. Interpolating
# one into "typeset vde_${VM_NAME}_pkgs" produced a ritual that PARSES but
# fails at run time -- "typeset: not valid in this context" -- and because the
# ritual carries set -e it then exited 1 BEFORE the install command, so the
# Spoke hydrated nothing while the build reported success. The Proof of Life
# registers dynamic-vm on every run, so this was silently live.
typeset _pkgs_var="vde_${VM_NAME//[^A-Za-z0-9_]/_}_pkgs"
typeset _init_script="${VDE_ROOT_DIR}/scripts/setup/${VM_NAME}-init.zsh"
if [[ ! -f "${_init_script}" ]]; then
    log_info "Forging USP hydration script: ${_init_script}"
    mkdir -p "$(dirname "${_init_script}")"
    cat <<EOF > "${_init_script}"
#!/usr/bin/env zsh
# @armor (Engine Core)
# VDE USP Hydration Script: ${VM_NAME}
# ZSH-native shibboleth (Rule 1)
typeset _ZSH_PURE=\${(%):-%x}

# Part of the Universal Script Parity (USP) mandate.
# Forged in Beskar
set -e

# 1. THE PACKAGE ALLOY
export DEBIAN_FRONTEND=noninteractive
typeset ${_pkgs_var}=""

# 2. THE FORGE WORK
${INSTALL_CMD}

# 3. PURGING THE GHOSTS
apt-get clean
rm -rf /var/lib/apt/lists/*
EOF
    chmod +x "${_init_script}"
    log_success "Hydration script forged."
fi

# Update configs/ssh/config with the new entry
typeset project_ssh_config="${VDE_ROOT_DIR}/configs/ssh/config"
if [[ -f "${project_ssh_config}" ]]; then
    # The identity, the known-hosts file and VDE's own agent socket follow the VDE
    # directory and its overrides, exactly as render_ssh_entry derives them, and are
    # written in '~' form when they live under the home directory (no absolute path
    # leaks in the audit); an override elsewhere keeps its real path.
    typeset vde_dir="${VDE_SSH_DIR:-${HOME}/.ssh/vde}"
    typeset entry_identity="${VDE_SSH_IDENTITY:-${vde_dir}/vde_student}"
    typeset entry_known_hosts="${VDE_SSH_KNOWN_HOSTS:-${vde_dir}/known_hosts}"
    typeset entry_agent_sock="${VDE_SSH_AGENT_SOCK:-${vde_dir}/agent.sock}"
    [[ "${entry_identity}" == "${HOME}/"* ]] && entry_identity="~/${entry_identity#${HOME}/}"
    [[ "${entry_known_hosts}" == "${HOME}/"* ]] && entry_known_hosts="~/${entry_known_hosts#${HOME}/}"
    [[ "${entry_agent_sock}" == "${HOME}/"* ]] && entry_agent_sock="~/${entry_agent_sock#${HOME}/}"

    cat >> "${project_ssh_config}" <<SSHEOF


Host vde-${VM_NAME}
    HostName localhost
    Port ${SSH_PORT}
    User devuser
    IdentityFile ${entry_identity}
    StrictHostKeyChecking no
    UserKnownHostsFile ${entry_known_hosts}
    ForwardAgent yes
    IdentityAgent ${entry_agent_sock}
    IdentitiesOnly yes
    LogLevel ERROR
SSHEOF
    log_success "Entry added to configs/ssh/config"
fi

# Sync to live SSH config
if [[ -f "${VDE_SSH_CONFIG}" ]]; then
    cp "${project_ssh_config}" "${VDE_SSH_CONFIG}"
    log_success "Synced to ${VDE_SSH_CONFIG}"
fi

# -----------------------
# Show diff
# -----------------------
if [[ "${QUIET}" == "false" ]]; then
    log_info "Showing diff..."
    echo ""
    diff "${backup_file}" "${VM_TYPES_CONF}" || true
    echo ""

    # -----------------------
    # THE IGNITION RITUAL (Rule H)
    # -----------------------
    log_info "Triggering the Ignition Ritual..."
    "${VDE_ROOT_DIR}/bin/vde" rebuild-cache

fi

# -----------------------
# Regenerate Configs (Signet #534)
# -----------------------
# Runs regardless of --quiet. generate-all-configs is what writes
# configs/ssh/config.spoke and the configs/docker/<category>/<name>/ manifest;
# the surgical append above only touches configs/ssh/config, so gating this on
# --quiet produced a half-configured Spoke. Note that bin/vde consumes -q
# BEFORE dispatch (bin/vde:79 sets VDE_QUIET and does not forward the flag),
# so QUIET is always false via the canonical entrypoint; this matters only for
# direct invocation of bin/add-vm-type.
#
# Guarded, not bare: errexit is live here, and generate-all-configs returns
# non-zero on a render failure. Unguarded, a regen failure would abort AFTER
# the registry row, JSON re-smelt, port record and hydration ritual were all
# written -- leaving the caller a non-zero status with no summary and the work
# actually committed. bin/uninstall-vm-type guards the identical call the same
# way, which is what makes the pair symmetric.
log_info "Regenerating VDE configurations..."
if "${VDE_ROOT_DIR}/bin/generate-all-configs" >/dev/null 2>&1; then
    # Keep the live SSH config in step with the regenerated project config.
    if [[ -f "${project_ssh_config}" && -f "${VDE_SSH_CONFIG}" ]]; then
        cp "${project_ssh_config}" "${VDE_SSH_CONFIG}"
    fi
else
    log_error "Configuration regeneration failed after the registry was committed."
    log_error "The entry for '${VM_NAME}' exists; run 'bin/generate-all-configs' to finish, or 'vde uninstall ${VM_NAME}' to back it out."
fi

log_success "VM type '${VM_NAME}' added successfully!"
vde_print_next_steps "add" "${VM_NAME}"
