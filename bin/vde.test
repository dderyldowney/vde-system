#!/usr/bin/env zsh
#===============================================================================
# vde.test - BDD Test Runner for VDE
# Wraps 'behave' and ensures the environment is correctly set up.
#
# Usage: ./bin/vde.test [behave arguments]
#===============================================================================

# Determine VDE root directory
if [[ -z "${VDE_ROOT_DIR}" ]]; then
    VDE_ROOT_DIR="${0:a:h:h}"
fi
export VDE_ROOT_DIR

# Ensure VDE CLI is in the PATH for the tests
export PATH="${VDE_ROOT_DIR}/bin:${PATH}"

# Check if behave is installed
if ! command -v behave >/dev/null 2>&1; then
    echo "[ERROR] 'behave' not found. Please install it with: pip install behave"
    exit 1
fi

# Run behave with provided arguments
# Default to all features if no arguments provided
if [[ ${#} -eq 0 ]]; then
    exec behave "${VDE_ROOT_DIR}/tests/features"
else
    exec behave "${@}"
fi
