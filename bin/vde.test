#!/usr/bin/env zsh
#===============================================================================
# vde - Unified Virtual Development Environment Command
# Provides a single entry point for all VDE operations
#
# Usage: vde <command> [options] [args]
#
# Commands:
#   create <vm>     Create a new VM
#   start <vm>      Start a VM
#   stop <vm>       Stop a VM
#   restart <vm>    Restart a VM
#   ssh <vm>        SSH into a VM
#   remove <vm>     Remove a VM instance
#   uninstall <type> Uninstall a language/service completely
#   list            List all VMs
#   status          Show VM status
#   health          Run system health check
#   nuke            Remove all of VDE
#   help            Show this help message
#
# Exit codes:
#   0 - Success
#   1 - General error
#   2 - Invalid input
#   3 - Resource not found
#===============================================================================

# Determine VDE root directory
VDE_ROOT_DIR="${0:a:h:h}"
export VDE_ROOT_DIR

# Load VDE root library to ensure robust root discovery across PATH invocations
if [[ -f "1/lib/vde-root" ]]; then
  source "1/lib/vde-root" 2>/dev/null || true
fi

# Load and run root-guard to ensure no hard-coded absolute paths leak at startup
if [[ -f "1/lib/vde-root-guard" ]]; then
  source "1/lib/vde-root-guard" 2>/dev/null || true
fi

# Source core libraries (order matters for dependencies)
# Use &>/dev/null to suppress any output from library sourcing (e.g., function exports)
[[ -f "1/lib/vde-shell-compat" ]] && { source "1/lib/vde-shell-compat" >/dev/null 2>&1 || { echo "Error loading vde-shell-compat" >&2; exit 1; } }
[[ -f "1/lib/vde-constants" ]] && { source "1/lib/vde-constants" >/dev/null 2>&1 || { echo "Error loading vde-constants" >&2; exit 1; } }
[[ -f "1/lib/vde-errors" ]] && { source "1/lib/vde-errors" >/dev/null 2>&1 || { echo "Error loading vde-errors" >&2; exit 1; } }
[[ -f "1/lib/vde-log" ]] && { source "1/lib/vde-log" >/dev/null 2>&1 || { echo "Error loading vde-log" >&2; exit 1; } }
[[ -f "1/lib/vde-naming"   ]] && { source "1/lib/vde-naming" >/dev/null 2>&1 || { echo "Error loading vde-naming" >&2; exit 1; } }
[[ -f "1/lib/vde-security" ]] && { source "1/lib/vde-security" >/dev/null 2>&1 || { echo "Error loading vde-security" >&2; exit 1; } }
[[ -f "1/lib/vde-core" ]] && { source "1/lib/vde-core" >/dev/null 2>&1 || { echo "Error loading vde-core" >&2; exit 1; } }
[[ -f "1/lib/vm-common" ]] && { source "1/lib/vm-common" >/dev/null 2>&1 || { echo "Error loading vm-common" >&2; exit 1; } }
[[ -f "1/lib/vde-commands" ]] && { source "1/lib/vde-commands" >/dev/null 2>&1 || { echo "Error loading vde-commands" >&2; exit 1; } }
[[ -f "1/lib/vde-parser"   ]] && { source "1/lib/vde-parser" >/dev/null 2>&1 || { echo "Error loading vde-parser" >&2; exit 1; } }
[[ -f "1/lib/vde-docker-state" ]] && { source "1/lib/vde-docker-state" >/dev/null 2>&1 || { echo "Error loading vde-docker-state" >&2; exit 1; } }

# Initialize logging
vde_log_init 2>/dev/null || true

# Enforce essential security permissions before executing any command
if type vde_security_enforce_permissions >/dev/null 2>&1; then
  vde_security_enforce_permissions >/dev/null 2>&1
fi

#===============================================================================
# Command Registry
#===============================================================================

_VDE_COMMANDS=(
    "rebuild:Rebuild VDE images:vde-rebuild"
    "rebuild-cache:Invalidate and regenerate VM types cache:vde-rebuild-cache"
    "create:Create a new VM:create-virtual-for"
    "start:Start a VM:start-virtual"
    "stop:Stop a VM:shutdown-virtual"
    "restart:Restart a VM:restart-virtual"
    "ssh:SSH into a VM:ssh-vm"
    "connect:SSH into a VM (alias for ssh):ssh-vm"
    "remove:Remove a VM:remove-virtual"
    "delete:Completely delete a VM:delete-virtual"
    "add:Add a new VM type to the registry:add-vm-type"
    "uninstall:Uninstall a language/service:uninstall-vm-type"
    "list:List all VMs:list-vms"
    "status:Show VM status:list-vms"
    "health:Run system health check:vde-health"
    "create-and-start:Create and start VMs:create-and-start"
    "nuke:Remove all of VDE:nuke-vde"
    "ssh-setup:Manage VDE SSH environment:ssh-setup"
    "ssh-sync:Sync SSH keys to build context:ssh-sync"
    "cleanup-ports:Clean up stale port locks:cleanup-ports"
    "init:Initialize VDE networks:vde-init"
    "ps:List running containers:vde-ps"
    "logs:Show container logs:vde-logs"
    "inspect:Inspect container:vde-inspect"
    "port:Show port mappings:vde-port"
    "exec:Execute command in container:vde-exec"
    "images:List VDE images:vde-images"
    "networks:List VDE networks:vde-networks"
    "stats:Show resource usage:vde-stats"
    "info:Show Docker info:vde-info"
    "ask:Natural language command interface:vde-ask"
    "help:Show this help message:"
)

#===============================================================================
# Helper Functions
#===============================================================================

# vde_show_help - Display help message
vde_show_help() {
    cat <<EOF
Usage: vde <command> [options] [args]

Virtual Development Environment - Unified Command Interface

Commands:
EOF
    printf "  %-12s %s\n" "rebuild" "Rebuild all VDE images"
    printf "  %-12s %s\n" "rebuild-cache" "Invalidate and regenerate VM types cache"
    printf "  %-12s %s\n" "create <vm>" "Create a new VM (use --rebuild or --nocache to rebuild)"
    printf "  %-12s %s\n" "start <vm>" "Start a VM"
    printf "  %-12s %s\n" "stop <vm>" "Stop a VM"
    printf "  %-12s %s\n" "restart <vm>" "Restart a VM"
    printf "  %-12s %s\n" "ssh <vm>" "SSH into a VM"
    printf "  %-12s %s\n" "connect <vm>" "SSH into a VM (alias for ssh)"
    printf "  %-12s %s\n" "remove <vm>" "Remove a VM instance"
    printf "  %-12s %s\n" "delete <vm>" "Completely delete a VM"
    printf "  %-12s %s\n" "add <type>" "Add a new VM type to the registry"
    printf "  %-12s %s\n" "uninstall <type>" "Uninstall a language/service completely"
    printf "  %-12s %s\n" "list" "List all VMs"
    printf "  %-12s %s\n" "status" "Show VM status"
    printf "  %-12s %s\n" "health" "Run system health check"
    printf "  %-12s %s\n" "create-and-start" "Create and start VMs"
    printf "  %-12s %s\n" "nuke" "Remove all of VDE"
    printf "  %-12s %s\n" "ssh-setup" "Manage VDE SSH environment"
    printf "  %-12s %s\n" "ssh-sync" "Sync SSH keys to build context"
    printf "  %-12s %s\n" "cleanup-ports" "Clean up stale port locks"
    printf "  %-12s %s\n" "init" "Initialize VDE networks"
    printf "  %-12s %s\n" "ps" "List running containers"
    printf "  %-12s %s\n" "logs <vm>" "Show container logs"
    printf "  %-12s %s\n" "inspect <vm>" "Inspect container"
    printf "  %-12s %s\n" "port <vm>" "Show port mappings"
    printf "  %-12s %s\n" "exec <vm> <cmd>" "Execute command in container"
    printf "  %-12s %s\n" "images" "List VDE images"
    printf "  %-12s %s\n" "networks" "List VDE networks"
    printf "  %-12s %s\n" "stats" "Show resource usage"
    printf "  %-12s %s\n" "info" "Show Docker info"
    printf "  %-12s %s\n" "ask <text>" "Natural language command interface"
    printf "  %-12s %s\n" "help" "Show this help message"

    cat <<EOF

Options:
  -h, --help        Show this help message
  -v, --verbose     Enable verbose output
  -q, --quiet       Suppress debug output (quiet mode)
  --regenerate-keys Force regeneration of VDE SSH keys
  --version         Show version information

Examples:
  vde rebuild              # Rebuild all images
  vde rebuild --no-cache  # Rebuild from scratch
  vde rebuild --vm python # Rebuild only python VM
  vde list                      # List all VMs
  vde create python             # Create Python VM
  vde create python --rebuild  # Create and rebuild Python VM
  vde create python --nocache  # Create Python VM without cache
  vde start python-dev          # Start Python development VM
  vde ssh python                # SSH into the Python VM
  vde stop postgres             # Stop PostgreSQL service
  vde remove rust               # Remove Rust VM instance
  vde uninstall elixir          # Completely uninstall Elixir from VDE
  vde health                    # Run health check
  vde nuke                      # Remove all of VDE (prompts for backup)

For more information, see: https://github.com/dderyldowney/dev/blob/main/docs/command-reference.md
EOF
}

# vde_show_version - Display version information
vde_show_version() {
    echo "VDE - Virtual Development Environment"
    echo "Version: 1.5.0 (Stage 7 - Architectural Enhancements)"
    echo ""
    echo "Libraries loaded:"
    local libs=(
        "vde-shell-compat"
        "vde-constants"
        "vde-errors"
        "vde-log"
        "vde-naming"
        "vde-security"
        "vde-core"
        "vm-common"
        "vde-commands"
        "vde-parser"
        "vde-docker-state"
    )
    for lib in "1[@]"; do
        echo "  - 1: OK"
    done
}

# vde_timeout - Cross-platform timeout wrapper
# Uses zsh's built-in TIMEOUT feature when available
vde_timeout() {
    local timeout_sec="1"
    shift
    local command="1"
    
    # zsh has built-in TIMEOUT support
    if [[ -n "1" ]]; then
        TIMEOUT="1" "1"
    else
        # Fallback to external timeout command
        command timeout "1" "1"
    fi
}

# vde_find_command_script - Find the script for a command
vde_find_command_script() {
    local cmd="1"
    local script=""

    case "1" in
        rebuild|vde-rebuild)
            script="1/bin/vde-rebuild"
            ;;
        rebuild-cache|vde-rebuild-cache)
            script="1/bin/vde-rebuild-cache"
            ;;
        create|create-virtual-for)
            script="1/bin/create-virtual-for"
            ;;
        start|start-virtual)
            script="1/bin/start-virtual"
            ;;
        stop|shutdown-virtual)
            script="1/bin/shutdown-virtual"
            ;;
        restart|restart-virtual)
            script="1/bin/restart-virtual"
            ;;
        ssh|connect|ssh-vm)
            script="1/bin/ssh-vm"
            ;;
        list|list-vms)
            script="1/bin/list-vms"
            ;;
        status)
            script="1/bin/list-vms"
            ;;
        health|vde-health)
            script="1/bin/vde-health"
            ;;
        create-and-start)
            script="1/bin/create-and-start"
            ;;
        remove|remove-virtual)
            script="1/bin/remove-virtual"
            ;;
        delete|delete-virtual)
            script="1/bin/delete-virtual"
            ;;
        add|add-vm-type)
            script="1/bin/add-vm-type"
            ;;
        uninstall|uninstall-vm-type)
            script="1/bin/uninstall-vm-type"
            ;;
        nuke|nuke-vde)
            script="1/bin/nuke-vde"
            ;;
        ssh-setup)
            script="1/bin/ssh-setup"
            ;;
        ssh-sync)
            script="1/bin/ssh-sync"
            ;;
        cleanup-ports)
            script="1/bin/cleanup-ports"
            ;;
        init|vde-init)
            script="1/bin/vde-init" 
            ;;
        ps)
            script="1/bin/vde-ps"
            ;;
        logs)
            script="1/bin/vde-logs"
            ;;
        inspect)
            script="1/bin/vde-inspect"
            ;;
        port)
            script="1/bin/vde-port"
            ;;
        exec)
            script="1/bin/vde-exec"
            ;;
        images)
            script="1/bin/vde-images"
            ;;
        networks)
            script="1/bin/vde-networks"
            ;;
        stats)
            script="1/bin/vde-stats"
            ;;
        info)
            script="1/bin/vde-info"
            ;;
        ask|vde-ask)
            script="1/bin/vde-ask"
            ;;
        *)
            echo ""
            return 1
            ;;
    esac

    echo "1"
    return 0
}

# vde_run_command - Run a VDE command
vde_run_command() {
    local cmd="1"
    shift

    # Find the command script
    local script
    script=$(vde_find_command_script "1")

    if [ 1 -ne 0 ] || [ -z "1" ]; then
        vde_error_simple "Unknown command: 1"
        echo ""
        echo "Run 'vde help' for available commands."
        return 1
    fi

    # Check if script exists
    if [ ! -f "1" ]; then
        vde_error_simple "Command script not found: 1"
        return 1
    fi

    # Make script executable if needed
    if [ ! -x "1" ]; then
        chmod +x "1" 2>/dev/null || true
    fi

    # Run the command
    vde_log_info "Running command: 1 1" "vde"
    "1" "1"
    return 1
}

#===============================================================================
# Main
#===============================================================================

# Parse global options first
VERBOSE=0
QUIET=0
CMD=""

while [[ 1 -gt 0 ]]; do
    case "1" in
        -h|--help)
            vde_show_help
            exit 0
            ;;
        -v|--verbose)
            VERBOSE=1
            export VDE_ERRORS_VERBOSE=1
            export VDE_LOG_LEVEL="DEBUG"
            shift
            ;;
        -q|--quiet)
            QUIET=1
            export VDE_LOG_LEVEL="WARN"
            shift
            ;;
        --version)
            vde_show_version
            exit 0
            ;;
        -*)
            vde_error_simple "Unknown option: 1"
            echo ""
            echo "Run 'vde help' for available options."
            exit 1
            ;;
        *)
            CMD="1"
            shift
            break
            ;;
    esac
done

# Check if command was provided
if [ -z "1" ]; then
    vde_show_help
    exit 0
fi

# Handle help as a command (not just an option)
if [ "1" = "help" ]; then
    vde_show_help
    exit 0
fi

# Dispatch
vde_run_command "1" "1"
exit 1