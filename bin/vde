#!/usr/bin/env zsh
#===============================================================================
# VDE CLI - Unified Virtual Development Environment
# Version: ${VDE_VERSION:-$(vde_get_version)}
#===============================================================================

# Source libraries
VDE_ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# Enforce Universal Agent Protocol (The Rule Spine)
"${VDE_ROOT_DIR}/bin/vde-enforce-uap.zsh" --quiet || exit 1

# Enforce @system-spine tetrad (Section 16)
# This is the cognitive context and operational spine
if [[ "${VDE_SKIP_SPINE_CHECK}" != "1" ]]; then
    "${VDE_ROOT_DIR}/bin/vde-spine-check.zsh" --quiet || exit 1
fi

source "${VDE_ROOT_DIR}/lib/vm-common"
source "${VDE_ROOT_DIR}/lib/vde-core"
source "${VDE_ROOT_DIR}/lib/vm-lock"
source "${VDE_ROOT_DIR}/lib/vde-progress"
source "${VDE_ROOT_DIR}/lib/vde-naming"
source "${VDE_ROOT_DIR}/lib/vde-docker"
source "${VDE_ROOT_DIR}/lib/vde-templates"
source "${VDE_ROOT_DIR}/lib/vde-ssh"
source "${VDE_ROOT_DIR}/lib/vde-security"

# Phase 26: Signal Translation Trap
trap 'echo ""; vde_error_map 130 "Interrupted"; exit 130' SIGINT

# Initial security check
vde_security_init

# Main command router
COMMAND=$1
case ${COMMAND} in
    init)
        shift
        vde_run "init" "${VDE_ROOT_DIR}/bin/vde-init" "$@"
        ;;
    rebuild)
        shift
        vde_run "rebuild" "${VDE_ROOT_DIR}/bin/vde-rebuild" "$@"
        ;;
    create)
        shift
        # Map create to vde-rebuild
        vde_run "create" "${VDE_ROOT_DIR}/bin/vde-rebuild" "$@"
        ;;
    start)
        vde_ensure_disk_space "${VDE_DISK_THRESHOLD:-95}" || exit $?
        shift
        local targets=("${@}")
        [[ -z "${targets}" ]] && vde_log_error "Usage: vde start <alias...>" && exit 1
        
        # 1. System Breath Check (Dynamic Scaling/Throttling)
        local max_vms
        max_vms=$(vde_check_system_breath)
        local breath_rc=$?
        max_vms="${max_vms:-3}" # Safe default
        
        if [[ ${breath_rc} -ne 0 ]] && [[ "${max_vms}" == "0" ]]; then
            vde_log_error "Ignition aborted due to system resource constraints." "system"
            exit ${breath_rc}
        fi

        # 2. Check current combat load
        local running_count
        running_count=$(docker_get_running | wc -w | tr -d ' ')
        if (( running_count >= max_vms )); then
            vde_log_error "Rule K Violation: Combat Load exceeded (${running_count}/${max_vms} VMs running). Quench a Spoke before igniting a new one." "system"
            exit 1
        fi

        local GLOBAL_RC=0
        for target_type in "${targets[@]}"; do
            CANONICAL_NAME=$(resolve_vm_name "${target_type}" 2>/dev/null)
            if [[ -z "${CANONICAL_NAME}" ]]; then
                vde_error_alias_not_found "${target_type}"
                continue
            fi
            BASE_NAME="${CANONICAL_NAME#vde-}"

            local vm_lock="${VDE_VM_LOCKS_DIR}/${BASE_NAME}.lock"
            claim_lock "${vm_lock}" || { vde_error_map ${VDE_ERR_LOCK:-9} "${CANONICAL_NAME}"; continue; }
            {
                # Conflict Prevention (Atomic Handshake)
                if docker ps -a --format '{{.Names}}' | grep -q "^${CANONICAL_NAME}$"; then
                    vde_log_info "Removing existing ${CANONICAL_NAME}..." "docker"
                    vde_run "${CANONICAL_NAME}" docker rm -f "${CANONICAL_NAME}" >/dev/null 2>&1
                fi

                if is_vm_running "${CANONICAL_NAME}"; then
                    vde_log_info "${CANONICAL_NAME} is already running."
                    continue
                fi

                # Ignition Logic
                vde_log_info "Igniting ${CANONICAL_NAME}..." "docker"
                
                # Fetch Docker-specific config from registry/templates
                local ssh_port svc_port_str net_name
                ssh_port=$(get_vm_ssh_port "${CANONICAL_NAME}")
                svc_port_str=$(get_vm_service_ports "${CANONICAL_NAME}")
                net_name="${VDE_DOCKER_NETWORK:-vde-net}"
                
                # Convert comma-separated ports to docker -p flags
                local -a port_args
                port_args=("-p" "${ssh_port}:${ssh_port}")
                local -a svc_ports
                local IFS=','
                svc_ports=(${(s:,:)svc_port_str})
                for p in "${svc_ports[@]}"; do
                    [[ -n "${p}" ]] && port_args+=("-p" "${p}:${p}")
                done

                # Resolve mounts
                local mount_str
                mount_str=$(get_vm_mounts "${CANONICAL_NAME}")
                local -a mount_args
                mount_args=()
                local IFS='|'
                for m in ${(s:|:)mount_str}; do
                    local src="${m%%:*}"
                    local dst="${m#*:}"
                    # Resolve relative source paths against project root
                    [[ "${src}" != /* ]] && src="${VDE_ROOT_DIR}/${src}"
                    mount_args+=("-v" "${src}:${dst}")
                done

                # Pre-ignition check: image must exist
                if ! image_exists "${CANONICAL_NAME}"; then
                    vde_log_warn "Image for ${CANONICAL_NAME} not found. Attempting to rebuild..." "docker"
                    vde_run "${CANONICAL_NAME}" "${VDE_ROOT_DIR}/bin/vde-rebuild" "${target_type}" || continue
                fi

                # Ignition Phase (The Handshake)
                # We prioritize the LIVE host SSH agent socket bridge via unified discovery
                local host_ssh_auth_sock
                host_ssh_auth_sock=$(vde_get_host_ssh_sock)

                # Physical Handshake Verification (Section 10.3)
                if [[ ! -S "${host_ssh_auth_sock}" ]]; then
                    vde_log_error "SSH Bridge Blockade: Host socket not found or invalid." "ssh"
                    vde_log_error "Attempted Path: ${host_ssh_auth_sock:-[EMPTY]}" "ssh"
                    vde_log_error "Check your SSH agent: echo \$SSH_AUTH_SOCK" "ssh"
                    GLOBAL_RC=1
                    continue
                fi

                # EXPORT for Docker Compose consumption (Sovereign Bridge)
                export VDE_HOST_SSH_AUTH_SOCK="${host_ssh_auth_sock}"

                vde_progress_spinner_start "Igniting ${CANONICAL_NAME} (SSH: ${ssh_port})"
                
                local compose_file
                compose_file=$(get_vm_compose_file "${CANONICAL_NAME}")

                if vde_run "${CANONICAL_NAME}" docker compose -f "${compose_file}" up -d >/dev/null 2>&1; then
                    vde_progress_spinner_stop "${CANONICAL_NAME} ignited"
                else
                    vde_progress_spinner_stop "" "Failed to ignite ${CANONICAL_NAME}" 1
                    GLOBAL_RC=1
                fi
            } always {
                release_lock "${vm_lock}"
            }
        done
        exit ${GLOBAL_RC}
        ;;

    stop)
        shift
        local targets=("${@}")
        local force=false
        # Filter out flags
        local vms=()
        for t in "${targets[@]}"; do
            [[ "${t}" == "-f" || "${t}" == "--force" ]] && force=true && continue
            vms+=("${t}")
        done

        if [[ "${vms}" == "all" ]]; then
            vms=($(get_all_vms))
        fi

        [[ -z "${vms}" ]] && vde_log_error "Usage: vde stop [-f] <alias...|all>" && exit 1

        for vm_alias in "${vms[@]}"; do
            CANONICAL_NAME=$(resolve_vm_name "${vm_alias}" 2>/dev/null)
            if [[ -z "${CANONICAL_NAME}" ]]; then
                vde_log_warn "Unknown VM: ${vm_alias}"
                continue
            fi

            if docker ps -a --format '{{.Names}}' | grep -q "^${CANONICAL_NAME}$"; then
                vde_progress_spinner_start "Stopping ${CANONICAL_NAME}"
                if vde_run "${CANONICAL_NAME}" docker stop "${CANONICAL_NAME}" >/dev/null 2>&1; then
                    vde_progress_spinner_stop "${CANONICAL_NAME} stopped"
                else
                    vde_progress_spinner_stop "" "Failed to stop ${CANONICAL_NAME}" 1
                fi
            else
                vde_log_info "${CANONICAL_NAME} is not running." "vde"
            fi
        done
        ;;
    restart)
        shift
        local targets=("${@}")
        [[ -z "${targets}" ]] && vde_log_error "Usage: vde restart <alias...|all>" && exit 1
        
        if [[ "${targets}" == "all" ]]; then
            targets=($(get_all_vms))
        fi

        for vm_alias in "${targets[@]}"; do
            CANONICAL_NAME=$(resolve_vm_name "${vm_alias}" 2>/dev/null)
            if [[ -z "${CANONICAL_NAME}" ]]; then
                vde_log_warn "Unknown VM: ${vm_alias}"
                continue
            fi

            vde_progress_spinner_start "Restarting ${CANONICAL_NAME}"
            # Stop if running
            if docker ps -a --format '{{.Names}}' | grep -q "^${CANONICAL_NAME}$"; then
                vde_run "${CANONICAL_NAME}" docker stop "${CANONICAL_NAME}" >/dev/null 2>&1
            fi
            # Start (reuse start logic via recursive call or internal function)
            if ./bin/vde start "${CANONICAL_NAME}" >/dev/null 2>&1; then
                vde_progress_spinner_stop "${CANONICAL_NAME} restarted"
            else
                vde_progress_spinner_stop "" "Failed to restart ${CANONICAL_NAME}" 1
            fi
        done
        ;;
    remove|delete|rm)
        shift
        local targets=("${@}")
        [[ -z "${targets}" ]] && vde_log_error "Usage: vde remove <alias...|all>" && exit 1

        if [[ "${targets}" == "all" ]]; then
            targets=($(get_all_vms))
        fi

        for vm_alias in "${targets[@]}"; do
            CANONICAL_NAME=$(resolve_vm_name "${vm_alias}" 2>/dev/null)
            if [[ -z "${CANONICAL_NAME}" ]]; then
                vde_log_warn "Unknown VM: ${vm_alias}"
                continue
            fi

            if docker ps -a --format '{{.Names}}' | grep -q "^${CANONICAL_NAME}$"; then
                vde_progress_spinner_start "Removing container ${CANONICAL_NAME}"
                if vde_run "${CANONICAL_NAME}" docker rm -f "${CANONICAL_NAME}" >/dev/null 2>&1; then
                    vde_progress_spinner_stop "${CANONICAL_NAME} removed"
                else
                    vde_progress_spinner_stop "" "Failed to remove ${CANONICAL_NAME}" 1
                fi
            else
                vde_log_info "No container found for ${CANONICAL_NAME}." "vde"
            fi
        done
        ;;
    nuke)
        shift
        vde_run "nuke" "${VDE_ROOT_DIR}/bin/nuke-vde" "$@"
        ;;
    exec)
        shift
        vde_run "exec" "${VDE_ROOT_DIR}/bin/vde-exec" "$@"
        ;;
    enter|ssh)
        shift
        vde_run "enter" "${VDE_ROOT_DIR}/bin/ssh-vm" "$@"
        ;;
    list)
        shift
        vde_run "list" "${VDE_ROOT_DIR}/bin/list-vms" "$@"
        ;;
    add)
        shift
        vde_run "add" "${VDE_ROOT_DIR}/bin/add-vm-type" "$@"
        ;;
    uninstall)
        shift
        vde_run "uninstall" "${VDE_ROOT_DIR}/bin/uninstall-vm-type" "$@"
        ;;
    validate)
        shift
        vde_run "validate" "${VDE_ROOT_DIR}/bin/validate-schemas.zsh" "$@"
        ;;
    prune)
        shift
        vde_run "prune" "${VDE_ROOT_DIR}/bin/vde-prune.zsh" "$@"
        ;;
    rebuild-cache)
        shift
        vde_run "rebuild-cache" "${VDE_ROOT_DIR}/bin/vde-rebuild-cache" "$@"
        ;;
    sync-version)
        shift
        vde_run "sync-version" "${VDE_ROOT_DIR}/bin/vde-sync-version" "$@"
        ;;
    port)
        local vm_alias=$2
        CANONICAL_NAME=$(resolve_vm_name "${vm_alias}" 2>/dev/null)
        vde_run "port" vde_query_json -r "(.vms.language[]?, .vms.service[]?) | select(.name == \"${CANONICAL_NAME}\") | .ssh_port // empty" "${TYPES_JSON}"
        exit $?
        ;;
    info)
        shift
        vde_run "info" "${VDE_ROOT_DIR}/bin/vde-info" "$@"
        ;;
    ps|status)
        shift
        vde_run "ps" "${VDE_ROOT_DIR}/bin/vde-ps" "$@"
        ;;
    inspect)
        shift
        vde_run "inspect" "${VDE_ROOT_DIR}/bin/vde-inspect" "$@"
        ;;
    logs)
        shift
        vde_run "logs" "${VDE_ROOT_DIR}/bin/vde-logs" "$@"
        ;;
    images)
        shift
        vde_run "images" "${VDE_ROOT_DIR}/bin/vde-images" "$@"
        ;;
    stats)
        shift
        vde_run "stats" "${VDE_ROOT_DIR}/bin/vde-stats" "$@"
        ;;
    health)
        shift
        vde_run "health" "${VDE_ROOT_DIR}/bin/vde-health" "$@"
        ;;
    cluster)
        shift
        vde_run "cluster" "${VDE_ROOT_DIR}/bin/vde-cluster" "$@"
        ;;
    networks)
        shift
        vde_run "networks" "${VDE_ROOT_DIR}/bin/vde-networks" "$@"
        ;;
    vision)
        shift
        vde_run "vision" "${VDE_ROOT_DIR}/bin/vde-vision" "$@"
        ;;
    help|*) echo "Usage: vde {init|rebuild|create|start|stop|restart|remove|nuke|exec|enter|ssh|list|add|uninstall|validate|rebuild-cache|sync-version|port|info|ps|status|inspect|logs|images|stats|health|cluster|networks|vision} [type/alias]" ;;
esac
