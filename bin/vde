#!/usr/bin/env zsh
#===============================================================================
# VDE CLI - Unified Virtual Development Environment
# Version: ${VDE_VERSION:-$(vde_get_version)}
#===============================================================================

# Source libraries
VDE_ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# Enforce Universal Agent Protocol (The Rule Spine)
"${VDE_ROOT_DIR}/bin/vde-enforce-uap.zsh" --quiet || exit 1

# Enforce @system-spine tetrad (Section 16)
# This is the cognitive context and operational spine
"${VDE_ROOT_DIR}/bin/vde-spine-check.zsh" --quiet || exit 1

source "${VDE_ROOT_DIR}/lib/vm-common"
source "${VDE_ROOT_DIR}/lib/vde-core"
source "${VDE_ROOT_DIR}/lib/vde-naming"
source "${VDE_ROOT_DIR}/lib/vde-docker"
source "${VDE_ROOT_DIR}/lib/vde-templates"
source "${VDE_ROOT_DIR}/lib/vde-ssh"
source "${VDE_ROOT_DIR}/lib/vde-security"

# Initial security check
vde_security_init

# Main command router
COMMAND=$1
case ${COMMAND} in
    rebuild)
        shift
        "${VDE_ROOT_DIR}/bin/vde-rebuild" "$@"
        ;;
    start)
        vde_ensure_disk_space "${VDE_DISK_THRESHOLD:-95}" || exit $?
        shift
        local targets=("${@}")
        [[ -z "${targets}" ]] && vde_log_error "Usage: vde start <alias...>" && exit 1
        
        local GLOBAL_RC=0
        for target_type in "${targets[@]}"; do
            CANONICAL_NAME=$(resolve_vm_name "${target_type}" 2>/dev/null)
            if [[ -z "${CANONICAL_NAME}" ]]; then
                vde_error_alias_not_found "${target_type}"
                continue
            fi
            BASE_NAME="${CANONICAL_NAME#vde-}"

            local vm_lock="${VDE_VM_LOCKS_DIR}/${BASE_NAME}.lock"
            claim_lock "${vm_lock}" 60 || { vde_error_map ${VDE_ERR_LOCK:-9} "${CANONICAL_NAME}"; continue; }
            {
                # Conflict Prevention (Atomic Handshake)
                if docker ps -a --format '{{.Names}}' | grep -q "^${CANONICAL_NAME}$"; then
                    vde_log_info "Removing existing ${CANONICAL_NAME}..." "docker"
                    docker rm -f "${CANONICAL_NAME}" >/dev/null 2>&1
                fi

                if is_vm_running "${CANONICAL_NAME}"; then
                    vde_log_info "${CANONICAL_NAME} is already running."
                    continue
                fi

                # Ignition Logic
                vde_log_info "Igniting ${CANONICAL_NAME}..." "docker"
                
                # Fetch Docker-specific config from registry/templates
                local ssh_port svc_port_str net_name
                ssh_port=$(get_vm_ssh_port "${CANONICAL_NAME}")
                svc_port_str=$(get_vm_service_ports "${CANONICAL_NAME}")
                net_name="${VDE_DOCKER_NETWORK:-vde-net}"
                
                # Convert comma-separated ports to docker -p flags
                local -a port_args
                port_args=("-p" "${ssh_port}:${ssh_port}")
                local -a svc_ports
                local IFS=','
                svc_ports=(${(s:,:)svc_port_str})
                for p in "${svc_ports[@]}"; do
                    [[ -n "${p}" ]] && port_args+=("-p" "${p}:${p}")
                done

                # Resolve mounts
                local mount_str
                mount_str=$(get_vm_mounts "${CANONICAL_NAME}")
                local -a mount_args
                mount_args=()
                local IFS='|'
                for m in ${(s:|:)mount_str}; do
                    local src="${m%%:*}"
                    local dst="${m#*:}"
                    # Resolve relative source paths against project root
                    [[ "${src}" != /* ]] && src="${VDE_ROOT_DIR}/${src}"
                    mount_args+=("-v" "${src}:${dst}")
                done

                # Pre-ignition check: image must exist
                if ! image_exists "${CANONICAL_NAME}"; then
                    vde_log_warn "Image for ${CANONICAL_NAME} not found. Attempting to rebuild..." "docker"
                    "${VDE_ROOT_DIR}/bin/vde-rebuild" "${target_type}" || { vde_log_error "Rebuild failed for ${CANONICAL_NAME}"; continue; }
                fi

                # Ignition Phase (The Handshake)
                # We prioritize the LIVE host SSH agent socket bridge via unified discovery
                local host_ssh_auth_sock
                host_ssh_auth_sock=$(vde_get_host_ssh_sock)

                # Physical Handshake Verification (Section 10.3)
                if [[ ! -S "${host_ssh_auth_sock}" ]]; then
                    vde_log_error "SSH Bridge Blockade: Host socket not found or invalid." "ssh"
                    vde_log_error "Attempted Path: ${host_ssh_auth_sock:-[EMPTY]}" "ssh"
                    vde_log_error "Check your SSH agent: echo \$SSH_AUTH_SOCK" "ssh"
                    GLOBAL_RC=1
                    continue
                fi

                vde_progress_spinner_start "Igniting ${CANONICAL_NAME} (SSH: ${ssh_port})"
                local max_ignite_retries=3
                local ignite_attempt=1
                local ignite_success=false
                typeset -A tried_ports
                tried_ports=()

                local run_err_file=$(mktemp)
                while [[ ${ignite_attempt} -le ${max_ignite_retries} ]]; do
                    vde_progress_spinner_update
                    if docker run -d \
                        --name "${CANONICAL_NAME}" \
                        --hostname "${CANONICAL_NAME}" \
                        --label "vde.managed=true" \
                        --network "${net_name}" \
                        --add-host "host.docker.internal:host-gateway" \
                        "${port_args[@]}" \
                        "${mount_args[@]}" \
                        -v "${VDE_ROOT_DIR}/data:/vde/data:ro" \
                        -v "${HOME}/.ssh/vde/vde_student.pub:/home/devuser/.ssh/vde/authorized_keys:ro" \
                        -v "${HOME}/.ssh/vde/vde_student:/home/devuser/.ssh/vde/vde_student:ro" \
                        -v "/var/run/docker.sock:/var/run/docker.sock" \
                        -v "${host_ssh_auth_sock}:/run/host-services/ssh-auth.sock" \
                        -v "${host_ssh_auth_sock}:/run/vde-ssh.sock" \
                        -e "SSH_AUTH_SOCK=/home/devuser/.ssh/vde/agent.sock" \
                        "${CANONICAL_NAME}" >/dev/null 2>"${run_err_file}"; then
                        ignite_success=true
                        vde_progress_spinner_stop "${CANONICAL_NAME} ignited"
                        break
                    else
                        local err_msg=$(cat "${run_err_file}")
                        if [[ "${err_msg}" == *"port is already allocated"* || "${err_msg}" == *"Bind for"* ]]; then
                            vde_log_warn "Port conflict detected for ${CANONICAL_NAME} (Attempt ${ignite_attempt}/${max_ignite_retries}). Retrying with new port..." "docker"
                            release_port_reservation "${ssh_port}"
                            tried_ports[${ssh_port}]=1
                            local exclude_str="${(j:,:)tried_ports}"
                            ssh_port=$(allocate_port_for_vm "${CANONICAL_NAME}" "" "" "${exclude_str}")
                            port_args=("-p" "${ssh_port}:${ssh_port}")
                            for p in "${svc_ports[@]}"; do [[ -n "${p}" ]] && port_args+=("-p" "${p}:${p}"); done
                        else
                            vde_progress_spinner_stop "" "Critical ignition failure for ${CANONICAL_NAME}: ${err_msg}" 1
                            break
                        fi
                    fi
                    ignite_attempt=$((ignite_attempt + 1))
                    local jitter_val=$(( (10 + RANDOM % 40) / 100.0 ))
                    "${VDE_ROOT_DIR}/bin/vde-poll" --wait "${jitter_val}" "all" >/dev/null 2>&1
                done
                rm -f "${run_err_file}"
                
                if [[ "${ignite_success}" != "true" ]]; then
                    vde_log_error "Failed to ignite ${CANONICAL_NAME}"
                    vde_error_map ${VDE_ERR_DOCK:-8} "${CANONICAL_NAME}"
                    [[ -n "${ALLOCATED_PORT}" ]] && release_port_reservation "${ALLOCATED_PORT}"
                    GLOBAL_RC=1
                fi
            } always {
                release_lock "${vm_lock}"
            }
        done
        exit ${GLOBAL_RC}
        ;;

    stop)
        shift
        local targets=("${@}")
        local force=false
        # Filter out flags
        local vms=()
        for t in "${targets[@]}"; do
            [[ "${t}" == "-f" || "${t}" == "--force" ]] && force=true && continue
            vms+=("${t}")
        done

        if [[ "${vms}" == "all" ]]; then
            vms=($(get_all_vms))
        fi

        [[ -z "${vms}" ]] && vde_log_error "Usage: vde stop [-f] <alias...|all>" && exit 1

        for vm_alias in "${vms[@]}"; do
            CANONICAL_NAME=$(resolve_vm_name "${vm_alias}" 2>/dev/null)
            if [[ -z "${CANONICAL_NAME}" ]]; then
                vde_log_warn "Unknown VM: ${vm_alias}"
                continue
            fi

            if docker ps -a --format '{{.Names}}' | grep -q "^${CANONICAL_NAME}$"; then
                vde_log_info "Stopping ${CANONICAL_NAME}..." "docker"
                docker stop "${CANONICAL_NAME}" >/dev/null 2>&1 || true
                vde_log_success "${CANONICAL_NAME} stopped."
            else
                vde_log_info "${CANONICAL_NAME} is not running." "vde"
            fi
        done
        ;;
    remove|delete)
        shift
        local targets=("${@}")
        [[ -z "${targets}" ]] && vde_log_error "Usage: vde remove <alias...|all>" && exit 1

        if [[ "${targets}" == "all" ]]; then
            targets=($(get_all_vms))
        fi

        for vm_alias in "${targets[@]}"; do
            CANONICAL_NAME=$(resolve_vm_name "${vm_alias}" 2>/dev/null)
            if [[ -z "${CANONICAL_NAME}" ]]; then
                vde_log_warn "Unknown VM: ${vm_alias}"
                continue
            fi

            if docker ps -a --format '{{.Names}}' | grep -q "^${CANONICAL_NAME}$"; then
                vde_log_info "Removing container ${CANONICAL_NAME}..." "docker"
                docker rm -f "${CANONICAL_NAME}" >/dev/null 2>&1 || true
                vde_log_success "${CANONICAL_NAME} removed."
            else
                vde_log_info "No container found for ${CANONICAL_NAME}." "vde"
            fi
        done
        ;;
    exec)
        shift
        "${VDE_ROOT_DIR}/bin/vde-exec" "$@"
        ;;
    enter)
        shift
        "${VDE_ROOT_DIR}/bin/ssh-vm" "$@"
        ;;
    list)
        shift
        "${VDE_ROOT_DIR}/bin/list-vms" "$@"
        ;;
    add)
        shift
        "${VDE_ROOT_DIR}/bin/add-vm-type" "$@"
        ;;
    uninstall)
        shift
        "${VDE_ROOT_DIR}/bin/uninstall-vm-type" "$@"
        ;;
    validate)
        shift
        "${VDE_ROOT_DIR}/bin/validate-schemas.zsh" "$@"
        ;;
    rebuild-cache)
        shift
        "${VDE_ROOT_DIR}/bin/vde-rebuild-cache" "$@"
        ;;
    ask)
        shift
        "${VDE_ROOT_DIR}/bin/vde-ask" "$@"
        ;;
    port)
        local vm_alias=$2
        CANONICAL_NAME=$(resolve_vm_name "${vm_alias}" 2>/dev/null)
        vde_query_json -r "(.vms.language[]?, .vms.service[]?) | select(.name == \"${CANONICAL_NAME}\") | .ssh_port // empty" "${TYPES_JSON}"
        exit $?
        ;;
    info)
        shift
        "${VDE_ROOT_DIR}/bin/vde-info" "$@"
        ;;
    help|*) echo "Usage: vde {rebuild|start|stop|exec|enter|list|add|uninstall|validate|rebuild-cache|ask|port|info} [type/alias]" ;;
esac
