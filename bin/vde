#!/usr/bin/env zsh
#===============================================================================
# VDE CLI - Unified Virtual Development Environment
# Version: 2.0.3 (Absolute - Final)
#===============================================================================

# --- 1. BOOTSTRAP & ROOT DISCOVERY ---
_VDE_CORE_SCRIPT_PATH="${(%):-%x}"
VDE_ROOT_DIR="$(cd "$(dirname "${_VDE_CORE_SCRIPT_PATH}")/.." && pwd)"
export VDE_ROOT_DIR

# --- 2. SOURCE CORE ECOSYSTEM ---
if [[ -f "${VDE_ROOT_DIR}/lib/vm-common" ]]; then
    source "${VDE_ROOT_DIR}/lib/vm-common"
else
    echo "CRITICAL: lib/vm-common not found."
    exit 1
fi

# Zero-Host-Dependency JQ Wrapper
vde_query_json() {
    if command -v jq >/dev/null 2>&1; then
        jq -r "$1" "$2"
    else
        docker run --rm -v "${VDE_ROOT_DIR}:/vde" vde-base jq -r "$1" "/vde/${2#$VDE_ROOT_DIR/}"
    fi
}

# Define Data Paths
TYPES_JSON="${VDE_ROOT_DIR}/data/vm-types.json"
TYPES_SCHEMA="${VDE_ROOT_DIR}/data/vm-types.schema.json"
TYPES_CACHE="${VDE_ROOT_DIR}/.cache/vm-types.cache"

# --- 3. VALIDATE & LOAD DATA ---
if [[ -f "${TYPES_JSON}" && -f "${TYPES_SCHEMA}" ]]; then
    vde_validate_and_update "${TYPES_JSON}" "${TYPES_SCHEMA}" "${TYPES_CACHE}"
fi

load_vm_types

# --- 4. COMMAND ROUTER ---
CMD="$1"
TYPE_ARG="$2"

CANONICAL_NAME=$(resolve_vm_name "${TYPE_ARG}" 2>/dev/null)
BASE_NAME="${CANONICAL_NAME#vde-}"

case "${CMD}" in
    rebuild)
        local build_args=()
        # Check for --no-cache or other flags in remaining args
        for arg in "$@"; do
            [[ "$arg" == "--no-cache" ]] && build_args+=("--no-cache")
        done

        if [[ "${TYPE_ARG}" == "base" ]]; then
            vde_log_info "Baking foundation: vde-base..." "docker"
            docker build "${build_args[@]}" \
                -f "${VDE_ROOT_DIR}/configs/docker/vde-base.Dockerfile" \
                -t "vde-base" .
            exit 0
        fi

        [[ -z "${CANONICAL_NAME}" ]] && vde_log_error "Unknown type: '${TYPE_ARG}'" && exit 1
        
        # Extract both standard pkgs and special custom_cmd
        local pkgs=$(vde_query_json "(.vms.language[]?, .vms.service[]?) | select(.name == \"${CANONICAL_NAME}\") | .pkgs // empty" "${TYPES_JSON}")
        local custom_cmd=$(vde_query_json "(.vms.language[]?, .vms.service[]?) | select(.name == \"${CANONICAL_NAME}\") | .custom_cmd // empty" "${TYPES_JSON}")
        
        if [[ -z "${pkgs}" && -z "${custom_cmd}" ]]; then
            vde_log_error "No installation method (pkgs or custom_cmd) defined for ${CANONICAL_NAME}"
            exit 1
        fi

        vde_log_info "Baking ${CANONICAL_NAME}..." "docker"
        docker build "${build_args[@]}" \
            -f "${VDE_ROOT_DIR}/configs/docker/vde-lang.Dockerfile" \
            --build-arg PKGS_TO_INSTALL="${pkgs}" \
            --build-arg CUSTOM_BUILD_CMD="${custom_cmd}" \
            -t "${CANONICAL_NAME}" .
        ;;

    start)
        [[ -z "${CANONICAL_NAME}" ]] && vde_log_error "Unknown type: '${TYPE_ARG}'" && exit 1
        
        # --- Conflict Prevention ---
        if docker ps -a --format '{{.Names}}' | grep -q "^${CANONICAL_NAME}$"; then
            vde_log_info "Removing existing container ${CANONICAL_NAME}..." "docker"
            docker rm -f "${CANONICAL_NAME}" >/dev/null
        fi

        local ssh_port=$(get_vm_ssh_port "${CANONICAL_NAME}")
        if [[ -z "${ssh_port}" ]]; then
            ssh_port=$(vde_query_json "(.vms.language[]?, .vms.service[]?) | select(.name == \"${CANONICAL_NAME}\") | .ssh_port // empty" "${TYPES_JSON}")
        fi
        
        local svc_ports=($(vde_query_json "(.vms.language[]?, .vms.service[]?) | select(.name == \"${CANONICAL_NAME}\") | (.service_ports[]?, .service_port?) // empty" "${TYPES_JSON}" | grep -v "null"))
        
        local vm_category=$(get_vm_category "${CANONICAL_NAME}")
        local mount_src="${VDE_ROOT_DIR}/projects/${BASE_NAME}"
        local mount_dst="/home/devuser/workspace"

        if [[ "${vm_category}" == "services" ]]; then
            mount_src="${VDE_ROOT_DIR}/data/${BASE_NAME}"
            [[ "${BASE_NAME}" == *"postgres"* ]] && mount_dst="/var/lib/postgresql/data"
        fi
        
        ensure_vm_directories "${CANONICAL_NAME}" "$(get_vm_type "${CANONICAL_NAME}")"

        local port_args=("-p" "${ssh_port}:22")
        for p in "${svc_ports[@]}"; do
            [[ -n "${p}" ]] && port_args+=("-p" "${p}:${p}")
        done

        vde_log_info "Igniting ${CANONICAL_NAME} (SSH: ${ssh_port})..." "docker"
        docker run -d \
            --name "${CANONICAL_NAME}" \
            "${port_args[@]}" \
            -v "${mount_src}:${mount_dst}" \
            -v "${VDE_ROOT_DIR}/public-ssh-keys/vde_student.pub:/home/devuser/.ssh/authorized_keys:ro" \
            "${CANONICAL_NAME}"
        ;;

    stop)
        [[ -z "${CANONICAL_NAME}" ]] && vde_log_error "Unknown type: '${TYPE_ARG}'" && exit 1

        if docker ps -a --format '{{.Names}}' | grep -q "^${CANONICAL_NAME}$"; then
            vde_log_info "Stopping ${CANONICAL_NAME}..." "docker"
            docker stop "${CANONICAL_NAME}" >/dev/null
        else
            vde_log_info "${CANONICAL_NAME} is not running." "vde"
        fi
        ;;

    exec)
        [[ -z "${CANONICAL_NAME}" ]] && vde_log_error "Unknown VM: '${TYPE_ARG}'" && exit 1
        shift 2
        local user_flag=("-u" "devuser")
        if [[ "$1" == "--root" ]]; then
            user_flag=()
            shift
        fi
        docker exec "${user_flag[@]}" "${CANONICAL_NAME}" "$@"
        ;;

    enter)
        [[ -z "${CANONICAL_NAME}" ]] && vde_log_error "Unknown VM: '${TYPE_ARG}'" && exit 1
        local ssh_port=$(get_vm_ssh_port "${CANONICAL_NAME}")
        if [[ -z "${ssh_port}" ]]; then
            ssh_port=$(vde_query_json "(.vms.language[]?, .vms.service[]?) | select(.name == \"${CANONICAL_NAME}\") | .ssh_port // empty" "${TYPES_JSON}")
        fi
        
        vde_log_info "Entering ${CANONICAL_NAME} via port ${ssh_port}..." "ssh"
        shift 2
        ssh -i "${HOME}/.ssh/vde/vde_student" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -p "${ssh_port}" devuser@localhost "$@"
        ;;

    list) show_known_vms ;;
    version|--version) echo "VDE v${VDE_VERSION:-2.0.3}" ;;
    help|*) echo "Usage: vde {rebuild|start|stop|exec|enter|list} [type/alias]" ;;
esac

