#!/usr/bin/env zsh
# create-virtual-for - Create a new VM with predefined configuration
# Enhanced with progress indicators and improved error messages

set -e

# Determine VDE root directory
if [[ -z "${VDE_ROOT_DIR}" ]]; then
    export VDE_ROOT_DIR="${0:a:h:h}"
fi

# Source shared library
source "${VDE_ROOT_DIR}/lib/vm-common"

# Source UX libraries (optional - for enhanced UX)
if [[ -f "${VDE_ROOT_DIR}/lib/vde-progress" ]]; then
    source "${VDE_ROOT_DIR}/lib/vde-progress"
fi
if [[ -f "${VDE_ROOT_DIR}/lib/vde-errors" ]]; then
    source "${VDE_ROOT_DIR}/lib/vde-errors"
fi
if [[ -f "${VDE_ROOT_DIR}/lib/vde-naming" ]]; then
    source "${VDE_ROOT_DIR}/lib/vde-naming"
fi

# -----------------------
# Configuration
# -----------------------
QUIET=false
VERBOSE=false
START_VM=true  # Default: start VM after creation
FORCE=false

# -----------------------
# Usage
# -----------------------
show_usage() {
    cat <<EOF
Usage: create-virtual-for [OPTIONS] <vm_name>

Create a new VM with predefined configuration.

Arguments:
  vm_name    Name of the VM (must be predefined in vm-types.conf)

Options:
  -h, --help     Show this help message
  -q, --quiet    Suppress progress indicators
  -v, --verbose  Show detailed output
  --no-start     Don't start the VM after creation
  --force        Force regenerate files even if VM already exists

Examples:
  create-virtual-for python    # Create and start Python language VM
  create-virtual-for postgres  # Create and start PostgreSQL service VM
  create-virtual-for python --no-start  # Create only, don't start

The script will:
  1. Validate the VM name (follows naming convention)
  2. Auto-allocate SSH port (2200-2299 for languages, 2400-2499 for services)
  3. Create docker-compose.yml from template
  4. Create required directories (projects/ or data/, logs/)
  5. Create environment file (env-files/)
  6. Add SSH config entry to ~/.ssh/vde/config
  7. Start the VM (unless --no-start is specified)

EOF
}

# -----------------------
# Parse Arguments
# -----------------------
while [[ ${#} -gt 0 ]]; do
    case "${1}" in
        -h|--help)
            show_usage
            exit 0
            ;;
        -q|--quiet)
            QUIET=true
            export VDE_PROGRESS_QUIET=1
            shift
            ;;
        -v|--verbose)
            VERBOSE=true
            export VDE_ERRORS_VERBOSE=1
            shift
            ;;
        --force)
            FORCE=true
            shift
            ;;
        --no-start)
            START_VM=false
            shift
            ;;
        -*)
            log_error "Unknown option: ${1}"
            exit ${VDE_ERR_GENERAL}
            ;;
        *)
            break
            ;;
    esac
done

if [[ ${#} -eq 0 ]]; then
    show_usage
    exit ${VDE_ERR_GENERAL}
fi

# -----------------------
# Single-VM creation function
# -----------------------
_create_one_vm() {
    local VM_NAME="${1}"

    # Validate VM name is not empty
    if [[ -z "${VM_NAME}" ]]; then
        _error "VM name cannot be empty"
        return ${VDE_ERR_INVALID_INPUT}
    fi

    # -----------------------
    # Validation
    # -----------------------
    vde_progress_info "Validating configuration for '${VM_NAME}'..."

    # Resolve VM name (handles aliases)
    local RESOLVED_NAME
    RESOLVED_NAME=$(resolve_vm_name "${VM_NAME}" || true)
    if [[ -z "${RESOLVED_NAME}" ]]; then
        vde_error_alias_not_found "${VM_NAME}"
        echo ""
        show_known_vms
        return ${VDE_ERR_GENERAL}
    fi

    # Use resolved name
    VM_NAME="${RESOLVED_NAME}"

    # Get VM Configuration
    local _vm_type _vm_display _vm_install _vm_svc_port
    _vm_type=$(get_vm_info type "${VM_NAME}")
    _vm_display=$(get_vm_info display "${VM_NAME}")
    _vm_install=$(get_vm_info install "${VM_NAME}")
    _vm_svc_port=$(get_vm_info svc_port "${VM_NAME}")

    if [[ -z "${_vm_type}" ]]; then
        vde_error_vm_not_found "${VM_NAME}"
        return ${VDE_ERR_GENERAL}
    fi

    validate_vm_name "${VM_NAME}" "${_vm_type}" || return ${VDE_ERR_GENERAL}

    if [[ "${FORCE}" != "true" ]] && vm_exists "${VM_NAME}"; then
        vde_error_container_exists "${VM_NAME}"
        return ${VDE_ERR_EXISTS}
    fi

    vde_progress_info "VM Type: ${_vm_type}"
    vde_progress_info "Display Name: ${_vm_display}"

    # -----------------------
    # Port — fixed per VM type from data/vm-types.conf
    # -----------------------
    vde_progress_info "Reading SSH port..."
    local SSH_PORT
    SSH_PORT=$(get_vm_info ssh_port "${VM_NAME}")
    if [[ -z "${SSH_PORT}" ]]; then
        vde_error_simple "No ssh_port defined for '${VM_NAME}' in vm-types.conf — cannot create VM"
        return ${VDE_ERR_GENERAL}
    fi
    vde_progress_info "SSH port: ${SSH_PORT}"

    # -----------------------
    # Create Directories
    # -----------------------
    vde_progress_info "Creating directory structure..."
    ensure_vm_directories "${VM_NAME}" "${_vm_type}"

    # -----------------------
    # Create Docker Compose File
    # -----------------------
    vde_progress_info "Creating docker-compose.yml..."

    local RAW_NAME compose_file template_file category
    RAW_NAME=$(vde_normalize_name "${VM_NAME}")
    category=$(get_vm_category "${VM_NAME}")
    
    compose_file="${CONFIGS_DIR}/${category}/${RAW_NAME}/docker-compose.yml"

    if [[ "${_vm_type}" == "lang" ]]; then
        template_file="${TEMPLATES_DIR}/compose-language.yml"
    elif [[ "${_vm_type}" == "service" ]]; then
        template_file="${TEMPLATES_DIR}/compose-service.yml"
    else
        vde_error_simple "Unknown VM type: ${_vm_type}"
        return ${VDE_ERR_GENERAL}
    fi

    if [[ ! -f "${template_file}" ]]; then
        vde_error_template_not_found "${template_file}"
        return ${VDE_ERR_GENERAL}
    fi

    render_template "${template_file}" \
        NAME "${RAW_NAME}" \
        SSH_PORT "${SSH_PORT}" \
        INSTALL_CMD "${_vm_install}" \
        SERVICE_PORT "${_vm_svc_port}" \
        > "${compose_file}"

    # Handle multiple service ports
    if [[ "${_vm_type}" == "service" ]] && [[ -n "${_vm_svc_port}" ]]; then
        while IFS= read -r line; do
            if [[ "${line}" == *"##SERVICE_PORTS##" ]]; then
                local p
                echo "${_vm_svc_port}" | tr ',' '\n' | while read -r p; do
                    p=$(echo "${p}" | tr -d ' ')
                    echo "      - \"${p}:${p}\""
                done
            else
                echo "${line}"
            fi
        done < "${compose_file}" > "${compose_file}.tmp"
        mv "${compose_file}.tmp" "${compose_file}"
    else
        grep -v "##SERVICE_PORTS##" "${compose_file}" > "${compose_file}.tmp"
        mv "${compose_file}.tmp" "${compose_file}"
    fi

    vde_progress_done "Created: ${compose_file}"

    if [[ -n "${VDE_TEST_MODE}" ]]; then
        cat "${compose_file}"
    fi

    # -----------------------
    # Create Environment File
    # -----------------------
    vde_progress_info "Creating environment file..."

    local env_file
    env_file="${VDE_ROOT_DIR}/env-files/vde-${RAW_NAME}.env"

    cat > "${env_file}" <<EOF
# Environment variables for ${_vm_display} development container
SSH_PORT=${SSH_PORT}
DATABASE_URL=postgresql://devuser:SuperSecretPassword123!@postgres:5432/${RAW_NAME}_dev_db
REDIS_HOST=redis
REDIS_PORT=6379
EOF

    if [[ -n "${_vm_svc_port}" ]]; then
        local p
        echo "${_vm_svc_port}" | tr ',' '\n' | while read -r p; do
            p=$(echo "${p}" | tr -d ' ')
            [ -n "${p}" ] && {
                upper_name=$(echo "${RAW_NAME}" | tr '[:lower:]' '[:upper:]')
                echo "${upper_name}_PORT=${p}" >> "${env_file}"
            }
        done
    fi

    vde_progress_done "Created: ${env_file}"

    # -----------------------
    # Update SSH Config
    # -----------------------
    vde_progress_info "Updating SSH configuration..."

    local ssh_host
    ssh_host="$(vde_get_ssh_host "${VM_NAME}")"

    if ! merge_ssh_config_entry "${ssh_host}" "${SSH_PORT}" "${_vm_display}" "${VDE_SSH_IDENTITY}"; then
        vde_error_permission_denied "${VDE_SSH_CONFIG}"
        return ${VDE_ERR_GENERAL}
    fi

    # configs/ssh/config is the authoritative source — never overwrite it from live config

    # -----------------------
    # Start the VM (unless disabled)
    # -----------------------
    if [[ "${START_VM}" == "true" ]]; then
        vde_progress_info "Starting VM..."

        if "${VDE_ROOT_DIR}/bin/vde" start "${VM_NAME}" 2>/dev/null; then
            vde_progress_done "Started VM: ${VM_NAME}"

            local state_json
            state_json=$(cat <<EOF
{
  "vm_name": "${VM_NAME}",
  "vm_type": "${_vm_type}",
  "display_name": "${_vm_display}",
  "ssh_port": ${SSH_PORT},
  "service_port": "${_vm_svc_port}",
  "created_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "status": "running"
}
EOF
)
            save_docker_state "${VM_NAME}" "${state_json}"
        else
            vde_progress_warn "Failed to start VM: ${VM_NAME}"
        fi
    fi

    # -----------------------
    # Summary
    # -----------------------
    echo ""
    vde_success "VM '${VM_NAME}' configuration complete!"
    echo "  - ${compose_file}"
    echo "  - ${env_file}"
    echo "  SSH alias: ${ssh_host}  port: ${SSH_PORT}"
    echo ""
    return 0
}

# -----------------------
# Main: loop over all VM names
# -----------------------
typeset -a _CREATED_VMS _FAILED_VMS
_last_exit=0
for _vm_arg in "${@}"; do
    _create_one_vm "${_vm_arg}"
    _rc=${?}
    if [[ ${_rc} -eq 0 ]]; then
        _CREATED_VMS+=("${_vm_arg}")
    else
        _FAILED_VMS+=("${_vm_arg}")
        _last_exit=${_rc}
    fi
done

echo ""
if [[ ${#_CREATED_VMS[@]} -gt 0 ]]; then
    vde_success "Created ${#_CREATED_VMS[@]} VM(s): ${_CREATED_VMS[*]}"
fi
if [[ ${#_FAILED_VMS[@]} -gt 0 ]]; then
    log_error "Failed ${#_FAILED_VMS[@]} VM(s): ${_FAILED_VMS[*]}"
    exit ${_last_exit}
fi
