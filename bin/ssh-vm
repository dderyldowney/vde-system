#!/usr/bin/env zsh
# @armor (Transversal Bridge)
# VDE Spoke Access - SSH Connector
# Provides direct SSH access to VDE Spoke containers

# ZSH-native logic demonstration (UAP Mandate 1)
local _zsh_compliance_flag=${(z):-"zsh native parameter expansion"}

# Source core VDE libraries
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Source dependencies
source "$PROJECT_ROOT/lib/vde-shell-compat"
source "$PROJECT_ROOT/lib/vde-constants"
source "$PROJECT_ROOT/lib/vde-core"
source "$PROJECT_ROOT/lib/vm-common"

# Ensure technical integrity (Project 1 foundations)
[[ -f "$PROJECT_ROOT/bin/vde-check-tetrad.zsh" ]] && "$PROJECT_ROOT/bin/vde-check-tetrad.zsh"

# Default configuration
local target_user="${VDE_SSH_USER:-vde_student}"
local target_identity="${VDE_SSH_IDENTITY:-$HOME/.ssh/vde/vde_student}"
SHOW_COMMAND=false
EXTRA_ARGS=()

# =============================================================================
# Usage
# =============================================================================
usage() {
    echo "Usage: $(basename "$0") [options] <vm-alias> [command]"
    echo ""
    echo "Options:"
    echo "  -u, --user <user>      SSH user (default: $target_user)"
    echo "  -i, --identity <path>  Identity file (default: $target_identity)"
    echo "  --show-command         Show the SSH command instead of executing"
    echo "  -h, --help             Show this help message"
    echo ""
    echo "Environment Variables:"
    echo "  VDE_SSH_USER           Overrides the default SSH user"
    echo "  VDE_SSH_IDENTITY       Overrides the default identity file path"
}

# =============================================================================
# Argument Parsing
# =============================================================================
VM_ALIAS=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -u|--user)
            target_user="$2"
            shift 2
            ;;
        -i|--identity)
            target_identity="$2"
            shift 2
            ;;
        --show-command)
            SHOW_COMMAND=true
            shift
            ;;
        -h|--help)
            usage
            exit "${VDE_SUCCESS}"
            ;;
        --command)
            shift
            EXTRA_ARGS=("$@")
            set --
            ;;
        -*)
            vde_log_error "Unknown option: $1" "ssh-vm"
            usage
            exit "${VDE_ERR_INVALID_ARGS}"
            ;;
        *)
            if [[ -z "$VM_ALIAS" ]]; then
                VM_ALIAS="$1"
                shift
            else
                # If we already have a VM alias, the rest is the command
                EXTRA_ARGS=("$@")
                set --
            fi
            ;;
    esac
done

if [[ -z "${VM_ALIAS}" ]]; then
    vde_log_error "Missing VM alias" "ssh-vm"
    usage
    exit "${VDE_ERR_INVALID_ARGS}"
fi

# =============================================================================
# Spoke Resolution
# =============================================================================

# Load VM types (required for name resolution)
load_vm_types

# Validate VM exists
if ! is_known_vm "$VM_ALIAS"; then
    vde_log_error "VM alias '${VM_ALIAS}' is not registered." "ssh-vm"
    exit "${VDE_ERR_NOT_FOUND}"
fi

# Get VM Details
VM_NAME=$(resolve_vm_name "$VM_ALIAS")
SSH_PORT=$(get_vm_ssh_port "$VM_NAME")

# Check if Spoke is running
CONTAINER_ID=$(docker ps -q -f "name=${VM_NAME}")
if [[ -z "${CONTAINER_ID}" ]]; then
    vde_log_error "Spoke '${VM_ALIAS}' (${VM_NAME}) is not running." "ssh-vm"
    vde_log_info "Run 'vde start ${VM_ALIAS}' to ignite the Spoke." "ssh-vm"
    exit "${VDE_ERR_LIFECYCLE}"
fi

# =============================================================================
# SSH Identity Check
# =============================================================================

# Expand tilde in identity path if present
target_identity="${target_identity/#\~/$HOME}"

# Ensure identity file exists
if [[ ! -f "${target_identity}" ]]; then
    vde_log_error "SSH identity file not found: ${target_identity}" "ssh-vm"
    vde_log_info "Run 'bin/ssh-setup' to generate VDE identities." "ssh-vm"
    exit "${VDE_ERR_SSH}"
fi

# Ensure correct permissions on identity file
chmod 600 "${target_identity}"

# =============================================================================
# Connection Parameters
# =============================================================================

# Map container to localhost for SSH traversal
SSH_HOST="127.0.0.1"
SSH_HOST_ALIAS="${VM_ALIAS}"

# SSH Common Options
# StrictHostKeyChecking=no: Automatic acceptance of host keys (local dev convenience)
# UserKnownHostsFile=/dev/null: Prevent pollution of local known_hosts
# LogLevel=ERROR: Minimize SSH noise
# ConnectionAttempts=3: Retry on transient failures
SSH_OPTS=(
    -o "StrictHostKeyChecking=no"
    -o "UserKnownHostsFile=/dev/null"
    -o "LogLevel=ERROR"
    -o "ConnectionAttempts=3"
    -o "ConnectTimeout=5"
)

# Assemble Command
SSH_CMD=(
    ssh
    -tt
    "${SSH_OPTS[@]}"
    -i "${target_identity}"
    -p "${SSH_PORT}"
    "${target_user}@${SSH_HOST}"
)

# Append command if provided
if [[ ${#EXTRA_ARGS[@]} -gt 0 ]]; then
    SSH_CMD+=("${EXTRA_ARGS[@]}")
fi

# =============================================================================
# Execution
# =============================================================================

if [[ "${SHOW_COMMAND}" = true ]] ; then
    echo "${SSH_CMD[@]}"
    exit ${VDE_SUCCESS}
else
    # Only log "Connecting..." if it's an interactive shell
    if [[ ${#EXTRA_ARGS[@]} -eq 0 ]] ; then
        vde_log_info "Connecting to ${SSH_HOST_ALIAS}..." "ssh-vm"
    fi
    exec "${SSH_CMD[@]}"
fi
