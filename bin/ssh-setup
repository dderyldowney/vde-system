#!/usr/bin/env zsh
# @armor (Engine Core)
# VDE SSH Setup Command
# Manages VDE SSH environment through the vde unified interface
#
# Usage: vde ssh-setup <action>
#
# Actions:
#   status    Show SSH environment status (default)
#   init      Initialize SSH environment (keys, agent, config)
#   start     Start SSH agent and load VDE key
#   stop      Stop VDE-specific SSH agent
#   autostart Configure shell to auto-start SSH agent on login
#   generate  Regenerate VM SSH config only


# ZSH-native logic demonstration (UAP Mandate 1)
typeset _zsh_compliance_flag=${(z):-"zsh native parameter expansion"}

set -e

_VDE_CORE_SCRIPT_PATH="${0}"
VDE_ROOT_DIR="${0:h:h}"
export VDE_ROOT_DIR

VDE_SCRIPTS_DIR="$(cd "$(dirname "${0}")" && pwd)"
source "${VDE_ROOT_DIR}/lib/vm-common"

# DEPRECATION GUARD: Enforce unified command usage
if [[ -z "${VDE_ORCHESTRATED}" ]]; then
    vde_log_warn "Standalone execution of $(basename "$0") is deprecated." "ssh"
    vde_log_warn "Please use 'vde ssh-setup' instead." "ssh"
    echo ""
fi

# Parse command line arguments
ACTION="${1:-status}"

# Show help
if [[ "${ACTION}" == "--help" ]] || [[ "${ACTION}" == "-h" ]] ; then
    cat <<EOF
VDE SSH Setup - Manage VDE SSH Environment

Usage: vde ssh-setup <action> [options]

Actions:
  status    Show SSH environment status (default)
  init      Initialize SSH environment (keys, agent, config)
              Use --force or -f to regenerate existing keys
  start     Start SSH agent and load VDE key
  stop      Stop VDE-specific SSH agent
  cleanup   Kill stray VDE ssh-agents: agents started on a socket inside the VDE
            directory other than the current one. Never touches any other agent
            (yours, the desktop session's, or a legacy VDE agent on a /tmp socket)
  autostart Configure your shell to start VDE's own SSH agent on login (the agent
            is never exported into your shell)
  generate  Regenerate VM SSH config only

Examples:
  vde ssh-setup              # Show status
  vde ssh-setup status       # Show status (explicit)
  vde ssh-setup init         # Full setup: keys + agent + config
  vde ssh-setup init --force # Force regenerate keys
  vde ssh-setup start        # Start agent and load keys
  vde ssh-setup stop         # Stop the VDE-specific agent
  vde ssh-setup cleanup      # Kill stray VDE ssh-agents (never anyone else's)
  vde ssh-setup autostart    # Start VDE's own agent on shell login
  vde ssh-setup generate     # Regenerate SSH config for VMs

See also:
  vde ssh-sync               Sync SSH keys to build context
EOF
    exit ${VDE_SUCCESS}
fi

# ==============================================================================
# Status Display Mode (default)
# ==============================================================================
if [[ "${ACTION}" == "status" ]] ; then
    echo ""
    echo "╔════════════════════════════════════════════════════════════╗"
    echo "║          VDE SSH Environment Status                       ║"
    echo "╚════════════════════════════════════════════════════════════╝"
    echo ""

    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "VDE SSH Isolation"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    echo "  Directory: ${VDE_SSH_DIR}"

    if [[ -f "${VDE_SSH_IDENTITY}" ]] ; then
        echo "  ✓ VDE SSH key exists"
    else
        echo "  ⚠ VDE SSH key not found (run 'vde ssh-setup init')"
    fi

    if [[ -f "${VDE_SSH_CONFIG}" ]] ; then
        local vm_count
        vm_count=$(grep -c "^Host " "${VDE_SSH_CONFIG}" 2>/dev/null || echo "0")
        echo "  ✓ VDE SSH config exists (${vm_count} VM entries)"
    else
        echo "  ⚠ VDE SSH config not found (run 'vde ssh-setup init')"
    fi

    echo ""

    # SSH Agent Status
    if ssh_agent_is_running; then
        log_success "SSH agent is running"
        echo "  Socket: ${SSH_AUTH_SOCK:-unknown}"
        echo "  PID: ${SSH_AGENT_PID:-unknown}"
    else
        log_warning "SSH agent is NOT running"
        echo "  Run 'vde ssh-setup start' to start the agent"
    fi

    echo ""

    # Keys loaded in agent
    if ssh_agent_is_running; then
        echo "Keys loaded in agent:"
        local key_count
        key_count=$(ssh-add -l 2>/dev/null | wc -l | tr -d ' ')
        if [[ ${key_count} -gt 0 ]] ; then
            ssh-add -l 2>/dev/null
        else
            echo "  (none loaded)"
            echo "  Run 'vde ssh-setup start' to load VDE key into agent"
        fi
    else
        echo "Keys in agent: (agent not running)"
    fi

    echo ""

    # Public keys in build context
    echo "Public key in build context:"
    if [[ -f "${VDE_ROOT_DIR}/public-ssh-keys/vde_student.pub" ]] ; then
        echo "  ✓ vde_student.pub"
    else
        echo "  (none - run 'vde ssh-sync' to sync)"
    fi

    echo ""
    exit ${VDE_SUCCESS}
fi

# ==============================================================================
# Initialize Mode -- Full SSH setup
# ==============================================================================
if [[ "${ACTION}" == "init" ]] ; then
    local force_flag=""
    # Check all remaining arguments for force flag
    for arg in "$@"; do
        if [[ "${arg}" == "--force" ]] || [[ "${arg}" == "-f" ]]; then
            force_flag="--force"
            break
        fi
    done

    echo ""
    echo "╔════════════════════════════════════════════════════════════╗"
    echo "║          VDE SSH Environment Initialization                ║"
    echo "╚════════════════════════════════════════════════════════════╝"
    echo ""

    # Step 1: Ensure VDE SSH environment
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "Step 1: Setting up VDE SSH environment"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""

    if [[ "${force_flag}" == "--force" ]]; then
        if vde_ssh_regenerate_keys; then
            log_success "✓ VDE SSH keys regenerated"
        else
            log_error "✗ Failed to regenerate VDE SSH keys"
            exit ${VDE_ERR_GENERAL}
        fi
    else
        if ensure_vde_ssh_environment; then
            log_success "✓ VDE SSH directory: ${VDE_SSH_DIR}"
            log_success "✓ VDE SSH key: ${VDE_SSH_IDENTITY}"
        else
            log_error "✗ Failed to set up VDE SSH environment"
            exit ${VDE_ERR_GENERAL}
        fi
    fi

    echo ""

    # Step 2: Start SSH agent
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "Step 2: Starting SSH agent"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""

    if ensure_ssh_agent; then
        log_success "✓ SSH environment ready (Agent PID: ${SSH_AGENT_PID})"
    else
        log_error "✗ Failed to set up SSH agent"
        exit ${VDE_ERR_GENERAL}
    fi

    echo ""

    # Step 3 is now covered by ensure_ssh_agent
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "Step 3: Keys loaded"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    ssh-add -l 2>/dev/null || echo "  (no keys loaded)"

    echo ""

    # Step 4: Sync VDE public key to build context
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "Step 4: Syncing VDE public key to build context"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""

    if sync_ssh_keys_to_vde; then
        log_success "✓ VDE public key synced to public-ssh-keys/"
    else
        log_error "✗ Failed to sync key"
        exit ${VDE_ERR_GENERAL}
    fi

    echo ""

    # Step 5: Generate SSH config
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "Step 5: Generating VDE SSH config"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""

    if generate_vm_ssh_config; then
        log_success "✓ VDE SSH config updated"
    else
        log_warning "⚠ VDE SSH config generation had issues"
    fi

    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "Setup Complete!"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    echo "VDE SSH is now isolated at: ~/.ssh/vde/"
    echo ""
    echo "Next steps:"
    echo "  • Create a VM: vde create <vm>"
    echo "  • Start a VM:  vde start <vm>"
    echo "  • Connect:     ssh -F ~/.ssh/vde/config <vm>"
    echo ""

    exit ${VDE_SUCCESS}
fi

# ==============================================================================
# Start Mode -- Just start agent and load VDE key
# ==============================================================================
if [[ "${ACTION}" == "start" ]] ; then
    # Use centralized agent management
    if ensure_ssh_agent; then
        echo "export SSH_AUTH_SOCK='${SSH_AUTH_SOCK}'"
        echo "export SSH_AGENT_PID='${SSH_AGENT_PID}'"
        echo "✓ SSH environment ready"
    else
        log_error "Failed to start/find SSH agent"
        exit ${VDE_ERR_GENERAL}
    fi
    exit ${VDE_SUCCESS}
fi

# ==============================================================================
# Stop Mode -- Stop the VDE-specific SSH agent
# ==============================================================================
if [[ "${ACTION}" == "stop" ]] ; then
    if stop_ssh_agent; then
        log_success "VDE SSH agent stopped"
    else
        log_error "Failed to stop VDE SSH agent"
        exit ${VDE_ERR_GENERAL}
    fi
    exit ${VDE_SUCCESS}
fi

# ==============================================================================
# Generate Mode -- Regenerate SSH config only
# ==============================================================================
if [[ "${ACTION}" == "generate" ]] ; then
    echo ""
    echo "Regenerating VDE SSH config..."
    echo ""

    if generate_vm_ssh_config; then
        log_success "✓ VDE SSH config updated"
        echo ""
        echo "Config location: ${VDE_SSH_CONFIG}"
        exit ${VDE_SUCCESS}
    else
        log_error "✗ Failed to generate SSH config"
        exit ${VDE_ERR_GENERAL}
    fi
fi

# ==============================================================================
# Cleanup Mode -- Kill stray VDE ssh-agents (never anyone else's)
# ==============================================================================
if [[ "${ACTION}" == "cleanup" ]] ; then
    echo ""
    echo "Cleaning up stray VDE ssh-agent processes..."
    echo ""

    local vde_agent_env="${VDE_SSH_DIR}/agent_env"
    local vde_sock="${VDE_SSH_AGENT_SOCK:-${VDE_SSH_DIR}/agent.sock}"
    local killed=0
    local preserved=0
    local ignored=0
    local pid env_pid env_sock agent_sock

    # Socket path an agent was started with ("ssh-agent -a <path>"), if any.
    _cleanup_agent_socket_arg() {
        local -a args
        local i
        args=("${(@f)$(tr '\0' '\n' < "/proc/${1}/cmdline" 2>/dev/null)}") || return 0
        for (( i = 2; i < ${#args}; i++ )); do
            if [[ "${args[i]}" == "-a" ]]; then
                print -r -- "${args[i+1]}"
                return 0
            fi
        done
        return 0
    }

    # The VDE agent(s) to keep: the one on the dedicated socket and the one
    # agent_env records
    if [[ -f "${vde_agent_env}" ]]; then
        env_pid=$(grep "^SSH_AGENT_PID=" "${vde_agent_env}" 2>/dev/null | sed 's/SSH_AGENT_PID=\([0-9]*\).*/\1/')
        env_sock=$(grep -o "SSH_AUTH_SOCK=[^;]*" "${vde_agent_env}" 2>/dev/null | head -1 | cut -d= -f2)
    fi

    # Only this user's agents are looked at, and only an agent started on a socket
    # INSIDE the VDE directory is provably VDE's. Everything else (the user's
    # personal agent, the desktop session agent, service agents, a legacy VDE agent
    # on a random /tmp socket) is not VDE's to kill, so it is left alone.
    #
    # Paths are compared in resolved absolute form (symlinks and ".." removed). A
    # relative path cannot be resolved from here, so it is never provably VDE's.
    local vde_dir_abs="${VDE_SSH_DIR:A}"
    local vde_sock_abs="${vde_sock:A}"
    local env_sock_abs=""
    [[ "${env_sock:-}" == /* ]] && env_sock_abs="${env_sock:A}"
    local cur_sock_abs=""
    [[ "${SSH_AUTH_SOCK:-}" == /* ]] && cur_sock_abs="${SSH_AUTH_SOCK:A}"
    for pid in $(pgrep -u "${UID}" -x ssh-agent 2>/dev/null); do
        # Defunct (zombie) entries are already dead; there is nothing to kill
        [[ "$(ps -o stat= -p "${pid}" 2>/dev/null)" == Z* ]] && continue
        agent_sock=$(_cleanup_agent_socket_arg "${pid}")
        if [[ "${agent_sock}" != /* ]]; then
            ignored=$((ignored + 1))
            continue
        fi
        agent_sock="${agent_sock:A}"
        if [[ "${agent_sock}" != "${vde_dir_abs}/"* ]]; then
            ignored=$((ignored + 1))
            continue
        fi
        # Keep the dedicated agent, the one agent_env records, and the one this
        # shell has exported (for example from an older autostart block)
        if [[ "${agent_sock}" == "${vde_sock_abs}" || "${agent_sock}" == "${env_sock_abs}" || "${agent_sock}" == "${cur_sock_abs}" \
              || "${pid}" == "${env_pid:-}" || "${pid}" == "${SSH_AGENT_PID:-}" ]]; then
            log_info "Preserving the VDE agent: ${pid}"
            preserved=$((preserved + 1))
            continue
        fi
        echo "  Killing stray VDE ssh-agent PID ${pid} (${agent_sock})"
        if kill "${pid}" 2>/dev/null; then
            killed=$((killed + 1))
        fi
    done

    echo ""
    if [[ ${killed} -gt 0 ]] ; then
        log_success "Killed ${killed} stray VDE ssh-agent(s)"
    else
        log_info "No stray VDE ssh-agents found"
    fi
    [[ ${preserved} -gt 0 ]] && log_info "Preserved ${preserved} VDE agent(s)"
    [[ ${ignored} -gt 0 ]] && log_info "Left ${ignored} other ssh-agent(s) alone (not started on a VDE socket)"

    exit ${VDE_SUCCESS}
fi

# ==============================================================================
# Autostart Mode -- Configure shell to start VDE's own SSH agent (never exported)
# ==============================================================================
if [[ "${ACTION}" == "autostart" ]] ; then
    echo ""
    echo "Configuring shell to auto-start VDE's own SSH agent..."
    echo ""

    # Detect shell config file (ZSH ONLY - UAP Mandate 1)
    local shell_config="${HOME}/.zshrc"

    # Marker for our addition
    local marker="# VDE SSH Agent Auto-Start"

    # VDE has its OWN agent, separate from the user's. The snippet starts it in a
    # subprocess (vde ssh-setup start) when the agent on its dedicated socket does
    # not answer or holds no key, and deliberately does NOT source agent_env into
    # the shell: that would make VDE's agent the user's agent. The check asks the
    # agent itself (a leftover socket file proves nothing) and is bounded by
    # timeout where it exists, so a stuck agent cannot hang a new shell.
    local entry
    entry=$(cat <<ENTRY
${marker}
# VDE's own SSH agent: started here, never exported into this shell.
if command -v vde >/dev/null 2>&1; then
    if (( \$+commands[timeout] )); then
        SSH_AUTH_SOCK="${VDE_SSH_AGENT_SOCK:-${VDE_SSH_DIR}/agent.sock}" timeout 2 ssh-add -l >/dev/null 2>&1
    else
        SSH_AUTH_SOCK="${VDE_SSH_AGENT_SOCK:-${VDE_SSH_DIR}/agent.sock}" ssh-add -l >/dev/null 2>&1
    fi
    if [[ \$? -ne 0 ]]; then
        # Bounded and without stdin, so a key that wants a passphrase cannot stall a new shell
        if (( \$+commands[timeout] )); then
            timeout 10 vde ssh-setup start </dev/null >/dev/null 2>&1
        else
            vde ssh-setup start </dev/null >/dev/null 2>&1
        fi
    fi
fi
ENTRY
)

    # The snippet calls vde, so tell the user now if it cannot be found
    if ! command -v vde >/dev/null 2>&1; then
        log_warning "'vde' is not on your PATH, so the autostart snippet will do nothing until it is."
    fi

    # Check if already configured
    if grep -q "${marker}" "${shell_config}" 2>/dev/null; then
        # The current snippet is recognised by its own unique comment line, not by text
        # that any unrelated (or commented-out) line could also contain
        if grep -qF "# VDE's own SSH agent: started here, never exported into this shell." "${shell_config}" 2>/dev/null; then
            log_info "Shell autostart already configured in ${shell_config}"
        else
            # An older version of this snippet sourced agent_env into the shell, which
            # made VDE's agent the user's agent. It is not edited automatically.
            log_warning "${shell_config} has an older VDE autostart block that exports VDE's agent into your shell."
            echo "  Remove the block that starts with '${marker}', then run this again."
        fi
    else
        # Add to shell config
        echo "" >> "${shell_config}"
        echo "${entry}" >> "${shell_config}"
        log_success "✓ Added autostart to ${shell_config}"
    fi

    echo ""
    echo "VDE's own SSH agent will now be started on new shell sessions."
    echo "It is not exported into your shell: your own SSH agent is left alone."
    echo "To apply to current shell, run:"
    echo "  source ${shell_config}"
    exit ${VDE_SUCCESS}
fi

# ==============================================================================
# Unknown Action
# ==============================================================================
echo "Unknown action: ${ACTION}"
echo ""
echo "Valid actions: status, init, start, stop, cleanup, autostart, generate"
echo "Run 'vde ssh-setup --help' for usage information"
exit ${VDE_ERR_GENERAL}
