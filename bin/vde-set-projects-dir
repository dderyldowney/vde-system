#!/usr/bin/env zsh
# @armor (Engine Core)
#===============================================================================
# vde-set-projects-dir - Re-point the Projects base for an existing Forge
set -e
# Usage: vde set-projects-dir [<new-path>]
#
# Arguments:
#   <new-path>    Absolute or ~/env-expanded path to the new Projects base.
#                 If omitted, you are prompted for it.
#
# The Projects base is the directory under which every Spoke alias gets its own
# subfolder (<base>/<alias>). It defaults to ${VDE_ROOT_DIR}/projects but may
# live ANYWHERE you control (e.g. ~/Projects), even outside the Forge.
#
# This ritual:
#   - Resolves the target to an absolute, writable directory (creating it).
#   - Moves each existing per-alias project subfolder from the old base to the
#     new base (never overwriting; name collisions are warned and skipped).
#   - Updates the VDE_PROJECTS_DIR key in the repo-root .env.
#
# Your Spokes pick up the new location on their next start. No rebuild is
# needed: the Compose mount interpolates .env at `up`.
#===============================================================================

# Determine VDE root directory
VDE_ROOT_DIR="${0:h:h}"
export VDE_ROOT_DIR

# Source core libraries
[[ -f "${VDE_ROOT_DIR}/lib/vde-shell-compat" ]] && source "${VDE_ROOT_DIR}/lib/vde-shell-compat" &>/dev/null
[[ -f "${VDE_ROOT_DIR}/lib/vde-constants" ]] && source "${VDE_ROOT_DIR}/lib/vde-constants" &>/dev/null
[[ -f "${VDE_ROOT_DIR}/lib/vde-errors" ]] && source "${VDE_ROOT_DIR}/lib/vde-errors" &>/dev/null
[[ -f "${VDE_ROOT_DIR}/lib/vde-log" ]] && source "${VDE_ROOT_DIR}/lib/vde-log" &>/dev/null
[[ -f "${VDE_ROOT_DIR}/lib/vde-core" ]] && source "${VDE_ROOT_DIR}/lib/vde-core" &>/dev/null
[[ -f "${VDE_ROOT_DIR}/lib/vde-path-utils" ]] && source "${VDE_ROOT_DIR}/lib/vde-path-utils" &>/dev/null
# vm-common provides is_known_vm (prefixed/unprefixed aware), used to move only
# folders VDE actually owns when re-pointing a shared Projects base.
[[ -f "${VDE_ROOT_DIR}/lib/vm-common" ]] && source "${VDE_ROOT_DIR}/lib/vm-common" &>/dev/null

#===============================================================================
# Functions
#===============================================================================

# vde_set_projects_dir_usage - Display usage information
vde_set_projects_dir_usage() {
    cat <<EOF
Usage: vde set-projects-dir [<new-path>]

Re-point the Projects base for an existing Forge.

Arguments:
  <new-path>    New Projects base. Absolute, ~/-relative, or env-expanded.
                If omitted, you will be prompted.

The Projects base is where every Spoke alias gets its own subfolder
(<base>/<alias>). It can live anywhere you control, e.g. ~/Projects.
Existing per-alias project folders are moved to the new base, the
VDE_PROJECTS_DIR key in .env is updated, and your Spokes use the new
location on next start (no rebuild needed).

Safeguards: it refuses (moving nothing) while a Spoke of a folder it would
move is running (vde stop <name>, then re-run). A move across filesystems is
copied to <alias>.vde-moving and renamed only when complete. If interrupted,
re-run the same command to finish, and do not start Spokes until then. An
exported VDE_PROJECTS_DIR outranks .env; a differing value triggers a warning.

Examples:
  vde set-projects-dir ~/Projects
  vde set-projects-dir /mnt/data/vde-projects
  vde set-projects-dir                      # prompt for the path

EOF
}

# vde_spd_running_spokes - Print the running container names, one per line.
# Returns non-zero when the running Spokes cannot be determined: Docker missing,
# not running, not permitted, or not answering within VDE_SPD_DOCKER_TIMEOUT
# seconds (default 20). Callers refuse instead of reading a failed query as
# "nothing is running" (Signet #669).
vde_spd_running_spokes() {
    command -v docker >/dev/null 2>&1 || return 1
    if command -v timeout >/dev/null 2>&1; then
        timeout -k 5 "${VDE_SPD_DOCKER_TIMEOUT:-20}" docker ps --format '{{.Names}}' 2>/dev/null
    else
        docker ps --format '{{.Names}}' 2>/dev/null
    fi
}

# vde_spd_workspace_owners <alias> - Print the container name of every Spoke whose
# workspace lives under <base>/<alias>: the Spoke itself plus any whose workspace is
# nested in it (JupyterLab keeps its notebooks in python/jupyterlabs; see
# vde_workspace_subpath in lib/vm-common).
vde_spd_workspace_owners() {
    emulate -L zsh
    local alias_name="${1}" key raw sub
    print -r -- "vde-${alias_name}"
    for key in ${(k)VM_TYPE}; do
        raw="${key#vde-}"
        sub="$(vde_workspace_subpath "${raw}")"
        [[ "${sub}" == "${alias_name}/"* ]] && print -r -- "vde-${raw}"
    done
}

# vde_spd_blockers <alias> <running-names> - Print each running Spoke (one per line)
# that mounts <alias>'s folder. The ONE place that decides "is something using this
# folder", shared by the pre-move guard and the post-copy re-check.
vde_spd_blockers() {
    emulate -L zsh
    local owner
    for owner in ${(u)${(f)"$(vde_spd_workspace_owners "${1}")"}}; do
        [[ $'\n'"${2}"$'\n' == *$'\n'"${owner}"$'\n'* ]] && print -r -- "${owner}"
    done
    return 0
}

# vde_spd_is_running <alias> - True when any Spoke that mounts <alias>'s folder runs,
# OR when Docker cannot be queried.
vde_spd_is_running() {
    emulate -L zsh
    local names
    names="$(vde_spd_running_spokes)" || return 0
    [[ -n "$(vde_spd_blockers "${1}" "${names}")" ]]
}

# Set from just before a cross-filesystem copy is published until its old source is
# gone, so an interrupt in that window can name the folder to delete.
typeset VDE_SPD_PUBLISH_SRC="" VDE_SPD_PUBLISH_DEST=""

# vde_spd_move_alias <src> <dest> - Move one alias folder. Returns 0 on success.
# Same device: a plain rename. Different device: `mv` would be copy-then-delete,
# and a failure midway leaves a partial copy at <dest> that later runs mistake
# for a finished move. Instead copy to <dest>.vde-moving, rename to <dest> only
# after the copy fully succeeded, and only then delete the source. The source
# stays authoritative until the rename (Signet #669, #545 item 6).
vde_spd_move_alias() {
    emulate -L zsh
    zmodload zsh/stat 2>/dev/null
    local src="${1}" dest="${2}" tmp="${2}.vde-moving"
    local -a sdev ddev
    zstat -A sdev +device -- "${src}" 2>/dev/null || return 1
    zstat -A ddev +device -- "${dest:h}" 2>/dev/null || return 1
    if [[ "${sdev[1]}" == "${ddev[1]}" ]]; then
        mv "${src}" "${dest}" 2>/dev/null
        return
    fi
    # The only path this function ever deletes is <dest>.vde-moving.
    [[ "${tmp:t}" == ?*.vde-moving ]] || return 1
    if [[ -L "${tmp}" ]]; then
        print -u2 -r -- "  ! '${tmp}' is a symbolic link; refusing to use or remove it. Move '${src:t}' by hand."
        return 1
    fi
    # A leftover temp comes from an earlier interrupted run. The source was still
    # whole then (it is deleted only after the rename), so discarding it is safe.
    if [[ -e "${tmp}" ]]; then
        rm -rf -- "${tmp}" 2>/dev/null
        # If it could not be removed (for example it belongs to another user), copying
        # now would nest the copy INSIDE it. Refuse instead.
        if [[ -e "${tmp}" ]]; then
            print -u2 -r -- "  ! Could not remove the leftover '${tmp}' from an earlier run; remove it by hand and run this command again."
            return 1
        fi
    fi
    if cp -a "${src}" "${tmp}" 2>/dev/null; then
        # A Spoke may have started while the copy ran: it mounts the OLD base until
        # .env changes, so any write it makes would be lost with the source. Keep the
        # source authoritative and discard the copy (an unreadable Docker counts as running).
        if vde_spd_is_running "${src:t}"; then
            rm -rf -- "${tmp}"
            print -u2 -r -- "  ! '${src:t}' is running, or Docker cannot be queried, after the copy; the copy was discarded and the folder left in place. Stop the Spoke and run this command again."
            return 1
        fi
        VDE_SPD_PUBLISH_SRC="${src}"; VDE_SPD_PUBLISH_DEST="${dest}"
        if mv "${tmp}" "${dest}" 2>/dev/null; then
            rm -rf -- "${src}" \
                || print -u2 -r -- "  ! Moved '${src:t}', but could not fully remove the old copy at ${src}; remove it by hand."
            VDE_SPD_PUBLISH_SRC=""; VDE_SPD_PUBLISH_DEST=""
            return 0
        fi
        VDE_SPD_PUBLISH_SRC=""; VDE_SPD_PUBLISH_DEST=""
    fi
    rm -rf -- "${tmp}"
    return 1
}

# VDE_SPD_PHASE tells the interrupt handler how far the re-point got:
# "move" (moving folders / writing .env) or "regen" (.env already updated).
typeset VDE_SPD_PHASE=""

# _vde_spd_interrupted <signal-number> - INT/TERM/HUP handler: say how to finish, then exit.
_vde_spd_interrupted() {
    local sig="${1}"
    echo "" >&2
    if [[ -n "${VDE_SPD_PUBLISH_SRC}" && -e "${VDE_SPD_PUBLISH_DEST}" && -e "${VDE_SPD_PUBLISH_SRC}" ]]; then
        echo "Interrupted while removing the old copy: your folder was already moved to its new place, but ${VDE_SPD_PUBLISH_SRC} was not fully removed. Check the new copy, delete ${VDE_SPD_PUBLISH_SRC} by hand, then re-run the same command to finish; do not start Spokes until then." >&2
    elif [[ "${VDE_SPD_PHASE}" == "regen" || "$(vde_projects_dir_from_env_file)" == "${NEW_BASE}" ]]; then
        echo "Interrupted after the base was updated: Spoke configurations were not regenerated; recreate affected Spokes (vde remove <name> && vde create <name>) so they mount the new location." >&2
    else
        echo "Interrupted while moving: re-run the same command to finish (vde set-projects-dir ${NEW_BASE}); do not start Spokes until then, they would mount the old base." >&2
    fi
    exit $(( 128 + sig ))
}

# vde_set_projects_dir_update_env - Set the VDE_PROJECTS_DIR key in .env
# Args: ${1} = new absolute base
vde_set_projects_dir_update_env() {
    local new_base="${1}"
    local env_file="${VDE_ROOT_DIR}/.env"
    [[ -L "${env_file}" ]] && env_file="${env_file:A}"   # rewrite the file the link points at

    if [[ ! -f "${env_file}" ]]; then
        : > "${env_file}"
        chmod 600 "${env_file}" 2>/dev/null || true
    fi

    # zsh-native rewrite: a path may contain &, |, \, which break sed. Read the
    # file into lines, replace the last VDE_PROJECTS_DIR= assignment (or append),
    # and write it back verbatim.
    local -a lines
    lines=("${(@f)$(<"${env_file}")}")
    local -i i found=0
    for (( i = ${#lines}; i >= 1; i-- )); do
        if [[ "${lines[$i]}" == VDE_PROJECTS_DIR=* ]]; then
            lines[$i]="VDE_PROJECTS_DIR=${new_base}"
            found=1
            break
        fi
    done
    (( found )) || lines+=("VDE_PROJECTS_DIR=${new_base}")
    # Temp + rename in the same directory: a failed or interrupted write can never
    # truncate .env (which would lose every other setting in it).
    local tmp
    tmp="$(mktemp "${env_file}.vde-tmp.XXXXXX")" || return 1   # O_EXCL: never follows a planted link
    if ! { print -rl -- "${lines[@]}" > "${tmp}" && chmod 600 "${tmp}"; }; then
        rm -f -- "${tmp}"
        return 1
    fi
    mv -f -- "${tmp}" "${env_file}" || { rm -f -- "${tmp}"; return 1; }
}

#===============================================================================
# Main
#===============================================================================

# Help flag
if [[ "${1}" == "-h" || "${1}" == "--help" ]]; then
    vde_set_projects_dir_usage
    exit ${VDE_SUCCESS}
fi

# Resolve the CURRENT base before anything changes
OLD_BASE="$(vde_projects_dir)"
OLD_BASE="${OLD_BASE:A}"

# Acquire the target path (argument or prompt)
TARGET_RAW="${1}"
if [[ -z "${TARGET_RAW}" ]]; then
    echo ""
    echo "Your Projects base is where each Spoke alias gets its own subfolder."
    echo "It can live anywhere you control, e.g. ~/Projects."
    echo "Current base: ${OLD_BASE}"
    echo ""
    printf "New Projects base: "
    read -r TARGET_RAW
fi

if [[ -z "${TARGET_RAW}" ]]; then
    vde_error_simple "No path provided. Nothing to do."
    exit ${VDE_ERR_INVALID_INPUT}
fi

# Validate and absolutize via the shared resolver (lib/vde-path-utils): expands
# ~ and $NAME only (no command substitution can run), refuses empty values and
# ':'. Relative paths hang off the current directory.
if ! vde_resolve_projects_base "${TARGET_RAW}"; then
    vde_error_simple "${VDE_PB_ERROR}"
    exit ${VDE_ERR_INVALID_INPUT}
fi
NEW_BASE="${VDE_PB_RESULT}"

# No-op when the base is unchanged
if [[ "${NEW_BASE}" == "${OLD_BASE}" ]]; then
    echo "Projects base is already '${NEW_BASE}'. Nothing to move."
    # The exported value may be what made them equal while .env says otherwise.
    vde_warn_stale_projects_env
    exit ${VDE_SUCCESS}
fi

# Refuse moving the base INTO its own subdirectory. The move loop globs the old
# base's children, which would then include the new base itself -- it would try
# to move the new base into itself and tangle the tree. Choosing a location
# outside the current base keeps the move well-defined.
if [[ "${NEW_BASE}" == "${OLD_BASE}"/* ]]; then
    vde_error_simple "New base '${NEW_BASE}' is inside the current base '${OLD_BASE}'. Choose a location outside it."
    exit ${VDE_ERR_INVALID_INPUT}
fi

# The registry must be loaded before anything is created or moved, so a failure
# never strands project files at the old base.
if ! typeset -f is_known_vm >/dev/null 2>&1; then
    vde_error_simple "VM registry unavailable (vm-common failed to load); refusing to re-point so your project files are never stranded at the old base."
    exit ${VDE_ERR_GENERAL}
fi

# .env is rewritten only AFTER the folders move. If it cannot be written, the move
# would strand your projects at a base that .env does not name, so verify it first.
typeset _spd_envf="${VDE_ROOT_DIR}/.env"
[[ -L "${_spd_envf}" ]] && _spd_envf="${_spd_envf:A}"
typeset _spd_envbad=""
if [[ -e "${_spd_envf}" && ! -w "${_spd_envf}" ]]; then
    _spd_envbad="${_spd_envf}"
elif [[ ! -w "${_spd_envf:h}" ]]; then
    _spd_envbad="${_spd_envf:h} (the rewrite creates a temporary file beside .env)"
fi
if [[ -n "${_spd_envbad}" ]]; then
    vde_error_simple "Cannot write ${_spd_envbad}; refusing to move anything, so your projects are never stranded at a base that .env does not name."
    exit ${VDE_ERR_PERMISSION}
fi

# Quiesce (Signet #669, #545 item 7): never move a workspace a running Spoke has
# bind-mounted. A cross-filesystem copy-then-delete loses every write made after
# the copy. Only aliases that WOULD move are checked: a collision is skipped and
# an unregistered name is never touched.
typeset -a move_candidates=() running_blocking=()
if [[ -d "${OLD_BASE}" ]]; then
    for alias_dir in "${OLD_BASE}"/*(N/); do
        alias_name="${alias_dir:t}"
        is_known_vm "${alias_name}" 2>/dev/null || continue
        [[ -e "${NEW_BASE}/${alias_name}" || -L "${NEW_BASE}/${alias_name}" ]] && continue
        move_candidates+=("${alias_name}")
    done
fi
# One Docker snapshot, and only when something would move. A query that fails,
# times out, or has no docker to ask is NOT "nothing is running": refuse, because
# the guard must fail closed.
if (( ${#move_candidates} > 0 )); then
    typeset running_names
    if ! running_names="$(vde_spd_running_spokes)"; then
        vde_error_simple "Cannot tell which Spokes are running (Docker is missing, not running, not permitted, or did not answer in time). Refusing to move workspaces a running Spoke may have mounted. Nothing was moved."
        exit ${VDE_ERR_GENERAL}
    fi
    for alias_name in "${move_candidates[@]}"; do
        running_blocking+=( ${(f)"$(vde_spd_blockers "${alias_name}" "${running_names}")"} )
    done
fi
if (( ${#running_blocking} > 0 )); then
    vde_error_simple "Refusing to re-point: these Spokes are running with their workspace mounted from ${OLD_BASE}: ${(j:, :)${(u)running_blocking}}. Nothing was moved."
    echo "  Stop them first (for example: vde stop ${running_blocking[1]#vde-}), then run this command again." >&2
    exit ${VDE_ERR_GENERAL}
fi

echo ""
echo "Re-pointing Projects base:"
echo "  From: ${OLD_BASE}"
echo "  To:   ${NEW_BASE}"
echo ""

# Create the new base if it does not exist
if [[ ! -d "${NEW_BASE}" ]]; then
    if ! mkdir -p "${NEW_BASE}" 2>/dev/null; then
        vde_error_simple "Cannot create new Projects base: ${NEW_BASE}"
        exit ${VDE_ERR_PERMISSION}
    fi
fi

# Verify the new base is a directory the student controls (writable)
if [[ ! -d "${NEW_BASE}" || ! -w "${NEW_BASE}" ]]; then
    vde_error_simple "New Projects base is not a writable directory: ${NEW_BASE}"
    exit ${VDE_ERR_PERMISSION}
fi

# Move each existing per-alias subfolder from the old base to the new base.
# CRITICAL: a student may point VDE at a directory that already holds their own
# unrelated work (e.g. ~/GitHub, which may contain other repos). We move ONLY
# the folders VDE owns -- those whose name is a registered VM -- and never touch
# the student's other directories. Nesting inside each alias folder (e.g.
# python/jupyterlabs) is preserved by moving the whole directory. Student data
# is never deleted or overwritten.
typeset -i moved=0 skipped=0 failed=0
VDE_SPD_PHASE="move"
trap '_vde_spd_interrupted 1' HUP
trap '_vde_spd_interrupted 2' INT
trap '_vde_spd_interrupted 15' TERM
if [[ -d "${OLD_BASE}" ]]; then
    for alias_dir in "${OLD_BASE}"/*(N/); do
        alias_name="${alias_dir:t}"

        # Leave anything that is not a VDE Spoke alias exactly where it is.
        if ! is_known_vm "${alias_name}" 2>/dev/null; then
            continue
        fi

        dest="${NEW_BASE}/${alias_name}"

        # -L catches a dangling symlink that -e reports as absent.
        if [[ -e "${dest}" || -L "${dest}" ]]; then
            vde_log_warn "Skipping '${alias_name}': already exists at destination (left in place for you)." 2>/dev/null \
                || echo "  ! Skipping '${alias_name}': already exists at destination (left in place for you)."
            (( ++skipped ))
            continue
        fi

        if vde_spd_move_alias "${alias_dir}" "${dest}"; then
            echo "  ✓ Moved '${alias_name}'"
            (( ++moved ))
        else
            # Always shown (stderr), never log-only (Signet #669, #545 item 6).
            echo "  ! Could not move '${alias_name}'; left in place at ${alias_dir}. Fix the cause (free space, permissions) and run this command again." >&2
            (( ++skipped ))
            (( ++failed ))
        fi
    done
fi

# A folder that could not be moved means the move is NOT finished: leave .env on the
# old base so re-running the same command retries it (folders that moved are already
# absent from the old base). Pointing .env at a base that lacks a workspace would also
# turn the re-run into a silent "nothing to move".
if (( failed > 0 )); then
    trap - INT TERM HUP
    VDE_SPD_PHASE=""
    echo "ACTION REQUIRED: ${failed} folder(s) could not be moved (see the messages above). .env was NOT changed and still names ${OLD_BASE}; the folders that did move are already at ${NEW_BASE}. Fix the cause (free space, permissions), then run the same command again to finish, and do not start Spokes until then." >&2
    exit ${VDE_ERR_GENERAL}
fi

# Update the runtime source of truth
if ! vde_set_projects_dir_update_env "${NEW_BASE}"; then
    vde_error_simple "Your folders were moved, but .env could not be updated. Set VDE_PROJECTS_DIR=${NEW_BASE} in ${VDE_ROOT_DIR}/.env by hand before starting any Spoke."
    exit ${VDE_ERR_PERMISSION}
fi
VDE_SPD_PHASE="regen"

# Regenerate Compose configs so EVERY Spoke -- including ones created before this
# feature existed, whose generated compose still holds a literal projects path --
# carries the ${VDE_PROJECTS_DIR:-...} interpolation line and reads the new base
# from .env on next start. This regenerates config only; no image is rebuilt.
typeset configs_regenerated=0
if [[ -x "${VDE_ROOT_DIR}/bin/generate-all-configs" ]]; then
    # --force is REQUIRED: the smelter skips Spokes whose compose/env already
    # exist, so without it a re-point leaves existing Spokes on their old literal
    # mount and they never pick up the new base. Forcing rewrites every Spoke's
    # compose to the ${VDE_PROJECTS_DIR:-...} interpolation that reads .env at up.
    if "${VDE_ROOT_DIR}/bin/generate-all-configs" --force >/dev/null 2>&1; then
        echo "  ✓ Regenerated Spoke configurations"
        configs_regenerated=1
    else
        vde_log_warn "Could not regenerate Spoke configurations; recreate affected Spokes (vde remove <name> && vde create <name>) to pick up the new base." 2>/dev/null \
            || echo "  ! Could not regenerate Spoke configurations; recreate affected Spokes (vde remove <name> && vde create <name>) to pick up the new base."
    fi
fi

trap - INT TERM HUP
VDE_SPD_PHASE=""

# Summary
echo ""
echo "╔════════════════════════════════════════════════════════════╗"
echo "║          Projects Base Re-pointed                        ║"
echo "╚════════════════════════════════════════════════════════════╝"
echo ""
echo "  New base:       ${NEW_BASE}"
echo "  Folders moved:  ${moved}"
if (( skipped > 0 )); then
    echo "  Folders skipped: ${skipped} (name already existed; left for you to merge)"
fi
echo ""
echo "  .env updated:   VDE_PROJECTS_DIR=${NEW_BASE}"
# An exported VDE_PROJECTS_DIR outranks the .env value just written (Signet #669).
vde_warn_stale_projects_env
echo ""
if (( configs_regenerated )); then
    echo "  Your Spokes will use the new location the next time you start them."
    echo "  No rebuild is needed — the mount reads .env on 'vde start'."
else
    echo "  Recreate affected Spokes (vde remove <name> && vde create <name>) so"
    echo "  they mount the new location. Your moved project files are already safe."
fi
echo ""
echo "This is the Way."

exit ${VDE_SUCCESS}
