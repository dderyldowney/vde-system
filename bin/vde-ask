#!/usr/bin/env zsh
#===============================================================================
# vde-ask - Natural language command interface for VDE
# Routes natural language input through vde-parser (generate_plan | execute_plan)
#
# Usage: vde ask <natural language input>
#   e.g. vde ask "list all vms"
#        vde ask "start the python vm"
#        vde ask "create a rust development environment"
#===============================================================================

VDE_ROOT_DIR="${0:a:h:h}"
export VDE_ROOT_DIR

# Source required libraries
[[ -f "${VDE_ROOT_DIR}/lib/vde-shell-compat" ]] && source "${VDE_ROOT_DIR}/lib/vde-shell-compat" &>/dev/null
[[ -f "${VDE_ROOT_DIR}/lib/vde-constants"    ]] && source "${VDE_ROOT_DIR}/lib/vde-constants"    &>/dev/null
[[ -f "${VDE_ROOT_DIR}/lib/vde-errors"       ]] && source "${VDE_ROOT_DIR}/lib/vde-errors"       &>/dev/null
[[ -f "${VDE_ROOT_DIR}/lib/vde-log"          ]] && source "${VDE_ROOT_DIR}/lib/vde-log"          &>/dev/null
[[ -f "${VDE_ROOT_DIR}/lib/vde-naming"       ]] && source "${VDE_ROOT_DIR}/lib/vde-naming"       &>/dev/null
[[ -f "${VDE_ROOT_DIR}/lib/vde-security"     ]] && source "${VDE_ROOT_DIR}/lib/vde-security"     &>/dev/null
[[ -f "${VDE_ROOT_DIR}/lib/vde-core"         ]] && source "${VDE_ROOT_DIR}/lib/vde-core"         &>/dev/null
[[ -f "${VDE_ROOT_DIR}/lib/vm-common"        ]] && source "${VDE_ROOT_DIR}/lib/vm-common"        &>/dev/null
[[ -f "${VDE_ROOT_DIR}/lib/vde-commands"     ]] && source "${VDE_ROOT_DIR}/lib/vde-commands"     &>/dev/null
[[ -f "${VDE_ROOT_DIR}/lib/vde-parser"       ]] && source "${VDE_ROOT_DIR}/lib/vde-parser"       &>/dev/null

if [[ ${#} -eq 0 ]]; then
    echo "Usage: vde ask <natural language input>"
    echo ""
    echo "Examples:"
    echo "  vde ask \"list all vms\""
    echo "  vde ask \"start the python vm\""
    echo "  vde ask \"create a rust environment\""
    exit ${VDE_ERR_INVALID_INPUT}
fi

input="${*}"
DRY_RUN=0

# Check for --dry-run flag
if [[ "${input}" == *"--dry-run"* ]]; then
    DRY_RUN=1
    # Remove --dry-run from input so it doesn't confuse the parser
    input="${input/--dry-run/}"
    input="${input/  / }" # Clean double spaces
    input=$(echo "${input}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
fi

# Verify parser functions are available
if ! type generate_plan &>/dev/null || ! type execute_plan &>/dev/null; then
    _error "vde-parser not available"
    exit ${VDE_ERR_DEPENDENCY}
fi

# Generate plan (redirect all log output to stderr so only the plan line goes to stdout)
plan=$(VDE_LOG_LEVEL=ERROR generate_plan "${input}" 2>/dev/null | grep -E '^[A-Z]+:|^---')

if [[ -z "${plan}" ]]; then
    _error "Could not understand: ${input}"
    _info "Try 'vde help' for available commands."
    exit ${VDE_ERR_INVALID_INPUT}
fi

# Execute or display the plan
if [[ ${DRY_RUN} -eq 1 ]]; then
    echo "${plan}"
else
    echo "${plan}" | execute_plan
fi
exit ${?}
