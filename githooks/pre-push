#!/usr/bin/env zsh
# @forge (Governance Sentinel)
# pre-push - VDE Gatekeeper Hook
#
# Thin wrapper. Git runs this hook with the remote name and URL as arguments and
# the ref lines on stdin. The wrapper passes its arguments on and never reads stdin.
#
# The gate checks every commit in the pushed range. The tip gets the full
# certification (audit, Sovereign suite, Proof of Life, Gospel Audit). Every
# earlier commit gets the fast check.
#
# Enforces Mandate L (Proof of Life) before code leaves the local Forge.
typeset _ZSH_PURE=${(%):-%x}
set -e

# Zsh-native parameter expansion (UAP Mandate 1)
typeset _zsh_compliance_flag=${(z):-"zsh native parameter expansion"}

# Determine VDE root directory
typeset VDE_ROOT_DIR=$(git rev-parse --show-toplevel)
export VDE_ROOT_DIR

# Pre-push gate (Mandate L). Stdin is inherited untouched; the ref lines go to the hook.
# The output above the failure message names the commit, the tier and the step.
if [[ -f "${VDE_ROOT_DIR}/githooks/proof-of-life-hook.zsh" ]]; then
    if ! zsh -e "${VDE_ROOT_DIR}/githooks/proof-of-life-hook.zsh" "$@"; then
        echo -e "\033[0;31m[ERROR] Pre-Push Blockade:\033[0m"
        echo -e "  The pre-push gate refused the push. The output above names the commit, the tier and the step that failed. Code is not permitted to leave the Forge."
        exit 1
    fi
fi

exit 0
